// Author: Karac V. Thweatt
//
// fcodegen.fx - Flux code generator (bootstrap, port of fcodegen.py)
//
// Emits textual LLVM IR through f_llvmir.fx. Built in stages and checked by
// diffing against the .ll the Python compiler writes.
//
// Stage A (this file so far):
//     TypeSpec to LLVM type lowering          (TypeSystem.get_llvm_type)
//     struct, union, enum, object, alias types (visit_StructDef, visit_UnionDef,
//                                               visit_EnumDef, visit_ObjectDef,
//                                               visit_TypeDeclaration)
//     function and method declarations         (visit_FunctionDef signature,
//                                               visit_ExternBlock)
//
#ifndef FLUX_STANDARD
#import <standard.fx>;
#endif;

#ifndef FLUX_AST
#import "fast.fx";
#endif;

#ifndef FLUX_TYPES
#import "ftypesys.fx";
#endif;

#ifndef FLUX_LLVMIR
#import "f_llvmir.fx";
#endif;

#ifndef FLUX_TYPER
#import "ftyper.fx";
#endif;

#ifndef FLUX_CODEGEN
#def FLUX_CODEGEN 1;
#def VF_UNION_STRUCT 16;
#def VF_STRING_VALUE 32;

using flux::ast;
using flux::preprocessor;
using flux::types;
using flux::ir;
using flux::check;
using flux::typer;

namespace flux
{
    namespace codegen
    {
        // MD5 round constants and shifts (RFC 1321), used for the .str.gsi.<hash> global names
        i64[64] MD5K = [3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426, 2821735955, 4249261313, 1770035416, 2336552879, 4294925233, 2304563134, 1804603682, 4254626195, 2792965006, 1236535329, 4129170786, 3225465664, 643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448, 568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512, 1735328473, 2368359562, 4294588738, 2272392833, 1839030562, 4259657740, 2763975236, 1272893353, 4139469664, 3200236656, 681279174, 3936430074, 3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645, 4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690, 4293915773, 2240044497, 1873313359, 4264355552, 2734768916, 1309151649, 4149444226, 3174756917, 718787259, 3951481745];
        i64[64] MD5S = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21];

        // First eight hex digits of the MD5 digest of data[0..len); out receives nine bytes
        md5_hex8(byte* src, int len, byte* res) -> void
        {
            i64 m32 = (i64)65535 * (i64)65537;
            i64[4] st;
            i64[16] w;
            i64 a, b, c, d, f, t;
            int total = ((len + 8) / 64 + 1) * 64;
            byte* buf = (byte*)fmalloc((u64)total);
            int i, blk, g, j;
            i64 bits = (i64)len * (i64)8;
            while (i < total)
            {
                buf[i] = (byte)0;
                i++;
            };
            i = 0;
            while (i < len)
            {
                buf[i] = src[i];
                i++;
            };
            buf[len] = (byte)128;
            i = 0;
            while (i < 8)
            {
                buf[total - 8 + i] = (byte)((bits >> (i * 8)) `& (i64)255);
                i++;
            };
            st[0] = (i64)1732584193;
            st[1] = (((i64)61389 << 16) `| (i64)43913);
            st[2] = (((i64)39098 << 16) `| (i64)56574);
            st[3] = (i64)271733878;
            blk = 0;
            while (blk < total / 64)
            {
                i = 0;
                while (i < 16)
                {
                    j = blk * 64 + i * 4;
                    w[i] = ((i64)buf[j] `& (i64)255) `| (((i64)buf[j + 1] `& (i64)255) << 8) `| (((i64)buf[j + 2] `& (i64)255) << 16) `| (((i64)buf[j + 3] `& (i64)255) << 24);
                    i++;
                };
                a = st[0];
                b = st[1];
                c = st[2];
                d = st[3];
                i = 0;
                while (i < 64)
                {
                    if (i < 16)
                    {
                        f = (b `& c) `| ((`!b) `& d);
                        g = i;
                    };
                    if (i >= 16 & i < 32)
                    {
                        f = (d `& b) `| ((`!d) `& c);
                        g = (5 * i + 1) % 16;
                    };
                    if (i >= 32 & i < 48)
                    {
                        f = b `^| c `^| d;
                        g = (3 * i + 5) % 16;
                    };
                    if (i >= 48)
                    {
                        f = c `^| (b `| (`!d));
                        g = (7 * i) % 16;
                    };
                    f = (f + a + MD5K[i] + w[g]) `& m32;
                    a = d;
                    d = c;
                    c = b;
                    t = MD5S[i];
                    b = (b + (((f << t) `| (f >> ((i64)32 - t))) `& m32)) `& m32;
                    i++;
                };
                st[0] = (st[0] + a) `& m32;
                st[1] = (st[1] + b) `& m32;
                st[2] = (st[2] + c) `& m32;
                st[3] = (st[3] + d) `& m32;
                blk++;
            };
            ffree((void*)buf);
            i = 0;
            while (i < 4)
            {
                j = (int)((st[0] >> (i * 8)) `& (i64)255);
                g = j / 16;
                switch (g < 10) { case (true) { res[i * 2] = (byte)(48 + g); } default { res[i * 2] = (byte)(87 + g); }; };
                g = j % 16;
                switch (g < 10) { case (true) { res[i * 2 + 1] = (byte)(48 + g); } default { res[i * 2 + 1] = (byte)(87 + g); }; };
                i++;
            };
            res[8] = (byte)0;
        };

        // dict{K:V} layout bookkeeping, keyed by variable name like fcodegen's module._dict_types
        struct DictInfo
        {
            TypeSpec* kts;
            TypeSpec* vts;
            IRType* kl;
            IRType* vl;
            int cap;
            IRType* st;
            byte** kc;      // constant text of each key slot (global dicts only)
            byte** vc;      // constant text of each value slot (global dicts only)
        };

        // Layout of a struct or object: field names, declared specs, LLVM types and
        // the vtable numbers (offset, width, alignment per field, in bits).
        struct SInfo
        {
            byte* name;
            IRType* ty;
            int n;
            byte** names;
            TypeSpec** specs;
            IRType** ftys;
            int* offs;
            int* bits;
            int* aligns;
            int total_bits;
            int max_align;
            bool is_object;
        };

        // A local variable: its storage and declared type
        struct LVar
        {
            IRValue* ptr;
            TypeSpec* ts;
            bool vol;
            bool is_heap;
        };

        // Heap copy of s from index start
        dup_from(byte* s, int start) -> byte*
        {
            int i = start;
            int n;
            while (s[i] != 0)
            {
                i++;
            };
            n = i - start;
            byte* r = (byte*)fmalloc((u64)(n + 1));
            i = 0;
            while (i < n)
            {
                r[i] = s[start + i];
                i++;
            };
            r[n] = (byte)0;
            -> r;
        };

        // Bit width of an LLVM type (SizeOfTypeHandler.bits_from_llvm_type)
        bits_of(IRType* t) -> int
        {
            int i, total;
            int k = t.kind;
            switch (k == LK.INT)
            {
                case (true) { -> t.width; }
                default
                {
                    switch (k == LK.FLOAT)
                    {
                        case (true) { -> 32; }
                        default
                        {
                            switch (k == LK.DOUBLE)
                            {
                                case (true) { -> 64; }
                                default
                                {
                                    switch (k == LK.ARRAY)
                                    {
                                        case (true) { -> bits_of(t.elem) * t.count; }
                                        default
                                        {
                                            switch (k == LK.PTR)
                                            {
                                                case (true) { -> 64; }
                                                default
                                                {
                                                    switch (k == LK.STRUCT | k == LK.ISTRUCT)
                                                    {
                                                        case (true) {
                                                        while (i < t.nitems)
                                                        {
                                                            total = total + bits_of(t.items[i]);
                                                            i++;
                                                        };
                                                        -> total;
                                                    }
                                                        default
                                                        {
                                                            -> 0;
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };

        // Field width used by ObjectTypeHandler.calculate_field_layout
        obj_field_bits(IRType* t, int* align_out) -> int
        {
            IRType* e;
            switch (t.kind == LK.INT)
            {
                case (true) {
                align_out[0] = t.width;
                -> t.width;
            }
                default
                {
                    switch (t.kind == LK.FLOAT)
                    {
                        case (true) {
                        align_out[0] = 32;
                        -> 32;
                    }
                        default
                        {
                            switch (t.kind == LK.DOUBLE)
                            {
                                case (true) {
                                align_out[0] = 64;
                                -> 64;
                            }
                                default
                                {
                                    switch (t.kind == LK.ARRAY)
                                    {
                                        case (true) {
                                        e = t.elem;
                                        switch (e.kind == LK.INT)
                                        {
                                            case (true) {
                                            align_out[0] = e.width;
                                            -> e.width * t.count;
                                        }
                                            default {};
                                        };
                                        switch (e.kind == LK.FLOAT)
                                        {
                                            case (true) {
                                            align_out[0] = 32;
                                            -> 32 * t.count;
                                        }
                                            default {};
                                        };
                                        switch (e.kind == LK.DOUBLE)
                                        {
                                            case (true) {
                                            align_out[0] = 64;
                                            -> 64 * t.count;
                                        }
                                            default {};
                                        };
                                        align_out[0] = 64;
                                        -> 64 * t.count;
                                    }
                                        default
                                        {
                                            switch (t.kind == LK.STRUCT | t.kind == LK.ISTRUCT)
                                            {
                                                case (true) {
                                                align_out[0] = 64;
                                                -> bits_of(t);
                                            }
                                                default
                                                {
                                                    align_out[0] = 64;
                                                    -> 64;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };

        object CodeGen
        {
            IRModule* mod;
            FXC_SYMTABLE* st;
            FXC_SYMTABLE* pst;      // parse time symbol table, built before DCE
            NameMap* structs;       // mangled name to SInfo*
            NameMap* tf_ast;        // unsized array type functions by __typefunc__<type>__<name>
            PtrVec* tf_pend;        // size specialized type functions awaiting a body: node, function, concrete spec
            bool tf_drain;
            PtrVec* ext_fns;        // function nodes declared inside extern blocks
            bool rec_fn;            // the function being generated is a <~ recursive function
            bool fwd_hit;           // a struct member named a struct whose body is not set yet
            bool retry_mode;        // re-running struct registration for forward references
            NameMap* unions;        // mangled name to IRType*
            NameMap* enums;         // mangled name to IRType*
            NameMap* aliases;       // mangled name to IRType*
            NameMap* consts;        // global name to i64* (integer initializers)
            NameMap* defined;       // function names that have a body
            PtrVec* owned;
            byte* cur_ns;
            byte* cur_obj;
            int byte_width;
            int nerrors;
            int err_line;
            byte* err_msg;
            IRType* t_i1;
            IRType* t_i8;
            IRType* t_i32;
            IRType* t_i64;
            IRType* t_void;
            IRType* t_float;
            IRType* t_double;
            IRType* t_i8p;
            int nfuncs;
            int ntypes;
            int al_tmp;
            Buf sc;             // text scratch
            int q_len;          // next_quoted results
            int q_end;
            PtrVec* defers;     // deferred statements of the block being generated
            Buf asmb;           // inline asm body
            Buf asmc;           // inline asm constraint string
            PtrVec* scopes;     // NameMap* of LVar*, innermost last
            IRFunc* fn;         // function whose body is being generated
            Node* fnd;
            IRType* fret;
            IRBlock* brk;
            IRBlock* cont;
            IRValue* exc_flag;      // innermost try block exception flag and value slots
            IRValue* exc_value;
            IRBlock* exc_handler;
            bool bad;           // the current body hit something not generated yet
            byte* bad_what;
            int bad_line;
            int body_errs;
            bool in_member;
            IRValue* va_list_v;
            IRValue* va_list_p;
            IRValue* nra;
            IRValue* nrb;
            TypeSpec** lspecs;
            NameMap* ucounts;   // construct name to count of bodies it stopped
            NameMap* gvars;     // mangled global name to its LVar
            NameMap* labels;    // label name to its block in the current function
            NameMap* untied;    // variables moved out by ~ in the current function
            NameMap* dicts;     // DictInfo by variable name (module._dict_types)
            PtrVec* inited_unions;   // union variables assigned in the current function
            bool gmv_full;           // global_member_value text already carries its type
            NameMap* fdefs;     // function name to its FUNCTION_DEF
            int nbodies;
            int nskipped;
            Node* cur_fd;       // function definition whose body is being generated
            NameMap* gcache;    // g-string bytes (escaped) to its global
            int nstr;           // .str.N counter
            bool null_term;     // config null_terminate_strings
            i64 ct_v;           // f-string compile time value
            int ct_k;           // 0 int, 1 bool, 2 char
            NameMap* enumvals;  // Enum.Item to i64 box
            NameMap* enum_defs; // mangled enum name to its ENUM_DEF node (borrowed)
            NameMap* union_defs; // mangled union name to its UNION_DEF node (borrowed)
            NameMap* tcache;    // typeof() result string to its global (deduplicated)
            PtrVec* arr_ptrs;   // pointer types that came from array decay (_is_array_pointer)
            PtrVec* al_names;   // type aliases in declaration order
            PtrVec* al_tys;
            PtrVec* al_specs;
            PtrVec* al_idx;     // top level statement index of each alias
            int cur_stmt;       // top level statement being generated
            bool si_closed;     // a top level function body has been generated

            __init(FXC_SYMTABLE* s) -> this
            {
                this.st = s;
                this.pst = (FXC_SYMTABLE*)0;
                this.mod = (IRModule*)fmalloc((u64)((sizeof(IRModule) + 7) / 8));
                this.mod.__init(g"flux_module\0");
                this.structs = nm_new();
                this.fwd_hit = false;
                this.rec_fn = false;
                this.retry_mode = false;
                this.ext_fns = pv_new();
                this.tf_ast = nm_new();
                this.tf_pend = pv_new();
                this.tf_drain = false;
                this.unions = nm_new();
                this.enums = nm_new();
                this.aliases = nm_new();
                this.consts = nm_new();
                this.defined = nm_new();
                this.owned = pv_new();
                this.cur_ns = ts_dup(g"\0");
                this.cur_obj = (byte*)0;
                this.byte_width = 8;
                this.nerrors = 0;
                this.err_line = 0;
                this.err_msg = (byte*)0;
                this.t_i1 = this.mod.t_int(1);
                this.t_i8 = this.mod.t_int(8);
                this.t_i32 = this.mod.t_int(32);
                this.t_i64 = this.mod.t_int(64);
                this.t_void = this.mod.t_void();
                this.t_float = this.mod.t_float();
                this.t_double = this.mod.t_double();
                this.t_i8p = this.mod.t_ptr(this.t_i8);
                this.al_tmp = 0;
                this.sc.__init();
                this.defers = (PtrVec*)0;
                this.asmb.__init();
                this.asmc.__init();
                this.scopes = pv_new();
                this.fn = (IRFunc*)0;
                this.fnd = (Node*)0;
                this.fret = (IRType*)0;
                this.brk = (IRBlock*)0;
                this.exc_flag = (IRValue*)0;
                this.exc_value = (IRValue*)0;
                this.exc_handler = (IRBlock*)0;
                this.cont = (IRBlock*)0;
                this.bad = false;
                this.bad_what = (byte*)0;
                this.bad_line = 0;
                this.body_errs = 0;
                this.in_member = false;
                this.nra = (IRValue*)0;
                this.nrb = (IRValue*)0;
                this.lspecs = (TypeSpec**)fmalloc((u64)24 * (u64)((sizeof(TypeSpec*) + 7) / 8));
                this.keep((void*)this.lspecs);
                int li;
                while (li < 24)
                {
                    this.lspecs[li] = (TypeSpec*)0;
                    li++;
                };
                this.ucounts = nm_new();
                this.gvars = nm_new();
                this.untied = nm_new();
                this.dicts = nm_new();
                this.labels = nm_new();
                this.inited_unions = pv_new();
                this.fdefs = nm_new();
                this.nbodies = 0;
                this.nskipped = 0;
                this.cur_fd = (Node*)0;
                this.gcache = nm_new();
                this.nstr = 0;
                this.null_term = false;
                this.ct_v = (i64)0;
                this.ct_k = 0;
                this.enumvals = nm_new();
                this.enum_defs = nm_new();
                this.union_defs = nm_new();
                this.tcache = nm_new();
                this.arr_ptrs = pv_new();
                this.al_names = pv_new();
                this.al_tys = pv_new();
                this.al_specs = pv_new();
                this.al_idx = pv_new();
                this.cur_stmt = 0;
                this.si_closed = false;
                -> this;
            };

            __expr() -> CodeGen* -> this;

            __exit() -> void
            {
                int i;
                while (i < this.owned.len)
                {
                    ffree((byte*)this.owned.items[i]);
                    i++;
                };
                pv_free(this.owned);
                pv_free(this.ext_fns);
                nm_free(this.tf_ast);
                pv_free(this.tf_pend);
                nm_free(this.structs);
                nm_free(this.unions);
                nm_free(this.enums);
                nm_free(this.aliases);
                nm_free(this.consts);
                nm_free(this.defined);
                nm_free(this.ucounts);
                nm_free(this.gvars);
                nm_free(this.labels);
                nm_free(this.untied);
                nm_free(this.fdefs);
                nm_free(this.gcache);
                nm_free(this.enumvals);
                nm_free(this.enum_defs);
                nm_free(this.union_defs);
                nm_free(this.tcache);
                pv_free(this.arr_ptrs);
                pv_free(this.al_names);
                pv_free(this.al_tys);
                pv_free(this.al_specs);
                pv_free(this.al_idx);
                pv_free(this.scopes);
                pv_free(this.inited_unions);
                ffree(this.cur_ns);
                this.mod.__exit();
                ffree((byte*)this.mod);
                this.sc.__exit();
                this.asmb.__exit();
                -> this.asmc.__exit();
            };

            // ----------------------------------------------------------
            // Errors and small helpers
            // ----------------------------------------------------------

            fail(byte* msg, int line) -> void
            {
                this.nerrors++;
                switch (this.err_msg == (byte*)0)
                {
                    case (true) {
                    this.err_msg = this.mod.own(msg);
                    this.err_line = line;
                }
                    default {};
                };
                ->;
            };

            // Keeps a heap block alive until __exit
            keep(void* p) -> void
            {
                -> pv_push(this.owned, p);
            };

            ptr_of(IRType* t) -> IRType* -> this.mod.t_ptr(t);

            set_ns(byte* ns) -> void
            {
                ffree(this.cur_ns);
                this.cur_ns = ts_dup(ns);
                -> st_set_namespace(this.st, ns);
            };

            // Heap ns::name joined for a nested namespace
            join_ns(byte* parent, byte* name) -> byte*
            {
                switch (parent[0] == 0)
                {
                    case (true) { -> ts_dup(name); }
                    default
                    {
                        -> join3(parent, g"::\0", name);
                    };
                };
            };

            // ----------------------------------------------------------
            // Integer constants (global initializers used as array sizes)
            // ----------------------------------------------------------

            add_const(byte* mangled, i64 v) -> void
            {
                i64* box = (i64*)fmalloc((u64)8);
                box[0] = v;
                this.keep((void*)box);
                -> nm_put(this.consts, mangled, (void*)box);
            };

            const_get(byte* name, i64* out) -> bool
            {
                void* p = nm_get(this.consts, name);
                switch (p == (void*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        i64* box = (i64*)p;
                        out[0] = box[0];
                        -> true;
                    };
                };
            };

            // Mirrors the four step lookup in get_llvm_type: bare name, current
            // namespace, using namespaces, then the symbol table.
            resolve_dim(byte* name, i64* out) -> bool
            {
                byte* m;
                bool ok;
                int i;
                FXC_SYMENTRY* e;
                switch (this.const_get(name, out))
                {
                    case (true) { -> true; }
                    default
                    {
                        switch (this.cur_ns[0] != 0)
                        {
                            case (true) {
                            m = mangle_namespace_name(this.cur_ns, name);
                            ok = this.const_get(m, out);
                            ffree(m);
                            switch (ok)
                            {
                                case (true) { -> true; }
                                default {};
                            };
                        }
                            default {};
                        };
                        while (i < this.st.using_ns.len)
                        {
                            m = mangle_namespace_name((byte*)this.st.using_ns.items[i], name);
                            ok = this.const_get(m, out);
                            ffree(m);
                            switch (ok)
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                        e = st_lookup_any(this.st, name, (byte*)0);
                        switch (e != (FXC_SYMENTRY*)0)
                        {
                            case (true) {
                            m = sym_mangled(e);
                            ok = this.const_get(m, out);
                            ffree(m);
                            switch (ok)
                            {
                                case (true) { -> true; }
                                default {};
                            };
                        }
                            default {};
                        };
                        -> false;
                    };
                };
            };

            // Child count and child of a namespace by virtual slot: 0..5 are the lists,
            // 6 is the variables list (a), 7 the nested namespaces list (b)
            ns_count(Node* n, int s) -> int
            {
                switch (s < 6)
                {
                    case (true) { -> node_count(n, s); }
                    default
                    {
                        switch (s == 6)
                        {
                            case (true) {
                            switch (n.a == (Node*)0)
                            {
                                case (true) { -> 0; }
                                default {};
                            };
                            -> node_count(n.a, 0);
                        }
                            default
                            {
                                switch (n.b == (Node*)0)
                                {
                                    case (true) { -> 0; }
                                    default
                                    {
                                        -> node_count(n.b, 0);
                                    };
                                };
                            };
                        };
                    };
                };
            };

            ns_child(Node* n, int s, int i) -> Node*
            {
                switch (s < 6)
                {
                    case (true) { -> node_child(n, s, i); }
                    default
                    {
                        switch (s == 6)
                        {
                            case (true) { -> node_child(n.a, 0, i); }
                            default
                            {
                                -> node_child(n.b, 0, i);
                            };
                        };
                    };
                };
            };

            // Registers integer-literal initializers of globals before types are lowered
            collect_consts(Node* n, byte* ns) -> void
            {
                int k = n.kind;
                int s, c, e;
                byte* full;
                byte* m;
                switch (k == NodeKind.NAMESPACE_DEF_STATEMENT | k == NodeKind.EXPORT_BLOCK |
                    k == NodeKind.EXTERN_BLOCK)
                {
                    case (true) {
                    switch (n.a != (Node*)0)
                    {
                        case (true) { this.collect_consts(n.a, ns); }
                        default {};
                    };
                    ->;
                }
                    default
                    {
                        switch (k == NodeKind.NAMESPACE_DEF)
                        {
                            case (true) {
                            full = this.join_ns(ns, n.text);
                            while (s < 8)
                            {
                                c = this.ns_count(n, s);
                                e = 0;
                                while (e < c)
                                {
                                    this.collect_consts(this.ns_child(n, s, e), full);
                                    e++;
                                };
                                s++;
                            };
                            -> ffree(full);
                        }
                            default
                            {
                                switch (k == NodeKind.VARIABLE_DECLARATION)
                                {
                                    case (true) {
                                    switch (n.text == (byte*)0)
                                    {
                                        case (true) { ->; }
                                        default
                                        {
                                            switch (n.a == (Node*)0)
                                            {
                                                case (true) { ->; }
                                                default
                                                {
                                                    switch (n.a.kind != NodeKind.LITERAL)
                                                    {
                                                        case (true) { ->; }
                                                        default
                                                        {
                                                            switch (n.a.op == DataType.FLOAT | n.a.op == DataType.DOUBLE)
                                                            {
                                                                case (true) { ->; }
                                                                default
                                                                {
                                                                    m = mangle_namespace_name(ns, n.text);
                                                                    this.add_const(m, n.a.ival);
                                                                    ffree(m);
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                }
                                    default {};
                                };
                                ->;
                            };
                        };
                    };
                };
            };

            // ----------------------------------------------------------
            // Type lowering
            // ----------------------------------------------------------

            // Struct, object or union symbol to its LLVM type, null when unknown
            type_of_symbol(FXC_SYMENTRY* e) -> IRType*
            {
                byte* m = sym_mangled(e);
                void* p;
                IRType* r = (IRType*)0;
                switch (e.kind_id == SymbolKind.STRUCT | e.kind_id == SymbolKind.OBJECT)
                {
                    case (true) {
                    p = nm_get(this.structs, m);
                    switch (p != (void*)0)
                    {
                        case (true) {
                        SInfo* si = (SInfo*)p;
                        r = si.ty;
                    }
                        default { r = this.mod.t_named(m); };
                    };
                }
                    default {
                        switch (e.kind_id == SymbolKind.UNION)
                        {
                            case (true) {
                    p = nm_get(this.unions, m);
                    switch (p != (void*)0)
                    {
                        case (true) { r = (IRType*)p; }
                        default {};
                    };
                }
                            default {
                                switch (e.kind_id == SymbolKind.ENUM)
                                {
                                    case (true) {
                    p = nm_get(this.enums, m);
                    switch (p != (void*)0)
                    {
                        case (true) { r = (IRType*)p; }
                        default { r = this.t_i32; };
                    };
                }
                                    default {};
                                };
                            };
                        };
                    };
                };
                ffree(m);
                -> r;
            };

            // TypeResolver.resolve_custom_type
            resolve_custom(byte* name) -> IRType*
            {
                FXC_SYMENTRY* e = st_lookup_any(this.st, name, this.cur_ns);
                byte* m;
                void* p;
                switch (e == (FXC_SYMENTRY*)0)
                {
                    case (true) { -> (IRType*)0; }
                    default
                    {
                        switch (e.kind_id == SymbolKind.TYPE)
                        {
                            case (true) {
                            switch (e.ts != (void*)0)
                            {
                                case (true) { -> this.lower((TypeSpec*)e.ts, false, 0); }
                                default {};
                            };
                            m = sym_mangled(e);
                            p = nm_get(this.aliases, m);
                            ffree(m);
                            switch (p != (void*)0)
                            {
                                case (true) { -> (IRType*)p; }
                                default {};
                            };
                            -> (IRType*)0;
                        }
                            default
                            {
                                switch (e.kind_id == SymbolKind.TRAIT)
                                {
                                    case (true) {
                                    this.fail(g"trait cannot be used in type contexts\0", 0);
                                    -> (IRType*)0;
                                }
                                    default
                                    {
                                        -> this.type_of_symbol(e);
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // Array element count of a size node: literal value, or identifier resolved
            // as a constant. Returns false when the size is not a compile time constant.
            dim_value(Node* d, i64* out) -> bool
            {
                switch (d.kind == NodeKind.LITERAL)
                {
                    case (true) {
                    out[0] = d.ival;
                    -> true;
                }
                    default
                    {
                        switch (d.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                            switch (d.text != (byte*)0)
                            {
                                case (true) { -> this.resolve_dim(d.text, out); }
                                default {};
                            };
                        }
                            default {};
                        };
                        -> false;
                    };
                };
            };

            // TypeSystem.get_llvm_type. incl wraps the array dimensions.
            lower(TypeSpec* t, bool incl, int line) -> IRType*
            {
                IRType* base = (IRType*)0;
                IRType* el;
                IRType** ps;
                int i, depth, bt;
                i64 dv;
                bool wrap_i8;

                bt = t.base_type;
                switch (bt == DataType.FUNC_PTR)
                {
                    case (true) {
                    ps = (IRType**)fmalloc((u64)(t.fp_nparams + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                    this.keep((void*)ps);
                    while (i < t.fp_nparams)
                    {
                        ps[i] = this.lower(t.fp_params[i], false, line);
                        i++;
                    };
                    -> this.ptr_of(this.mod.t_func(this.lower(t.fp_ret, false, line), ps, t.fp_nparams, false));
                }
                    default
                    {
                        switch (t.custom_typename != (byte*)0)
                        {
                            case (true) {
                            base = this.resolve_custom(t.custom_typename);
                            switch (base == (IRType*)0)
                            {
                                case (true) {
                                this.fail(join3(g"Unknown type: \0", t.custom_typename, g"\0"), line);
                                -> this.t_i32;
                            }
                                default
                                {
                                    switch (base.kind == LK.ARRAY & !ts_is_array(t))
                                    {
                                        case (true) { base = this.ptr_of(base.elem); }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {
                                switch (bt == DataType.SINT | bt == DataType.UINT)
                                {
                                    case (true) { base = this.t_i32; }
                                    default {
                                        switch (bt == DataType.FLOAT)
                                        {
                                            case (true) { base = this.t_float; }
                                            default {
                                                switch (bt == DataType.DOUBLE)
                                                {
                                                    case (true) { base = this.t_double; }
                                                    default {
                                                        switch (bt == DataType.SLONG | bt == DataType.ULONG)
                                                        {
                                                            case (true) { base = this.t_i64; }
                                                            default {
                                                                switch (bt == DataType.BOOL)
                                                                {
                                                                    case (true) { base = this.t_i1; }
                                                                    default {
                                                                        switch (bt == DataType.CHAR)
                                                                        {
                                                                            case (true) { base = this.t_i8; }
                                                                            default {
                                                                                switch (bt == DataType.BYTE)
                                                                                {
                                                                                    case (true) {
                            switch (t.bit_width > 0)
                            {
                                case (true) { base = this.mod.t_int(t.bit_width); }
                                default { base = this.mod.t_int(this.byte_width); };
                            };
                        }
                                                                                    default {
                                                                                        switch (bt == DataType.STRUCT | bt == DataType.OBJECT)
                                                                                        {
                                                                                            case (true) { base = this.t_i8; }
                                                                                            default {
                                                                                                switch (bt == DataType.ENUM)
                                                                                                {
                                                                                                    case (true) { base = this.t_i32; }
                                                                                                    default {
                                                                                                        switch (bt == DataType.VOID)
                                                                                                        {
                                                                                                            case (true) { base = this.t_void; }
                                                                                                            default {
                                                                                                                switch (bt == DataType.DATA)
                                                                                                                {
                                                                                                                    case (true) {
                            switch (t.bit_width <= 0)
                            {
                                case (true) {
                                this.fail(g"DATA type missing bit_width\0", line);
                                -> this.t_i32;
                            }
                                default
                                {
                                    base = this.mod.t_int(t.bit_width);
                                };
                            };
                        }
                                                                                                                    default {
                                                                                                                        switch (bt == DataType.DICT)
                                                                                                                        {
                                                                                                                            case (true) {
                            IRType* kt = this.t_i8;
                            IRType* vt = this.t_i8;
                            int cap = 0;
                            switch (t.dict_capacity > 0)
                            {
                                case (true) { cap = t.dict_capacity; }
                                default {};
                            };
                            switch (t.dict_key != (TypeSpec*)0)
                            {
                                case (true) { kt = this.lower(t.dict_key, false, line); }
                                default {};
                            };
                            switch (t.dict_value != (TypeSpec*)0)
                            {
                                case (true) { vt = this.lower(t.dict_value, false, line); }
                                default {};
                            };
                            ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                            this.keep((void*)ps);
                            ps[0] = this.mod.t_array(kt, cap);
                            ps[1] = this.mod.t_array(vt, cap);
                            ps[2] = this.t_i32;
                            base = this.mod.t_struct(ps, 3);
                        }
                                                                                                                            default {
                                                                                                                                switch (bt == DataType.THIS)
                                                                                                                                {
                                                                                                                                    case (true) {
                            switch (this.cur_obj != (byte*)0)
                            {
                                case (true) {
                                base = this.ptr_of(this.mod.t_named(this.cur_obj));
                            }
                                default { base = this.t_i8p; };
                            };
                        }
                                                                                                                                    default {
                            this.fail(g"Unsupported type\0", line);
                            -> this.t_i32;
                        };
                                                                                                                                };
                                                                                                                            };
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };

                        el = base;
                        switch (ts_is_pointer(t))
                        {
                            case (true) {
                            depth = t.pointer_depth;
                            switch (depth <= 0)
                            {
                                case (true) { depth = 1; }
                                default {};
                            };
                            wrap_i8 = (bt == DataType.VOID | bt == DataType.STRUCT | bt == DataType.OBJECT);
                            switch (wrap_i8)
                            {
                                case (true) { el = this.t_i8; }
                                default {};
                            };
                            i = 0;
                            while (i < depth)
                            {
                                el = this.ptr_of(el);
                                i++;
                            };
                        }
                            default {};
                        };

                        switch (!incl)
                        {
                            case (true) { -> el; }
                            default
                            {
                                switch (ts_is_array(t))
                                {
                                    case (true) {
                                    switch (t.array_dims != (NodeVec*)0)
                                    {
                                        case (true) {
                                        switch (t.array_dims.len > 0)
                                        {
                                            case (true) {
                                            IRType* cur = el;
                                            Node* d;
                                            i = t.array_dims.len - 1;
                                            while (i >= 0)
                                            {
                                                d = t.array_dims.items[i];
                                                switch (d != (Node*)0)
                                                {
                                                    case (true) {
                                                    switch (this.dim_value(d, @dv))
                                                    {
                                                        case (true) { cur = this.mod.t_array(cur, (int)dv); }
                                                        default { -> this.ptr_of(el); };
                                                    };
                                                }
                                                    default { cur = this.ptr_of(cur); };
                                                };
                                                i--;
                                            };
                                            -> cur;
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    switch (t.array_size != (Node*)0)
                                    {
                                        case (true) {
                                        switch (this.dim_value(t.array_size, @dv))
                                        {
                                            case (true) { -> this.mod.t_array(el, (int)dv); }
                                            default {};
                                        };
                                        -> this.ptr_of(el);
                                    }
                                        default {};
                                    };
                                    switch (el.kind == LK.PTR)
                                    {
                                        case (true) { -> el; }
                                        default {};
                                    };
                                    -> this.ptr_of(el);
                                }
                                    default
                                    {
                                        -> el;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // convert_type_spec_to_llvm: dicts are passed by pointer
            lower_sig(TypeSpec* t, int line) -> IRType*
            {
                IRType* b;
                switch (t.base_type == DataType.DICT)
                {
                    case (true) {
                    b = this.lower(t, true, line);
                    switch (ts_is_pointer(t))
                    {
                        case (true) { -> b; }
                        default {};
                    };
                    -> this.ptr_of(b);
                }
                    default
                    {
                        -> this.lower(t, true, line);
                    };
                };
            };

            // ----------------------------------------------------------
            // Struct and object types
            // ----------------------------------------------------------

            new_sinfo(byte* name, int n, bool is_object) -> SInfo*
            {
                SInfo* si = (SInfo*)fmalloc((u64)((sizeof(SInfo) + 7) / 8));
                si.name = this.mod.own(name);
                si.ty = this.mod.t_named(name);
                si.n = n;
                si.names = (byte**)fmalloc((u64)(n + 1) * (u64)((sizeof(byte*) + 7) / 8));
                si.specs = (TypeSpec**)fmalloc((u64)(n + 1) * (u64)((sizeof(TypeSpec*) + 7) / 8));
                si.ftys = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                si.offs = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                si.bits = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                si.aligns = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                si.total_bits = 0;
                si.max_align = 1;
                si.is_object = is_object;
                this.keep((void*)si.names);
                this.keep((void*)si.specs);
                this.keep((void*)si.ftys);
                this.keep((void*)si.offs);
                this.keep((void*)si.bits);
                this.keep((void*)si.aligns);
                this.keep((void*)si);
                nm_put(this.structs, si.name, (void*)si);
                -> si;
            };

            // Text of the {total_bits, field_count, [fields]} TLD constant and its type
            tld_global(SInfo* si) -> void
            {
                IRType* ft;
                IRType* at;
                IRType* vt;
                IRType** parts;
                int i;
                byte* nm;
                IRGlobal* g;
                parts = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)parts);
                parts[0] = this.t_i32;
                parts[1] = this.t_i32;
                parts[2] = this.t_i32;
                ft = this.mod.t_struct(parts, 3);
                at = this.mod.t_array(ft, si.n);
                parts = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)parts);
                parts[0] = this.t_i32;
                parts[1] = this.t_i32;
                parts[2] = at;
                vt = this.mod.t_struct(parts, 3);

                this.sc.clear();
                this.sc.put_str(g"{i32 \0");
                this.sc.put_str(f"{si.total_bits}, i32 {si.n}, \0");
                lt_text(@this.sc, at);
                this.sc.put_str(g" [\0");
                while (i < si.n)
                {
                    switch (i > 0)
                    {
                        case (true) { this.sc.put_str(g", \0"); }
                        default {};
                    };
                    lt_text(@this.sc, ft);
                    this.sc.put_str(g" {i32 \0");
                    this.sc.put_str(f"{si.offs[i]}, i32 {si.bits[i]}, i32 {si.aligns[i]}\0");
                    this.sc.put(125);
                    i++;
                };
                this.sc.put_str(g"]}\0");
                nm = join3(si.name, g".TLD\0", g"\0");
                g = this.mod.add_global(vt, nm, this.sc.mem);
                g.linkage = this.mod.own(g"internal\0");
                g.constant = true;
                -> ffree(nm);
            };

            // Prepends or appends the fields of the base structs named in list slot
            struct_member_count(Node* sd) -> int
            {
                int total = node_count(sd, 0);
                int i, j;
                Node* b;
                void* p;
                SInfo* bi;
                while (i < node_count(sd, 1))
                {
                    b = node_child(sd, 1, i);
                    p = nm_get(this.structs, b.text);
                    switch (p != (void*)0)
                    {
                        case (true) {
                        bi = (SInfo*)p;
                        total = total + bi.n;
                    }
                        default {};
                    };
                    i++;
                };
                while (j < node_count(sd, 2))
                {
                    b = node_child(sd, 2, j);
                    p = nm_get(this.structs, b.text);
                    switch (p != (void*)0)
                    {
                        case (true) {
                        bi = (SInfo*)p;
                        total = total + bi.n;
                    }
                        default {};
                    };
                    j++;
                };
                -> total;
            };

            // True when t, or the element type of the array t, is an identified struct without a body
            is_fwd_struct(IRType* t) -> bool
            {
                IRType* e = t;
                while (e.kind == LK.ARRAY) { e = e.elem; };
                -> e.kind == LK.ISTRUCT & !e.defined & e.nitems == 0;
            };

            // visit_StructDef
            reg_struct(Node* sd, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, sd.text);
                int i, j, idx, total, nm_, k;
                Node* mem;
                Node* b;
                void* p;
                SInfo* si;
                SInfo* bi;
                IRType* ft;
                bool has_bits;

                switch (sd.l4 != (NodeVec*)0)
                {
                    case (true) {
                    switch (sd.l4.len > 0)
                    {
                        case (true) {
                        -> ffree(name);
                    }
                        default {};
                    };
                }
                    default {};
                };

                nm_ = node_count(sd, 0);
                p = nm_get(this.structs, name);
                switch (p != (void*)0)
                {
                    case (true) {
                    switch (nm_ == 0 & node_count(sd, 1) == 0 & node_count(sd, 2) == 0)
                    {
                        case (true) {
                        -> ffree(name);
                    }
                        default
                        {
                            si = (SInfo*)p;
                            switch (si.ty.defined & si.ty.nitems > 0)
                            {
                                case (true) {
                                -> ffree(name);
                            }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };

                total = this.struct_member_count(sd);
                switch (total == 0)
                {
                    case (true) {
                    switch (nm_get(this.structs, name) == (void*)0)
                    {
                        case (true) { this.new_sinfo(name, 0, false); }
                        default {};
                    };
                    -> ffree(name);
                }
                    default
                    {
                        si = this.new_sinfo(name, total, false);
                        si.ty.defined = false;

                        // Pre-body bases, then own members, then post bases
                        i = 0;
                        while (i < node_count(sd, 1))
                        {
                            b = node_child(sd, 1, i);
                            p = nm_get(this.structs, b.text);
                            switch (p == (void*)0)
                            {
                                case (true) {
                                this.fail(join3(g"Struct composition: base struct '\0", b.text, g"' has not been defined\0"), sd.line);
                            }
                                default {
                                bi = (SInfo*)p;
                                k = 0;
                                while (k < bi.n)
                                {
                                    si.names[idx] = bi.names[k];
                                    si.specs[idx] = bi.specs[k];
                                    idx++;
                                    k++;
                                };
                            };
                            };
                            i++;
                        };
                        i = 0;
                        while (i < nm_)
                        {
                            mem = node_child(sd, 0, i);
                            si.names[idx] = mem.text;
                            si.specs[idx] = mem.ts;
                            idx++;
                            i++;
                        };
                        j = 0;
                        while (j < node_count(sd, 2))
                        {
                            b = node_child(sd, 2, j);
                            p = nm_get(this.structs, b.text);
                            switch (p == (void*)0)
                            {
                                case (true) {
                                this.fail(join3(g"Struct post-composition: struct '\0", b.text, g"' has not been defined\0"), sd.line);
                            }
                                default {
                                bi = (SInfo*)p;
                                k = 0;
                                while (k < bi.n)
                                {
                                    si.names[idx] = bi.names[k];
                                    si.specs[idx] = bi.specs[k];
                                    idx++;
                                    k++;
                                };
                            };
                            };
                            j++;
                        };
                        si.n = idx;

                        // calculate_vtable: tightly packed, widths from the declared bit width
                        // of scalar data{} members, else from the LLVM type
                        int off = 0;
                        int bw, al;
                        i = 0;
                        while (i < si.n)
                        {
                            ft = this.lower(si.specs[i], true, sd.line);
                            si.ftys[i] = ft;
                            // A member naming a struct whose body is not set yet is a forward reference:
                            // the struct stays opaque and registration is retried once the rest exist
                            switch (this.is_fwd_struct(ft))
                            {
                                case (true) {
                                this.fwd_hit = true;
                                -> ffree(name);
                            }
                                default
                                {
                                    switch (si.specs[i].bit_width > 0 & !ts_is_array(si.specs[i]))
                                    {
                                        case (true) {
                                        bw = si.specs[i].bit_width;
                                        switch (si.specs[i].alignment > 0)
                                        {
                                            case (true) { al = si.specs[i].alignment; }
                                            default { al = bw; };
                                        };
                                    }
                                        default {
                                        bw = bits_of(ft);
                                        al = bw;
                                        switch (bw > 64)
                                        {
                                            case (true) { al = 64; }
                                            default {};
                                        };
                                    };
                                    };
                                    si.offs[i] = off;
                                    si.bits[i] = bw;
                                    si.aligns[i] = al;
                                    off = off + bw;
                                    switch (al > si.max_align)
                                    {
                                        case (true) { si.max_align = al; }
                                        default {};
                                    };
                                    i++;
                                };
                            };
                        };
                        si.total_bits = off;
                        this.mod.set_body(si.ty, si.ftys, si.n);
                        this.tld_global(si);

                        i = 0;
                        while (i < node_count(sd, 3))
                        {
                            this.reg_struct(node_child(sd, 3, i), ns);
                            i++;
                        };
                        -> ffree(name);
                    };
                };
            };

            // ObjectTypeHandler.create_member_types, create_struct_type, create_vtable
            reg_object_type(Node* od, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, od.text);
                int n = node_count(od, 0);
                int i, off, bw;
                void* p;
                SInfo* si;
                Node* mem;

                switch (this.is_template(od))
                {
                    case (true) {
                    -> ffree(name);
                }
                    default
                    {
                        p = nm_get(this.structs, name);
                        switch (p != (void*)0)
                        {
                            case (true) {
                            si = (SInfo*)p;
                            switch (n == 0 | si.n > 0)
                            {
                                case (true) {
                                -> ffree(name);
                            }
                                default {};
                            };
                        }
                            default {};
                        };

                        switch (n == 0)
                        {
                            case (true) {
                            switch (p == (void*)0)
                            {
                                case (true) {
                                si = this.new_sinfo(name, 0, true);
                                si.ty.defined = false;
                            }
                                default {};
                            };
                            -> ffree(name);
                        }
                            default
                            {
                                switch (p == (void*)0)
                                {
                                    case (true) { si = this.new_sinfo(name, n, true); }
                                    default {
                                    si = (SInfo*)p;
                                    si.n = n;
                                    si.is_object = true;
                                    si.names = (byte**)fmalloc((u64)(n + 1) * (u64)((sizeof(byte*) + 7) / 8));
                                    si.specs = (TypeSpec**)fmalloc((u64)(n + 1) * (u64)((sizeof(TypeSpec*) + 7) / 8));
                                    si.ftys = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                                    si.offs = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                                    si.bits = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                                    si.aligns = (int*)fmalloc((u64)(n + 1) * (u64)((sizeof(int) + 7) / 8));
                                    this.keep((void*)si.names);
                                    this.keep((void*)si.specs);
                                    this.keep((void*)si.ftys);
                                    this.keep((void*)si.offs);
                                    this.keep((void*)si.bits);
                                    this.keep((void*)si.aligns);
                                };
                                };
                                si.ty.defined = false;

                                i = 0;
                                while (i < n)
                                {
                                    mem = node_child(od, 0, i);
                                    si.names[i] = mem.text;
                                    si.specs[i] = mem.ts;
                                    si.ftys[i] = this.lower(mem.ts, true, od.line);
                                    bw = obj_field_bits(si.ftys[i], @this.al_tmp);
                                    si.offs[i] = off;
                                    si.bits[i] = bw;
                                    si.aligns[i] = this.al_tmp;
                                    switch (this.al_tmp > si.max_align)
                                    {
                                        case (true) { si.max_align = this.al_tmp; }
                                        default {};
                                    };
                                    off = off + bw;
                                    i++;
                                };
                                si.total_bits = off;
                                this.mod.set_body(si.ty, si.ftys, si.n);
                                -> ffree(name);
                            };
                        };
                    };
                };
            };

            is_template(Node* od) -> bool
            {
                switch (od.d == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (od.d.l0 == (NodeVec*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                -> od.d.l0.len > 0;
                            };
                        };
                    };
                };
            };

            // Types nested inside an object
            reg_object_nested(Node* od, byte* ns) -> void
            {
                int i;
                while (i < node_count(od, 4))
                {
                    this.reg_struct(node_child(od, 4, i), ns);
                    i++;
                };
                i = 0;
                while (i < node_count(od, 3))
                {
                    this.reg_object_type(node_child(od, 3, i), ns);
                    i++;
                };
                ->;
            };

            // ----------------------------------------------------------
            // Enums, unions, aliases
            // ----------------------------------------------------------

            reg_enum(Node* ed, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, ed.text);
                IRType* ty = this.t_i32;
                int i, n;
                byte* cn;
                byte* nmx;
                IRGlobal* g;
                IRValue* v;
                Node* item;
                switch (ed.ts != (TypeSpec*)0)
                {
                    case (true) { ty = this.lower(ed.ts, false, ed.line); }
                    default {};
                };
                nm_put(this.enums, name, (void*)ty);
                nm_put(this.enum_defs, name, (void*)ed);
                n = node_count(ed, 0);
                while (i < n)
                {
                    item = node_child(ed, 0, i);
                    cn = join3(name, g".\0", item.text);
                    switch (ty.kind == LK.STRUCT | ty.kind == LK.ISTRUCT | ty.kind == LK.ARRAY)
                    {
                        case (true) {
                        g = this.mod.add_global(ty, cn, g"zeroinitializer\0");
                    }
                        default {
                        v = this.mod.c_int(ty, item.ival);
                        g = this.mod.add_global(ty, cn, v.text);
                        g.constant = true;
                    };
                    };
                    i64* eb = (i64*)fmalloc((u64)8);
                    eb[0] = item.ival;
                    this.keep((void*)eb);
                    nm_put(this.enumvals, this.mod.own(cn), (void*)eb);
                    ffree(cn);
                    i++;
                };
                -> ffree(name);
            };

            // Size in bytes the way visit_UnionDef computes it
            union_size(IRType* t) -> int
            {
                int total, i;
                IRType* e;
                switch (t.kind == LK.INT)
                {
                    case (true) { -> (t.width + 7) / 8; }
                    default
                    {
                        switch (t.kind == LK.FLOAT)
                        {
                            case (true) { -> 4; }
                            default
                            {
                                switch (t.kind == LK.DOUBLE)
                                {
                                    case (true) { -> 8; }
                                    default
                                    {
                                        switch (t.kind == LK.PTR)
                                        {
                                            case (true) { -> 8; }
                                            default
                                            {
                                                switch (t.kind == LK.ARRAY)
                                                {
                                                    case (true) {
                                                    e = t.elem;
                                                    switch (e.kind == LK.INT)
                                                    {
                                                        case (true) { -> ((e.width + 7) / 8) * t.count; }
                                                        default {};
                                                    };
                                                    switch (e.kind == LK.FLOAT)
                                                    {
                                                        case (true) { -> 4 * t.count; }
                                                        default {};
                                                    };
                                                    switch (e.kind == LK.DOUBLE)
                                                    {
                                                        case (true) { -> 8 * t.count; }
                                                        default {};
                                                    };
                                                    -> 8 * t.count;
                                                }
                                                    default
                                                    {
                                                        switch (t.kind == LK.STRUCT)
                                                        {
                                                            case (true) {
                                                            while (i < t.nitems)
                                                            {
                                                                e = t.items[i];
                                                                switch (e.kind)
                                                                {
                                                                    case (LK.INT) { total = total + (e.width + 7) / 8; }
                                                                    case (LK.FLOAT) { total = total + 4; }
                                                                    default { total = total + 8; };
                                                                };
                                                                i++;
                                                            };
                                                            -> total;
                                                        }
                                                            default
                                                            {
                                                                -> 8;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            reg_union(Node* ud, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, ud.text);
                int n = node_count(ud, 0);
                int i, sz, mx;
                IRType* mt;
                IRType* mxt = (IRType*)0;
                IRType** parts;
                Node* mem;
                nm_put(this.union_defs, name, (void*)ud);
                i = 0;
                while (i < n)
                {
                    mem = node_child(ud, 0, i);
                    mt = this.lower(mem.ts, false, ud.line);
                    sz = this.union_size(mt);
                    switch (sz > mx)
                    {
                        case (true) {
                        mx = sz;
                        mxt = mt;
                    }
                        default {};
                    };
                    i++;
                };
                parts = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)parts);
                switch (ud.text2 != (byte*)0)
                {
                    case (true) {
                    parts[0] = this.t_i32;
                    parts[1] = this.mod.t_array(this.t_i8, mx);
                    nm_put(this.unions, name, (void*)this.mod.t_struct(parts, 2));
                }
                    default {
                    switch (mxt == (IRType*)0)
                    {
                        case (true) { mxt = this.t_i8; }
                        default {};
                    };
                    parts[0] = mxt;
                    nm_put(this.unions, name, (void*)this.mod.t_struct(parts, 1));
                };
                };
                -> ffree(name);
            };

            reg_alias(Node* td, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, td.text);
                IRType* ty = this.lower(td.ts, true, td.line);
                nm_put(this.aliases, name, (void*)ty);
                pv_push(this.al_names, (void*)this.mod.own(td.text));
                pv_push(this.al_tys, (void*)ty);
                pv_push(this.al_specs, (void*)td.ts);
                pv_push(this.al_idx, (void*)(i64)this.cur_stmt);
                -> ffree(name);
            };

            // ----------------------------------------------------------
            // Functions
            // ----------------------------------------------------------

            cc_name(byte* cc) -> byte*
            {
                switch (cstr_eq(cc, g"cdecl\0"))
                {
                    case (true) { -> this.mod.own(g"ccc\0"); }
                    default
                    {
                        switch (cstr_eq(cc, g"stdcall\0"))
                        {
                            case (true) { -> this.mod.own(g"x86_stdcallcc\0"); }
                            default
                            {
                                switch (cstr_eq(cc, g"fastcall\0"))
                                {
                                    case (true) { -> this.mod.own(g"fastcc\0"); }
                                    default
                                    {
                                        switch (cstr_eq(cc, g"thiscall\0"))
                                        {
                                            case (true) { -> this.mod.own(g"x86_thiscallcc\0"); }
                                            default
                                            {
                                                switch (cstr_eq(cc, g"vectorcall\0"))
                                                {
                                                    case (true) { -> this.mod.own(g"x86_vectorcallcc\0"); }
                                                    default
                                                    {
                                                        -> this.mod.own(cc);
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // Heap array of the parameter TypeSpecs of a function node
            param_specs(Node* fd) -> TypeSpec**
            {
                int n = node_count(fd, 0);
                int i;
                TypeSpec** ps = (TypeSpec**)fmalloc((u64)(n + 1) * (u64)((sizeof(TypeSpec*) + 7) / 8));
                this.keep((void*)ps);
                while (i < n)
                {
                    ps[i] = node_child(fd, 0, i).ts;
                    i++;
                };
                -> ps;
            };

            mangled_name(byte* base, Node* fd) -> byte*
            {
                this.sc.clear();
                mangle_function(@this.sc, base, this.param_specs(fd), node_count(fd, 0), fd.ts);
                -> ts_dup(this.sc.mem);
            };

            // name_args for an assignment that finds earlier names taken: each repeat gets the next suffix
            rename_args(IRFunc* f, Node* fd, int skip) -> void
            {
                int i;
                Node* p;
                while (i < f.nargs - skip)
                {
                    p = node_child(fd, 0, i);
                    switch (p.text != (byte*)0)
                    {
                        case (true) { this.mod.rename_arg(f, i + skip, p.text); }
                        default {
                        this.sc.clear();
                        this.sc.put_str(f"arg{i}\0");
                        this.mod.rename_arg(f, i + skip, this.sc.mem);
                    };
                    };
                    i++;
                };
                ->;
            };

            // Names the arguments of a function the way visit_FunctionDef does
            name_args(IRFunc* f, Node* fd, int skip) -> void
            {
                int i;
                Node* p;
                while (i < f.nargs - skip)
                {
                    p = node_child(fd, 0, i);
                    switch (p.text != (byte*)0)
                    {
                        case (true) { this.mod.name_arg(f, i + skip, p.text); }
                        default {
                        this.sc.clear();
                        this.sc.put_str(f"arg{i}\0");
                        this.mod.name_arg(f, i + skip, this.sc.mem);
                    };
                    };
                    i++;
                };
                ->;
            };

            // Function type of a FUNCTION_DEF (dual return folds into a struct)
            func_type_of(Node* fd, int skip, IRType* first) -> IRType*
            {
                int n = node_count(fd, 0);
                IRType* ret = this.lower_sig(fd.ts, fd.line);
                IRType** ps;
                IRType** rp;
                int i;
                switch (fd.ts2 != (TypeSpec*)0)
                {
                    case (true) {
                    rp = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                    this.keep((void*)rp);
                    rp[0] = ret;
                    rp[1] = this.lower_sig(fd.ts2, fd.line);
                    rp[2] = this.t_i1;
                    ret = this.mod.t_struct(rp, 3);
                }
                    default {};
                };
                ps = (IRType**)fmalloc((u64)(n + skip + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                switch (skip > 0)
                {
                    case (true) { ps[0] = first; }
                    default {};
                };
                while (i < n)
                {
                    ps[i + skip] = this.lower_sig(node_child(fd, 0, i).ts, fd.line);
                    i++;
                };
                -> this.mod.t_func(ret, ps, n + skip, (fd.flags `& NF_VARIADIC) != 0);
            };

            // visit_FunctionDef up to the point a body would be emitted
            declare_function(Node* fd, byte* ns) -> IRFunc*
            {
                switch (fd.text == (byte*)0)
                {
                    case (true) { -> (IRFunc*)0; }
                    default
                    {
                        switch ((fd.flags `& NF_TEMPLATE) != 0)
                        {
                            case (true) { -> (IRFunc*)0; }
                            default
                            {
                                IRType* ft = this.func_type_of(fd, 0, (IRType*)0);
                                byte* base = mangle_namespace_name(ns, fd.text);
                                byte* mn;
                                IRFunc* f;
                                IRFunc* ex;
                                bool proto = (fd.flags `& NF_PROTOTYPE) != 0;
                                switch ((fd.flags `& NF_NO_MANGLE) != 0)
                                {
                                    case (true) { mn = ts_dup(base); }
                                    default { mn = this.mangled_name(base, fd); };
                                };
                                ex = this.mod.find_function(mn);
                                switch (ex != (IRFunc*)0)
                                {
                                    case (true) {
                                    switch (proto)
                                    {
                                        case (true) { f = ex; }
                                        default {
                                            switch (ex.is_decl & ex.nargs == node_count(fd, 0))
                                            {
                                                case (true) { f = ex; }
                                                default {
                                        switch (nm_has(this.defined, mn))
                                        {
                                            case (true) {
                                            this.fail(join3(g"Function '\0", fd.text, g"' redefined\0"), fd.line);
                                            ffree(base);
                                            ffree(mn);
                                            -> ex;
                                        }
                                            default
                                            {
                                                byte* dn = join3(mn, g"__\0", g"args\0");
                                                f = this.mod.find_function(dn);
                                                switch (f == (IRFunc*)0)
                                                {
                                                    case (true) { f = this.mod.add_function(ft, dn); }
                                                    default {};
                                                };
                                                ffree(dn);
                                            };
                                        };
                                    };
                                            };
                                        };
                                    };
                                }
                                    default {
                                    f = this.mod.add_function(ft, mn);
                                    this.nfuncs++;
                                };
                                };
                                switch (fd.text2 != (byte*)0)
                                {
                                    case (true) { f.cconv = this.cc_name(fd.text2); }
                                    default {};
                                };
                                switch (!proto)
                                {
                                    case (true) {
                                    nm_put(this.defined, mn, (void*)f);
                                    nm_put(this.fdefs, f.name, (void*)fd);
                                    switch ((fd.flags `& NF_INLINE) != 0)
                                    {
                                        case (true) { pv_push(f.attrs, (void*)this.mod.own(g"alwaysinline\0")); }
                                        default {};
                                    };
                                    this.name_args(f, fd, 0);
                                }
                                    default {};
                                };
                                ffree(base);
                                ffree(mn);
                                -> f;
                            };
                        };
                    };
                };
            };

            // visit_ExternBlock declaration
            declare_extern(Node* fd, byte* ns) -> void
            {
                IRType* ft;
                byte* base;
                byte* fin;
                IRFunc* f;
                IRType* vt;
                IRGlobal* g;
                switch (fd.kind == NodeKind.VARIABLE_DECLARATION)
                {
                    case (true) {
                    vt = this.lower(fd.ts, false, fd.line);
                    switch (this.mod.find_global(fd.text) == (IRGlobal*)0)
                    {
                        case (true) {
                        g = this.mod.add_global(vt, fd.text, (byte*)0);
                        g.linkage = this.mod.own(g"external\0");
                    }
                        default {};
                    };
                    ->;
                }
                    default
                    {
                        switch (fd.text == (byte*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch ((fd.flags `& NF_PROTOTYPE) == 0)
                                {
                                    case (true) {
                                    -> this.fail(join3(g"Extern functions must be prototypes: \0", fd.text, g"\0"), fd.line);
                                }
                                    default
                                    {
                                        ft = this.extern_type(fd);
                                        base = ts_dup(fd.text);
                                        int cut = 0;
                                        int k = 0;
                                        while (base[k] != 0)
                                        {
                                            switch (base[k] == ':' & base[k + 1] == ':')
                                            {
                                                case (true) { cut = k + 2; }
                                                default {};
                                            };
                                            k++;
                                        };
                                        byte* b1 = dup_from(base, cut);
                                        k = 0;
                                        cut = 0;
                                        while (b1[k] != 0)
                                        {
                                            switch (b1[k] == '_' & b1[k + 1] == '_')
                                            {
                                                case (true) { cut = k + 2; }
                                                default {};
                                            };
                                            k++;
                                        };
                                        byte* b2 = dup_from(b1, cut);
                                        switch ((fd.flags `& NF_NO_MANGLE) != 0)
                                        {
                                            case (true) { fin = ts_dup(b2); }
                                            default { fin = this.mangled_name(b2, fd); };
                                        };
                                        f = this.mod.find_function(fin);
                                        switch (f == (IRFunc*)0)
                                        {
                                            case (true) {
                                            f = this.mod.add_function(ft, fin);
                                            this.nfuncs++;
                                        }
                                            default {};
                                        };
                                        f.linkage = this.mod.own(g"external\0");
                                        this.name_args(f, fd, 0);
                                        ffree(base);
                                        ffree(b1);
                                        ffree(b2);
                                        -> ffree(fin);
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // Extern prototypes lower without the dict/dual-return handling
            extern_type(Node* fd) -> IRType*
            {
                int n = node_count(fd, 0);
                int i;
                IRType** ps = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                while (i < n)
                {
                    ps[i] = this.lower(node_child(fd, 0, i).ts, false, fd.line);
                    i++;
                };
                -> this.mod.t_func(this.lower(fd.ts, false, fd.line), ps, n, false);
            };

            // ObjectTypeHandler.create_method_signature and predeclare_method
            declare_method(Node* od, Node* m, byte* obj_name) -> void
            {
                IRType* st_ty = this.mod.t_named(obj_name);
                IRType* self_ty = this.ptr_of(st_ty);
                byte* prev = this.cur_obj;
                IRType* ft;
                IRFunc* f;
                byte* mn;
                byte* full;
                byte* mid;
                int passes, pass, dd;
                switch (m.text == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch ((m.flags `& NF_TEMPLATE) != 0)
                        {
                            case (true) { ->; }
                            default
                            {
                                this.cur_obj = this.mod.own(obj_name);
                                switch (m.ts.base_type)
                                {
                                    case (DataType.THIS)
                                    {
                                        IRType** ps = (IRType**)fmalloc((u64)(node_count(m, 0) + 2) * (u64)((sizeof(IRType*) + 7) / 8));
                                        this.keep((void*)ps);
                                        int i;
                                        ps[0] = self_ty;
                                        while (i < node_count(m, 0))
                                        {
                                            ps[i + 1] = this.lower_sig(node_child(m, 0, i).ts, m.line);
                                            i++;
                                        };
                                        ft = this.mod.t_func(self_ty, ps, node_count(m, 0) + 1, false);
                                    }
                                    default
                                    {
                                        ft = this.func_type_of(m, 1, self_ty);
                                    };
                                };
                                mn = this.mangled_name(m.text, m);
                                full = join3(obj_name, g".\0", mn);
                                f = this.mod.find_function(full);
                                switch (f == (IRFunc*)0)
                                {
                                    case (true) {
                                    f = this.mod.add_function(ft, full);
                                    this.nfuncs++;
                                }
                                    default {};
                                };
                                // Python predeclares a namespaced object's method in the type only pass and
                                // again in visit_ObjectDef, and once more for each repeated definition
                                // (prototype and body), and every assignment of a taken name takes the next suffix
                                passes = 1;
                                dd = 0;
                                while (obj_name[dd] != (byte)0)
                                {
                                    switch (obj_name[dd] == (byte)'_' & obj_name[dd + 1] == (byte)'_')
                                    {
                                        case (true) { passes = 2; }
                                        default {};
                                    };
                                    dd++;
                                };
                                while (pass < passes)
                                {
                                    this.mod.rename_arg(f, 0, g"this\0");
                                    this.rename_args(f, m, 1);
                                    pass++;
                                };
                                switch (m.text2 != (byte*)0)
                                {
                                    case (true) { f.cconv = this.cc_name(m.text2); }
                                    default {};
                                };
                                ffree(mn);
                                ffree(full);
                                this.cur_obj = prev;
                                ->;
                            };
                        };
                    };
                };
            };

            // Index of the first '.' of a function name, -1 when it has none
            dot_index(byte* s) -> int
            {
                int i;
                switch (s == (byte*)0) { case (true) { -> -1; } default
                    {
                        while (s[i] != 0)
                        {
                            switch (s[i] == '.') { case (true) { -> i; } default
                                {
                                    i++;
                                }; };
                        };
                        -> -1;
                    }; };
            };

            // Object part of a dotted function name (Type.method) as a mangled object name
            dotted_object(Node* fd, byte* ns) -> byte*
            {
                int d = this.dot_index(fd.text);
                byte* raw = (byte*)fmalloc((u64)(d + 1));
                byte* r;
                int i;
                while (i < d) { raw[i] = fd.text[i]; i++; };
                raw[d] = 0;
                r = mangle_namespace_name(ns, raw);
                ffree(raw);
                -> r;
            };

            // A function named Type.method is a method of that object (an instantiated
            // template method): declared with the object pointer first
            declare_dotted(Node* fd, byte* ns) -> void
            {
                byte* full = fd.text;
                byte* oname = this.dotted_object(fd, ns);
                fd.text = full + this.dot_index(full) + 1;
                this.declare_method((Node*)0, fd, oname);
                fd.text = full;
                -> ffree(oname);
            };

            declare_object_methods(Node* od, byte* ns) -> void
            {
                byte* name = mangle_namespace_name(ns, od.text);
                int i;
                Node* m;
                switch (this.is_template(od))
                {
                    case (true) {
                    -> ffree(name);
                }
                    default
                    {
                        while (i < node_count(od, 1))
                        {
                            m = node_child(od, 1, i);
                            this.declare_method(od, m, name);
                            i++;
                        };
                        -> ffree(name);
                    };
                };
            };

            // ----------------------------------------------------------
            // Program walk
            // ----------------------------------------------------------

            unwrap(Node* n) -> Node*
            {
                int k = n.kind;
                switch (k == NodeKind.FUNCTION_DEF_STATEMENT | k == NodeKind.STRUCT_DEF_STATEMENT |
                    k == NodeKind.OBJECT_DEF_STATEMENT | k == NodeKind.ENUM_DEF_STATEMENT |
                    k == NodeKind.UNION_DEF_STATEMENT | k == NodeKind.NAMESPACE_DEF_STATEMENT)
                {
                    case (true) {
                    -> n.a;
                }
                    default
                    {
                        -> n;
                    };
                };
            };

            // Visit order of namespace members (visit_NamespaceDef): nested namespaces,
            // enums, structs, objects for types; nested, externs, objects, functions
            // for declarations
            slot_at(int j, bool types) -> int
            {
                switch (types)
                {
                    case (true) {
                    switch (j == 0)
                    {
                        case (true) { -> 7; }
                        default {};
                    };
                    switch (j == 1)
                    {
                        case (true) { -> 3; }
                        default {};
                    };
                    switch (j == 2)
                    {
                        case (true) { -> 1; }
                        default {};
                    };
                    -> 2;
                }
                    default
                    {
                        switch (j == 0)
                        {
                            case (true) { -> 7; }
                            default
                            {
                                switch (j == 1)
                                {
                                    case (true) { -> 5; }
                                    default
                                    {
                                        switch (j == 2)
                                        {
                                            case (true) { -> 2; }
                                            default
                                            {
                                                -> 0;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // Registers every type declared in n
            types_pass(Node* n0, byte* ns) -> void
            {
                Node* n = this.unwrap(n0);
                int k = n.kind;
                int s, c, e;
                byte* full;
                switch (this.retry_mode & k != NodeKind.STRUCT_DEF & k != NodeKind.OBJECT_DEF & k != NodeKind.NAMESPACE_DEF)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (k)
                        {
                            case (NodeKind.STRUCT_DEF) { this.reg_struct(n, ns); }
                            case (NodeKind.OBJECT_DEF)
                            {
                                this.reg_object_type(n, ns);
                                this.reg_object_nested(n, ns);
                            }
                            case (NodeKind.ENUM_DEF) { this.reg_enum(n, ns); }
                            case (NodeKind.UNION_DEF) { this.reg_union(n, ns); }
                            case (NodeKind.TYPE_DECLARATION) { this.reg_alias(n, ns); }
                            case (NodeKind.NAMESPACE_DEF)
                            {
                                full = this.join_ns(ns, n.text);
                                this.set_ns(full);
                                int j;
                                while (j < 4)
                                {
                                    s = this.slot_at(j, true);
                                    c = this.ns_count(n, s);
                                    e = 0;
                                    while (e < c)
                                    {
                                        this.types_pass(this.ns_child(n, s, e), full);
                                        e++;
                                    };
                                    j++;
                                };
                                this.set_ns(ns);
                                ffree(full);
                            }
                            default {};
                        };
                        ->;
                    };
                };
            };

            // Declares every function, method and extern in n
            // visit_TypeFuncDef: the synthetic FunctionDef __typefunc__<type>__<name>(_ receiver, params...).
            // Returns false for an unsized array receiver, whose generic function Python never emits
            tf_convert(Node* d) -> bool
            {
                PtrVec* tmp;
                Node* p0;
                int i;
                int n;
                switch (d.ts2 == (TypeSpec*)0 | d.text == (byte*)0 | d.text2 == (byte*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (ts_is_array(d.ts2) & d.ts2.array_size == (Node*)0)
                        {
                            case (true) {
                            // Kept for the size specialized variants that call sites create
                            nm_put(this.tf_ast, join3(join3(g"__typefunc__\0", d.text, g"__\0"), d.text2, g"\0"), (void*)d);
                            -> false;
                        }
                            default
                            {
                                tmp = pv_new();
                                p0 = node_new(NodeKind.PARAMETER, d.line, d.col);
                                p0.text = g"_\0";
                                p0.ts = d.ts2;
                                d.ts2 = (TypeSpec*)0;
                                n = node_count(d, 0);
                                while (i < n)
                                {
                                    pv_push(tmp, (void*)node_child(d, 0, i));
                                    i++;
                                };
                                switch (n > 0)
                                {
                                    case (true) { d.l0.len = 0; }
                                    default {};
                                };
                                node_push(d, 0, p0);
                                i = 0;
                                while (i < n)
                                {
                                    node_push(d, 0, (Node*)tmp.items[i]);
                                    i++;
                                };
                                pv_free(tmp);
                                d.text = this.mod.own(join3(join3(g"__typefunc__\0", d.text, g"__\0"), d.text2, g"\0"));
                                d.text2 = (byte*)0;
                                d.kind = NodeKind.FUNCTION_DEF;
                                -> true;
                            };
                        };
                    };
                };
            };

            decls_pass(Node* n0, byte* ns) -> void
            {
                Node* n = this.unwrap(n0);
                int k = n.kind;
                int s, c, e;
                byte* full;
                switch (k == NodeKind.TYPE_FUNC_DEF)
                {
                    case (true) {
                    switch (this.tf_convert(n)) { case (true) { k = n.kind; } default {}; };
                }
                    default {};
                };
                switch (k == NodeKind.EXPRESSION_STATEMENT)
                {
                    case (true) { -> this.global_assign(n); }
                    default
                    {
                        switch (k == NodeKind.FUNCTION_DEF)
                        {
                            case (true) {
                            switch (this.dot_index(n.text) > 0)
                            {
                                case (true) { this.declare_dotted(n, ns); }
                                default { this.declare_function(n, ns); };
                            };
                        }
                            default {
                                switch (k == NodeKind.VARIABLE_DECLARATION | k == NodeKind.FUNCTION_POINTER_DECLARATION)
                                {
                                    case (true) { this.declare_global(n, ns); }
                                    default {
                                        switch (k == NodeKind.OBJECT_DEF)
                                        {
                                            case (true) { this.declare_object_methods(n, ns); }
                                            default {
                                                switch (k == NodeKind.EXTERN_BLOCK)
                                                {
                                                    case (true) {
                            c = node_count(n, 0);
                            while (e < c)
                            {
                                pv_push(this.ext_fns, (void*)node_child(n, 0, e));
                                pv_push(this.ext_fns, (void*)this.unwrap(node_child(n, 0, e)));
                                this.declare_extern(node_child(n, 0, e), ns);
                                e++;
                            };
                        }
                                                    default {
                                                        switch (k == NodeKind.EXPORT_BLOCK)
                                                        {
                                                            case (true) {
                            c = node_count(n, 0);
                            while (e < c)
                            {
                                this.declare_function(node_child(n, 0, e), ns);
                                e++;
                            };
                        }
                                                            default {
                                                                switch (k == NodeKind.NAMESPACE_DEF)
                                                                {
                                                                    case (true) {
                            full = this.join_ns(ns, n.text);
                            this.set_ns(full);
                            int j;
                            while (j < 4)
                            {
                                switch (j == 1)
                                {
                                    case (true) {
                                    c = this.ns_count(n, 6);
                                    e = 0;
                                    while (e < c)
                                    {
                                        switch (this.ns_child(n, 6, e).kind == NodeKind.VARIABLE_DECLARATION)
                                        {
                                            case (true) {
                                            this.declare_global(this.ns_child(n, 6, e), full);
                                        }
                                            default {};
                                        };
                                        e++;
                                    };
                                }
                                    default {};
                                };
                                s = this.slot_at(j, false);
                                c = this.ns_count(n, s);
                                e = 0;
                                while (e < c)
                                {
                                    this.decls_pass(this.ns_child(n, s, e), full);
                                    e++;
                                };
                                j++;
                            };
                            this.set_ns(ns);
                            ffree(full);
                        }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        ->;
                    };
                };
            };

            // ----------------------------------------------------------
            // Function bodies (stage B)
            // ----------------------------------------------------------

            // Marks the current body as not generated. what names the construct.
            unsup(Node* n, byte* what) -> void
            {
                i64* box;
                switch (this.bad)
                {
                    case (true) { ->; }
                    default
                    {
                        this.bad = true;
                        this.bad_what = what;
                        switch (n != (Node*)0)
                        {
                            case (true) { this.bad_line = n.line; }
                            default {};
                        };
                        box = (i64*)nm_get(this.ucounts, what);
                        switch (box == (i64*)0)
                        {
                            case (true) {
                            box = (i64*)fmalloc((u64)8);
                            this.keep((void*)box);
                            *box = (i64)0;
                            nm_put(this.ucounts, what, (void*)box);
                        }
                            default {};
                        };
                        *box = *box + (i64)1;
                        ->;
                    };
                };
            };

            push_scope() -> void
            {
                -> pv_push(this.scopes, (void*)nm_new());
            };

            pop_scope() -> void
            {
                nm_free((NameMap*)this.scopes.items[this.scopes.len - 1]);
                this.scopes.len = this.scopes.len - 1;
                ->;
            };

            define_var(byte* name, IRValue* ptr, TypeSpec* ts) -> LVar*
            {
                LVar* v = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                v.ptr = ptr;
                v.ts = ts;
                v.vol = false;
                v.is_heap = false;
                this.keep((void*)v);
                nm_put((NameMap*)this.scopes.items[this.scopes.len - 1], name, (void*)v);
                -> v;
            };

            find_local(byte* name) -> LVar*
            {
                int i = this.scopes.len - 1;
                void* p;
                while (i >= 0)
                {
                    p = nm_get((NameMap*)this.scopes.items[i], name);
                    switch (p != (void*)0)
                    {
                        case (true) { -> (LVar*)p; }
                        default
                        {
                            i--;
                        };
                    };
                };
                -> (LVar*)0;
            };

            find_var(byte* name) -> LVar*
            {
                LVar* lv = this.find_local(name);
                switch (lv != (LVar*)0)
                {
                    case (true) { -> lv; }
                    default
                    {
                        -> this.find_global_var(name);
                    };
                };
            };

            // Global variable found through the using namespaces
            using_global_var(byte* name) -> LVar*
            {
                int i;
                byte* m;
                FXC_SYMENTRY* e;
                IRGlobal* gl;
                LVar* v;
                void* p;
                while (i < this.st.using_ns.len)
                {
                    m = mangle_namespace_name((byte*)this.st.using_ns.items[i], name);
                    gl = this.mod.find_global(m);
                    switch (gl != (IRGlobal*)0)
                    {
                        case (true) {
                        p = nm_get(this.gvars, m);
                        switch (p != (void*)0)
                        {
                            case (true) {
                            ffree(m);
                            -> (LVar*)p;
                        }
                            default {};
                        };
                        e = st_lookup_any(this.st, name, (byte*)this.st.using_ns.items[i]);
                        v = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                        v.ptr = gl.self;
                        v.ts = (TypeSpec*)0;
                        switch (e != (FXC_SYMENTRY*)0) { case (true) { v.ts = (TypeSpec*)e.ts; } default {}; };
                        v.vol = false;
                        v.is_heap = false;
                        this.keep((void*)v);
                        nm_put(this.gvars, m, (void*)v);
                        ffree(m);
                        -> v;
                    }
                        default
                        {
                            ffree(m);
                            i++;
                        };
                    };
                };
                -> (LVar*)0;
            };

            // Global variable visible as name (module.globals, then the namespace resolution)
            find_global_var(byte* name) -> LVar*
            {
                FXC_SYMENTRY* e = st_lookup_any(this.st, name, this.cur_ns);
                byte* m;
                IRGlobal* gl;
                LVar* v;
                void* p;
                switch (e == (FXC_SYMENTRY*)0)
                {
                    case (true) { -> (LVar*)nm_get(this.gvars, name); }
                    default
                    {
                        switch (e.kind_id != SymbolKind.VARIABLE)
                        {
                            case (true) { -> (LVar*)nm_get(this.gvars, name); }
                            default
                            {
                                m = sym_mangled(e);
                                gl = this.mod.find_global(m);
                                switch (gl == (IRGlobal*)0)
                                {
                                    case (true) {
                                    // The duplicate check skipped this declaration, so the symbol table resolves
                                    // the name through the using namespaces to the global that was kept
                                    ffree(m);
                                    -> this.using_global_var(name);
                                }
                                    default
                                    {
                                        p = nm_get(this.gvars, m);
                                        switch (p != (void*)0)
                                        {
                                            case (true) {
                                            ffree(m);
                                            -> (LVar*)p;
                                        }
                                            default
                                            {
                                                v = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                                                v.ptr = gl.self;
                                                v.ts = (TypeSpec*)e.ts;
                                                v.vol = false;
                                                v.is_heap = false;
                                                this.keep((void*)v);
                                                nm_put(this.gvars, m, (void*)v);
                                                ffree(m);
                                                -> v;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // Counts a construct that stopped something other than a body
            note_unsup(byte* what) -> void
            {
                i64* box = (i64*)nm_get(this.ucounts, what);
                switch (box == (i64*)0)
                {
                    case (true) {
                    box = (i64*)fmalloc((u64)8);
                    this.keep((void*)box);
                    *box = (i64)0;
                    nm_put(this.ucounts, what, (void*)box);
                }
                    default {};
                };
                *box = *box + (i64)1;
                ->;
            };

            // Last "__" separated segment of name
            last_seg(byte* name) -> byte*
            {
                int i;
                int cut;
                while (name[i] != 0)
                {
                    switch (name[i] == '_' & name[i + 1] == '_')
                    {
                        case (true) { cut = i + 2; }
                        default {};
                    };
                    i++;
                };
                -> name + cut;
            };

            // _vardecl_global duplicate check: same name, or same last segment
            global_dup(byte* name) -> bool
            {
                int i;
                byte* seg = this.last_seg(name);
                IRGlobal* g;
                IRFunc* fn;
                while (i < this.mod.globals.len)
                {
                    g = (IRGlobal*)this.mod.globals.items[i];
                    switch (cstr_eq(g.name, name))
                    {
                        case (true) { -> true; }
                        default
                        {
                            switch (cstr_eq(this.last_seg(g.name), seg))
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                    };
                };
                i = 0;
                while (i < this.mod.funcs.len)
                {
                    fn = (IRFunc*)this.mod.funcs.items[i];
                    switch (cstr_eq(fn.name, name))
                    {
                        case (true) { -> true; }
                        default
                        {
                            switch (cstr_eq(this.last_seg(fn.name), seg))
                            {
                                case (true) { -> true; }
                                default
                                {
                                    i++;
                                };
                            };
                        };
                    };
                };
                -> false;
            };

            // Initializer text of a global (create_global_initializer for literals),
            // null when the initializer is not handled yet
            // ----------------------------------------------------------
            // dict{K:V}
            // ----------------------------------------------------------

            is_dict_struct(IRType* t) -> bool
            {
                switch (t.kind != LK.STRUCT)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (t.nitems != 3)
                        {
                            case (true) { -> false; }
                            default
                            {
                                -> t.items[0].kind == LK.ARRAY & t.items[1].kind == LK.ARRAY & t.items[2].kind == LK.INT & t.items[2].width == 32;
                            };
                        };
                    };
                };
            };

            dict_struct(IRType* kl, IRType* vl, int cap) -> IRType*
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                ps[0] = this.mod.t_array(kl, cap);
                ps[1] = this.mod.t_array(vl, cap);
                ps[2] = this.t_i32;
                -> this.mod.t_struct(ps, 3);
            };

            // Registers the key/value/capacity layout of a dict variable (module._dict_types[name])
            dict_make(byte* name, TypeSpec* ts, int line) -> DictInfo*
            {
                DictInfo* di = (DictInfo*)fmalloc((u64)((sizeof(DictInfo) + 7) / 8));
                this.keep((void*)di);
                di.kts = ts.dict_key;
                di.vts = ts.dict_value;
                di.kl = this.t_i8;
                di.vl = this.t_i8;
                switch (ts.dict_key != (TypeSpec*)0)
                {
                    case (true) { di.kl = this.lower(ts.dict_key, false, line); }
                    default {};
                };
                switch (ts.dict_value != (TypeSpec*)0)
                {
                    case (true) { di.vl = this.lower(ts.dict_value, false, line); }
                    default {};
                };
                di.cap = 0;
                switch (ts.dict_capacity > 0)
                {
                    case (true) { di.cap = ts.dict_capacity; }
                    default {};
                };
                di.st = this.dict_struct(di.kl, di.vl, di.cap);
                di.kc = (byte**)0;
                di.vc = (byte**)0;
                nm_put(this.dicts, name, (void*)di);
                -> di;
            };

            // create_global_string_initializer for a byte* target: the bytes plus a NUL live in
            // .str.gsi.<first 8 hex digits of their md5>; returns a gep to it
            gsi_ref(byte* src, int len, Buf* ob, bool with_ty) -> void
            {
                int n = len + 1;
                byte* buf = (byte*)this.zbuf(n / 8 + 1);
                byte[16] hx;
                Buf gn;
                IRType* aty;
                IRValue* cv;
                IRGlobal* gl;
                memcpy((void*)buf, (void*)src, (u64)len);
                buf[len] = (byte)0;
                md5_hex8(buf, n, @hx[0]);
                gn.__init();
                defer gn.__exit();
                gn.put_str(g".str.gsi.\0");
                gn.put_str(@hx[0]);
                aty = this.mod.t_array(this.t_i8, n);
                gl = this.mod.find_global(gn.mem);
                switch (gl == (IRGlobal*)0)
                {
                    case (true) {
                    cv = this.mod.c_bytes(aty, buf, n);
                    gl = this.mod.add_global(aty, gn.mem, cv.text);
                    gl.linkage = this.mod.own(g"internal\0");
                    gl.constant = true;
                    this.mark_arr_ptr(gl.self.ty);
                }
                    default {};
                };
                switch (with_ty)
                {
                    case (true) { ob.put_str(g"i8* \0"); }
                    default {};
                };
                ob.put_str(g"getelementptr (\0");
                lt_text(ob, aty);
                ob.put_str(g", \0");
                lt_text(ob, aty);
                ob.put_str(f"* {gl.self.text}, i32 0, i32 0)\0");
            };

            str_len_of(Node* e) -> int
            {
                int len = (int)e.ival;
                byte* src = e.text;
                switch (src == (byte*)0)
                {
                    case (true) { -> 0; }
                    default
                    {
                        switch (len <= 0)
                        {
                            case (true) {
                            len = 0;
                            while (src[len] != 0) { len++; };
                        }
                            default {};
                        };
                        -> len;
                    };
                };
            };

            // create_global_initializer for one dict slot: "<ty> <value>", null when not constant
            dict_elem_text(Node* e, IRType* et) -> byte*
            {
                Buf b;
                byte* src;
                int dt;
                i64 v;
                i64 lim;
                b.__init();
                defer b.__exit();
                switch (e.kind == NodeKind.STRING_LITERAL)
                {
                    case (true) {
                    switch (et.kind != LK.PTR)
                    {
                        case (true) { -> (byte*)0; }
                        default {};
                    };
                    switch (et.elem.kind != LK.INT)
                    {
                        case (true) { -> (byte*)0; }
                        default {};
                    };
                    switch (et.elem.width != 8)
                    {
                        case (true) { -> (byte*)0; }
                        default {};
                    };
                    src = e.text;
                    switch (src == (byte*)0) { case (true) { src = g"\0"; } default {}; };
                    this.gsi_ref(src, this.str_len_of(e), @b, true);
                    -> this.mod.own(b.mem);
                }
                    default
                    {
                        switch (e.kind == NodeKind.LITERAL & et.kind == LK.INT)
                        {
                            case (true) {
                            dt = e.op;
                            v = e.ival;
                            switch (dt == DataType.BOOL)
                            {
                                case (true) {
                                switch (v != (i64)0) { case (true) { v = (i64)1; } default {}; };
                            }
                                default {
                                switch (dt == DataType.UINT | dt == DataType.ULONG | dt == DataType.DATA)
                                {
                                    case (true) {
                                    // converted to signed two's complement
                                    switch (et.width < 64)
                                    {
                                        case (true) {
                                        lim = ((i64)1 << (et.width - 1)) - (i64)1;
                                        switch (v > lim) { case (true) { v = v - ((i64)1 << et.width); } default {}; };
                                    }
                                        default {};
                                    };
                                }
                                    default {
                                    switch (dt != DataType.SINT) { case (true) { -> (byte*)0; } default {}; };
                                };
                                };
                            };
                            };
                            lt_text(@b, et);
                            b.put(32);
                            put_i64(@b, v);
                            -> this.mod.own(b.mem);
                        }
                            default
                            {
                                -> (byte*)0;
                            };
                        };
                    };
                };
            };

            dict_zero_text(IRType* et) -> byte*
            {
                Buf b;
                b.__init();
                defer b.__exit();
                switch (et.kind == LK.PTR)
                {
                    case (true) {
                    lt_text(@b, et);
                    b.put_str(g" null\0");
                    -> this.mod.own(b.mem);
                }
                    default
                    {
                        switch (et.kind == LK.INT)
                        {
                            case (true) {
                            lt_text(@b, et);
                            b.put_str(g" 0\0");
                            -> this.mod.own(b.mem);
                        }
                            default
                            {
                                -> (byte*)0;
                            };
                        };
                    };
                };
            };

            // "{[N x K] [...], [N x V] [...], i32 count}" from the slot texts of di
            dict_text(DictInfo* di, int count) -> byte*
            {
                Buf b;
                int i;
                b.__init();
                defer b.__exit();
                b.put(123);
                lt_text(@b, di.st.items[0]);
                b.put_str(g" [\0");
                while (i < di.cap)
                {
                    switch (i > 0) { case (true) { b.put_str(g", \0"); } default {}; };
                    b.put_str(di.kc[i]);
                    i++;
                };
                b.put_str(g"], \0");
                lt_text(@b, di.st.items[1]);
                b.put_str(g" [\0");
                i = 0;
                while (i < di.cap)
                {
                    switch (i > 0) { case (true) { b.put_str(g", \0"); } default {}; };
                    b.put_str(di.vc[i]);
                    i++;
                };
                b.put_str(f"], i32 {count}\0");
                b.put(125);
                -> this.mod.own(b.mem);
            };

            // VariableTypeHandler._dict_literal_to_constant
            dict_lit_text(Node* ini, DictInfo* di) -> byte*
            {
                int np = node_count(ini, 0) / 2;
                int i;
                byte* t;
                switch (np > di.cap)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        di.kc = (byte**)this.zbuf(di.cap + 1);
                        di.vc = (byte**)this.zbuf(di.cap + 1);
                        while (i < di.cap)
                        {
                            switch (i < np)
                            {
                                case (true) {
                                t = this.dict_elem_text(node_child(ini, 0, i * 2), di.kl);
                                switch (t == (byte*)0) { case (true) { -> (byte*)0; } default
                                    {
                                        di.kc[i] = t;
                                        t = this.dict_elem_text(node_child(ini, 0, i * 2 + 1), di.vl);
                                        switch (t == (byte*)0) { case (true) { -> (byte*)0; } default
                                            {
                                                di.vc[i] = t;
                                            }; };
                                    }; };
                            }
                                default {
                                t = this.dict_zero_text(di.kl);
                                switch (t == (byte*)0) { case (true) { -> (byte*)0; } default
                                    {
                                        di.kc[i] = t;
                                        t = this.dict_zero_text(di.vl);
                                        switch (t == (byte*)0) { case (true) { -> (byte*)0; } default
                                            {
                                                di.vc[i] = t;
                                            }; };
                                    }; };
                            };
                            };
                            i++;
                        };
                        -> this.dict_text(di, np);
                    };
                };
            };

            // create_global_initializer, dict merge: BinaryOp(+) on two global dicts
            dict_merge_text(Node* ini, DictInfo* di) -> byte*
            {
                DictInfo* li;
                DictInfo* ri;
                int nc;
                int i;
                switch (ini.op != Operator.ADD)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (ini.a.kind != NodeKind.IDENTIFIER | ini.b.kind != NodeKind.IDENTIFIER)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                li = (DictInfo*)nm_get(this.dicts, ini.a.text);
                                ri = (DictInfo*)nm_get(this.dicts, ini.b.text);
                                switch (li == (DictInfo*)0 | ri == (DictInfo*)0)
                                {
                                    case (true) { -> (byte*)0; }
                                    default
                                    {
                                        switch (li.kc == (byte**)0 | ri.kc == (byte**)0)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                nc = li.cap + ri.cap;
                                                di.cap = nc;
                                                di.st = this.dict_struct(li.kl, li.vl, nc);
                                                di.kc = (byte**)this.zbuf(nc + 1);
                                                di.vc = (byte**)this.zbuf(nc + 1);
                                                while (i < li.cap)
                                                {
                                                    di.kc[i] = li.kc[i];
                                                    di.vc[i] = li.vc[i];
                                                    i++;
                                                };
                                                i = 0;
                                                while (i < ri.cap)
                                                {
                                                    di.kc[li.cap + i] = ri.kc[i];
                                                    di.vc[li.cap + i] = ri.vc[i];
                                                    i++;
                                                };
                                                -> this.dict_text(di, nc);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // dict{K:V} at global scope (_vardecl_dict -> _vardecl_global)
            declare_global_dict(Node* n, byte* ns) -> void
            {
                TypeSpec* ts = n.ts;
                Node* ini = n.a;
                DictInfo* di = this.dict_make(n.text, ts, n.line);
                IRGlobal* gl;
                byte* m;
                byte* it;
                switch (ini == (Node*)0)
                {
                    case (true) { it = this.mod.c_null(di.st).text; }
                    default {
                    switch (ini.kind == NodeKind.DICT_LITERAL)
                    {
                        case (true) { it = this.dict_lit_text(ini, di); }
                        default {
                        switch (ini.kind == NodeKind.BINARY_OP)
                        {
                            case (true) { it = this.dict_merge_text(ini, di); }
                            default { it = (byte*)0; };
                        };
                    };
                    };
                };
                };
                switch (it == (byte*)0)
                {
                    case (true) {
                    -> this.note_unsup(g"global dict initializer\0");
                }
                    default
                    {
                        m = mangle_namespace_name(ns, n.text);
                        switch (this.global_dup(m))
                        {
                            case (true) {
                            -> ffree(m);
                        }
                            default
                            {
                                gl = this.mod.add_global(di.st, m, it);
                                gl.linkage = this.mod.own(g"internal\0");
                                gl.self.spec = ts;
                                switch (nm_get(this.gvars, m) == (void*)0)
                                {
                                    case (true) {
                                    LVar* gv = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                                    gv.ptr = gl.self;
                                    gv.ts = ts;
                                    gv.vol = false;
                                    gv.is_heap = false;
                                    this.keep((void*)gv);
                                    nm_put(this.gvars, m, (void*)gv);
                                }
                                    default {};
                                };
                                ffree(m);
                            };
                        };
                    };
                };
            };

            // VariableTypeHandler._eval_const_expr for integers: value and bit width
            const_eval(Node* e, i64* ov, int* ow) -> bool
            {
                i64 lv;
                i64 rv;
                int lw;
                int rw;
                int k = e.kind;
                int op;
                IRGlobal* gg;
                SInfo* si;
                int fi;
                switch (k == NodeKind.LITERAL)
                {
                    case (true) {
                    switch (e.op == DataType.SINT)
                    {
                        case (true) { *ov = e.ival; *ow = 32; -> true; }
                        default {};
                    };
                    switch (e.op == DataType.BOOL)
                    {
                        case (true) {
                        *ov = (i64)0;
                        switch (e.ival != (i64)0) { case (true) { *ov = (i64)1; } default {}; };
                        *ow = 1;
                        -> true;
                    }
                        default {};
                    };
                    -> false;
                }
                    default
                    {
                        switch (k == NodeKind.MEMBER_ACCESS)
                        {
                            case (true) {
                            switch (e.a.kind != NodeKind.IDENTIFIER)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            gg = this.global_ident_find(e.a.text);
                            switch (gg == (IRGlobal*)0)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            switch (gg.init == (byte*)0)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            si = this.sinfo_of(gg.ty);
                            switch (si == (SInfo*)0)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            fi = this.sidx(si, e.text);
                            switch (fi < 0)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            // only a zeroinitializer global has a constant member here
                            switch (!cstr_eq(gg.init, this.mod.c_null(gg.ty).text))
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            switch (si.ftys[fi].kind != LK.INT)
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            *ov = (i64)0;
                            *ow = si.ftys[fi].width;
                            -> true;
                        }
                            default
                            {
                                switch (k == NodeKind.UNARY_OP)
                                {
                                    case (true) {
                                    switch (!this.const_eval(e.a, @lv, @lw))
                                    {
                                        case (true) { -> false; }
                                        default {};
                                    };
                                    switch (e.op == Operator.NOT)
                                    {
                                        case (true) { *ov = `!lv; *ow = lw; -> true; }
                                        default {};
                                    };
                                    switch (e.op == Operator.SUB)
                                    {
                                        case (true) { *ov = (i64)0 - lv; *ow = lw; -> true; }
                                        default {};
                                    };
                                    -> false;
                                }
                                    default
                                    {
                                        switch (k == NodeKind.BINARY_OP)
                                        {
                                            case (true) {
                                            op = e.op;
                                            switch (!this.const_eval(e.a, @lv, @lw))
                                            {
                                                case (true) { -> false; }
                                                default {};
                                            };
                                            switch (!this.const_eval(e.b, @rv, @rw))
                                            {
                                                case (true) { -> false; }
                                                default {};
                                            };
                                            *ow = lw;
                                            switch (op == Operator.ADD) { case (true) { *ov = lv + rv; -> true; } default {}; };
                                            switch (op == Operator.SUB) { case (true) { *ov = lv - rv; -> true; } default {}; };
                                            switch (op == Operator.MUL) { case (true) { *ov = lv * rv; -> true; } default {}; };
                                            switch (op == Operator.AND | op == Operator.BITAND) { case (true) { *ov = lv `& rv; -> true; } default {}; };
                                            switch (op == Operator.OR | op == Operator.BITOR) { case (true) { *ov = lv `| rv; -> true; } default {}; };
                                            switch (op == Operator.XOR | op == Operator.BITXOR) { case (true) { *ov = lv `^| rv; -> true; } default {}; };
                                            switch (op == Operator.BITSHIFT_LEFT) { case (true) { *ov = lv << (int)rv; -> true; } default {}; };
                                            switch (op == Operator.BITSHIFT_RIGHT) { case (true) { *ov = lv >> (int)rv; -> true; } default {}; };
                                            -> false;
                                        }
                                            default
                                            {
                                                -> false;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            dict_mask(int w) -> i64
            {
                switch (w >= 64)
                {
                    case (true) { -> (i64)0 - (i64)1; }
                    default
                    {
                        -> ((i64)1 << w) - (i64)1;
                    };
                };
            };

            // _eval_array_access_const for d{k:v, ...}[key]: the text of the matching value
            global_dict_index(Node* ini, IRType* lt) -> byte*
            {
                Node* dn = ini.a;
                int cnt = node_count(dn, 0);
                int i;
                i64 lv;
                i64 kv;
                int lw;
                int kw;
                i64 mm;
                Node* ve;
                Buf b;
                b.__init();
                defer b.__exit();
                switch (!this.const_eval(ini.b, @lv, @lw))
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        while (i < cnt)
                        {
                            switch (!this.const_eval(node_child(dn, 0, i), @kv, @kw))
                            {
                                case (true) { -> (byte*)0; }
                                default
                                {
                                    mm = this.dict_mask(kw);
                                    switch (lw < kw) { case (true) { mm = this.dict_mask(lw); } default {}; };
                                    switch ((kv `& mm) == (lv `& mm))
                                    {
                                        case (true) {
                                        ve = node_child(dn, 1, i);
                                        switch (ve.kind == NodeKind.STRING_LITERAL)
                                        {
                                            case (true) {
                                            switch (lt.kind != LK.PTR) { case (true) { -> (byte*)0; } default {}; };
                                            switch (ve.text == (byte*)0) { case (true) { -> (byte*)0; } default {}; };
                                            this.gsi_ref(ve.text, this.str_len_of(ve), @b, false);
                                            -> this.mod.own(b.mem);
                                        }
                                            default {};
                                        };
                                        switch (lt.kind != LK.INT) { case (true) { -> (byte*)0; } default {}; };
                                        switch (!this.const_eval(ve, @kv, @kw)) { case (true) { -> (byte*)0; } default {}; };
                                        put_i64(@b, kv);
                                        -> this.mod.own(b.mem);
                                    }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                            };
                        };
                        -> (byte*)0;
                    };
                };
            };

            global_init(Node* n, IRType* lt) -> byte*
            {
                Node* ini = n.a;
                int dt;
                i64 v;
                i64 mask;
                int w;
                byte* r;
                bool neg = false;
                switch (ini == (Node*)0)
                {
                    case (true) { -> this.mod.c_null(lt).text; }
                    default
                    {
                                       switch (ini.kind == NodeKind.NO_INIT)
                                       {
                                           case (true) { -> g"undef\0"; }
                                           default
                                           {
                                                              switch (ini.kind == NodeKind.ARRAY_ACCESS)
                                                              {
                                                                  case (true) {
                                                                  switch (ini.a.kind == NodeKind.DICT_LITERAL_EXPR)
                                                                  {
                                                                      case (true) { -> this.global_dict_index(ini, lt); }
                                                                      default {};
                                                                  };
                                                              }
                                                                  default {};
                                                              };
                                                              switch (ini.kind == NodeKind.IDENTIFIER)
                                                              {
                                                                  case (true) {
                                                                  r = this.global_ident_init(ini.text);
                                                                  switch (r == (byte*)0)
                                                                  {
                                                                      case (true) { -> this.mod.c_null(lt).text; }
                                                                      default {};
                                                                  };
                                                                  -> r;
                                                              }
                                                                  default
                                                                  {
                                                                                     switch (ini.kind == NodeKind.STRING_LITERAL)
                                                                                     {
                                                                                         case (true) { -> this.global_string_init(ini, lt); }
                                                                                         default
                                                                                         {
                                                                                                            switch (ini.kind == NodeKind.ARRAY_LITERAL & lt.kind == LK.INT)
                                                                                                            {
                                                                                                                case (true) { -> this.global_pack_int(ini, lt); }
                                                                                                                default
                                                                                                                {
                                                                                                                                   switch (ini.kind == NodeKind.ARRAY_LITERAL)
                                                                                                                                   {
                                                                                                                                       case (true) { -> this.global_array_init(ini, lt); }
                                                                                                                                       default
                                                                                                                                       {
                                                                                                                                                          switch (ini.kind == NodeKind.CAST_EXPRESSION | ini.kind == NodeKind.FUNCTION_CALL | ini.kind == NodeKind.METHOD_CALL)
                                                                                                                                                          {
                                                                                                                                                              case (true) {
                                                                                                                                                              // The base has no constant for these and falls back to the default initializer
                                                                                                                                                              -> this.mod.c_null(lt).text;
                                                                                                                                                          }
                                                                                                                                                              default {};
                                                                                                                                                          };
                                                                                                                                                          // create_global_initializer answers None for any other kind, and the caller
                                                                                                                                                          // then takes the type's default initializer
                                                                                                                                                          switch (ini.kind != NodeKind.LITERAL & ini.kind != NodeKind.IDENTIFIER & ini.kind != NodeKind.BINARY_OP &
                                                                                                                                                              ini.kind != NodeKind.UNARY_OP & ini.kind != NodeKind.STRING_LITERAL & ini.kind != NodeKind.ARRAY_LITERAL &
                                                                                                                                                              ini.kind != NodeKind.ARRAY_ACCESS & ini.kind != NodeKind.STRUCT_LITERAL & ini.kind != NodeKind.DICT_LITERAL &
                                                                                                                                                              ini.kind != NodeKind.DICT_LITERAL_EXPR)
                                                                                                                                                          {
                                                                                                                                                              case (true) { -> this.mod.c_null(lt).text; }
                                                                                                                                                              default
                                                                                                                                                              {
                                                                                                                                                                                 switch (ini.kind == NodeKind.CAST_EXPRESSION & lt.kind == LK.PTR)
                                                                                                                                                                                 {
                                                                                                                                                                                     case (true) {
                                                                                                                                                                                     switch (ini.a != (Node*)0)
                                                                                                                                                                                     {
                                                                                                                                                                                         case (true) {
                                                                                                                                                                                         switch (ini.a.kind == NodeKind.ADDRESS_OF & ini.a.a != (Node*)0)
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) {
                                                                                                                                                                                             switch (ini.a.a.kind == NodeKind.LITERAL & ini.a.a.op == DataType.VOID)
                                                                                                                                                                                             {
                                                                                                                                                                                                 case (true) { -> g"null\0"; }
                                                                                                                                                                                                 default {};
                                                                                                                                                                                             };
                                                                                                                                                                                         }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         };
                                                                                                                                                                                         switch (ini.a.kind == NodeKind.IDENTIFIER & ini.a.text != (byte*)0)
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) {
                                                                                                                                                                                             FXC_SYMENTRY* se = st_lookup_any(this.st, ini.a.text, this.cur_ns);
                                                                                                                                                                                             switch (se != (FXC_SYMENTRY*)0)
                                                                                                                                                                                             {
                                                                                                                                                                                                 case (true) {
                                                                                                                                                                                                 byte* sm = sym_mangled(se);
                                                                                                                                                                                                 IRGlobal* sg = this.mod.find_global(sm);
                                                                                                                                                                                                 ffree(sm);
                                                                                                                                                                                                 switch (sg != (IRGlobal*)0)
                                                                                                                                                                                                 {
                                                                                                                                                                                                     case (true) {
                                                                                                                                                                                                     switch (sg.init != (byte*)0)
                                                                                                                                                                                                     {
                                                                                                                                                                                                         case (true) {
                                                                                                                                                                                                         switch (cstr_eq(sg.init, g"null\0"))
                                                                                                                                                                                                         {
                                                                                                                                                                                                             case (true) { -> g"null\0"; }
                                                                                                                                                                                                             default {};
                                                                                                                                                                                                         };
                                                                                                                                                                                                     }
                                                                                                                                                                                                         default {};
                                                                                                                                                                                                     };
                                                                                                                                                                                                 }
                                                                                                                                                                                                     default {};
                                                                                                                                                                                                 };
                                                                                                                                                                                             }
                                                                                                                                                                                                 default {};
                                                                                                                                                                                             };
                                                                                                                                                                                         }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         };
                                                                                                                                                                                         switch (ini.a.kind == NodeKind.LITERAL & ini.a.ival == (i64)0 & (ini.a.op == DataType.SINT | ini.a.op == DataType.UINT | ini.a.op == DataType.ULONG | ini.a.op == DataType.SLONG))
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) {
                                                                                                                                                                                             -> g"null\0";
                                                                                                                                                                                         }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         };
                                                                                                                                                                                     }
                                                                                                                                                                                         default {};
                                                                                                                                                                                     };
                                                                                                                                                                                 }
                                                                                                                                                                                     default {};
                                                                                                                                                                                 };
                                                                                                                                                                                 switch (ini.kind == NodeKind.UNARY_OP)
                                                                                                                                                                                 {
                                                                                                                                                                                     case (true) {
                                                                                                                                                                                     switch (ini.op == Operator.SUB & ini.a != (Node*)0)
                                                                                                                                                                                     {
                                                                                                                                                                                         case (true) {
                                                                                                                                                                                         switch (ini.a.kind == NodeKind.LITERAL)
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) {
                                                                                                                                                                                             neg = true;
                                                                                                                                                                                             ini = ini.a;
                                                                                                                                                                                         }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         };
                                                                                                                                                                                     }
                                                                                                                                                                                         default {};
                                                                                                                                                                                     };
                                                                                                                                                                                 }
                                                                                                                                                                                     default {};
                                                                                                                                                                                 };
                                                                                                                                                                                 switch (ini.kind != NodeKind.LITERAL)
                                                                                                                                                                                 {
                                                                                                                                                                                     case (true) { -> (byte*)0; }
                                                                                                                                                                                     default
                                                                                                                                                                                     {
                                                                                                                                                                                                        dt = ini.op;
                                                                                                                                                                                                        v = ini.ival;
                                                                                                                                                                                                        switch (neg)
                                                                                                                                                                                                        {
                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                            switch (dt != DataType.SINT & dt != DataType.FLOAT & dt != DataType.DOUBLE)
                                                                                                                                                                                                            {
                                                                                                                                                                                                                case (true) { -> (byte*)0; }
                                                                                                                                                                                                                default
                                                                                                                                                                                                                {
                                                                                                                                                                                                                    v = (i64)0 - v;
                                                                                                                                                                                                                };
                                                                                                                                                                                                            };
                                                                                                                                                                                                        }
                                                                                                                                                                                                            default {};
                                                                                                                                                                                                        };
                                                                                                                                                                                                        switch (dt == DataType.FLOAT | dt == DataType.DOUBLE)
                                                                                                                                                                                                        {
                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                            switch (lt.kind == LK.FLOAT | lt.kind == LK.DOUBLE)
                                                                                                                                                                                                            {
                                                                                                                                                                                                                case (true) { switch (neg)
                                                                                                                                                                                         {
                                                                                                                                                                                             case (true) { -> this.mod.c_fp(lt, (double)0.0 - ini.fval).text; }
                                                                                                                                                                                             default {};
                                                                                                                                                                                         }; -> this.mod.c_fp(lt, ini.fval).text; }
                                                                                                                                                                                                                default {};
                                                                                                                                                                                                            };
                                                                                                                                                                                                            -> (byte*)0;
                                                                                                                                                                                                        }
                                                                                                                                                                                                            default
                                                                                                                                                                                                            {
                                                                                                                                                                                                                switch (lt.kind == LK.PTR)
                                                                                                                                                                                                                {
                                                                                                                                                                                                                    case (true) {
                                                                                                                                                                                                                    switch (dt == DataType.SINT & v == (i64)0)
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        case (true) { -> g"null\0"; }
                                                                                                                                                                                                                        default {};
                                                                                                                                                                                                                    };
                                                                                                                                                                                                                    -> (byte*)0;
                                                                                                                                                                                                                }
                                                                                                                                                                                                                    default
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        switch (lt.kind != LK.INT)
                                                                                                                                                                                                                        {
                                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                                            switch (dt == DataType.SINT | dt == DataType.BOOL | dt == DataType.UINT | dt == DataType.ULONG)
                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                case (true) { -> (byte*)0; }
                                                                                                                                                                                                                                default {};
                                                                                                                                                                                                                            };
                                                                                                                                                                                                                            -> this.mod.c_null(lt).text;
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                            default
                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                w = lt.width;
                                                                                                                                                                                                                                switch (dt == DataType.SINT | dt == DataType.BOOL)
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                    case (true) { -> this.mod.c_int(this.t_i64, v).text; }
                                                                                                                                                                                                                                    default
                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                        switch (dt == DataType.UINT | dt == DataType.ULONG | dt == DataType.DATA)
                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                            case (true) {
                                                                                                                                                                                                                                            switch (w < 64)
                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                case (true) {
                                                                                                                                                                                                                                                mask = ((i64)1 << (i64)w) - (i64)1;
                                                                                                                                                                                                                                                v = v `& mask;
                                                                                                                                                                                                                                                switch (v > (((i64)1 << (i64)(w - 1)) - (i64)1))
                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                    case (true) { v = v - ((i64)1 << (i64)w); }
                                                                                                                                                                                                                                                    default {};
                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                default {};
                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                            -> this.mod.c_int(this.t_i64, v).text;
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                            default
                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                -> this.mod.c_null(lt).text;
                                                                                                                                                                                                                                            };
                                                                                                                                                                                                                                        };
                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                };
                                                                                                                                                                                                                            };
                                                                                                                                                                                                                        };
                                                                                                                                                                                                                    };
                                                                                                                                                                                                                };
                                                                                                                                                                                                            };
                                                                                                                                                                                                        };
                                                                                                                                                                                     };
                                                                                                                                                                                 };
                                                                                                                                                              };
                                                                                                                                                          };
                                                                                                                                       };
                                                                                                                                   };
                                                                                                                };
                                                                                                            };
                                                                                         };
                                                                                     };
                                                                  };
                                                              };
                                           };
                                       };
                    };
                };
            };

            // Initializer text of the global an identifier names, or null when it has none
            global_ident_find(byte* name) -> IRGlobal*
            {
                FXC_SYMENTRY* se = st_lookup_any(this.st, name, this.cur_ns);
                IRGlobal* sg;
                byte* sm;
                switch (se != (FXC_SYMENTRY*)0)
                {
                    case (true) {
                    sm = sym_mangled(se);
                    sg = this.mod.find_global(sm);
                    ffree(sm);
                    switch (sg != (IRGlobal*)0)
                    {
                        case (true) { -> sg; }
                        default {};
                    };
                }
                    default {};
                };
                -> this.mod.find_global(name);
            };

            global_ident_init(byte* name) -> byte*
            {
                IRGlobal* sg = this.global_ident_find(name);
                switch (sg != (IRGlobal*)0)
                {
                    case (true) { -> sg.init; }
                    default
                    {
                        -> (byte*)0;
                    };
                };
            };

            // VariableTypeHandler._pack_array_literal_to_int_constant: first element at the high bits
            global_pack_int(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i = n - 1;
                int off;
                int w;
                int dt;
                i64 v;
                i64 packed;
                Node* e;
                IRGlobal* g;
                Buf ab;
                byte* r;
                while (i >= 0)
                {
                    e = node_child(ini, 0, i);
                    switch (e.kind == NodeKind.LITERAL)
                    {
                        case (true) {
                        dt = e.op;
                        v = e.ival;
                        w = 0;
                        switch (dt == DataType.SINT | dt == DataType.UINT) { case (true) { w = 32; } default {}; };
                        switch (dt == DataType.SLONG | dt == DataType.ULONG) { case (true) { w = 64; } default {}; };
                        switch (dt == DataType.BOOL)
                        {
                            case (true) {
                            w = 1;
                            switch (v != (i64)0) { case (true) { v = (i64)1; } default {}; };
                        }
                            default {};
                        };
                        switch (dt == DataType.CHAR) { case (true) { w = 8; } default {}; };
                        switch (w == 0) { case (true) { -> (byte*)0; } default {}; };
                    }
                        default {
                            switch (e.kind != NodeKind.IDENTIFIER)
                            {
                                case (true) { -> (byte*)0; }
                                default
                                {
                                    g = this.global_ident_find(e.text);
                                    switch (g == (IRGlobal*)0)
                                    {
                                        case (true) { -> (byte*)0; }
                                        default
                                        {
                                            switch (g.init == (byte*)0 | g.ty.kind != LK.INT)
                                            {
                                                case (true) { -> (byte*)0; }
                                                default
                                                {
                                                    switch (!this.parse_int_text(g.init, @v))
                                                    {
                                                        case (true) { -> (byte*)0; }
                                                        default
                                                        {
                                                            w = g.ty.width;
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    switch (v < (i64)0 | off + w > 63)
                    {
                        case (true) { -> (byte*)0; }
                        default
                        {
                            packed = packed `| (v << (i64)off);
                            off = off + w;
                            i--;
                        };
                    };
                };
                switch (off != lt.width)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        ab.__init();
                        defer ab.__exit();
                        put_i64(@ab, packed);
                        r = this.mod.own(ab.mem);
                        -> r;
                    };
                };
            };

            // Decimal text to integer. False when the text is not a plain integer.
            parse_int_text(byte* t, i64* out) -> bool
            {
                int i = 0;
                bool neg = false;
                i64 v = (i64)0;
                switch (t == (byte*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (t[0] == '-')
                        {
                            case (true) {
                            neg = true;
                            i = 1;
                        }
                            default {};
                        };
                        switch (t[i] < '0' | t[i] > '9')
                        {
                            case (true) { -> false; }
                            default
                            {
                                while (t[i] >= '0' & t[i] <= '9')
                                {
                                    v = v * (i64)10 + (i64)(t[i] - '0');
                                    i++;
                                };
                                switch (t[i] != 0)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        switch (neg)
                                        {
                                            case (true) { v = (i64)0 - v; }
                                            default {};
                                        };
                                        *out = v;
                                        -> true;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // ArrayTypeHandler.create_global_array_initializer for integer literal elements.
            // Literal.codegen gives the literal its own width, then it is truncated (masked) or
            // widened (value kept) to the element width.
            global_elem_value(Node* e, IRType* et, i64* out) -> bool
            {
                i64 v;
                int sw;
                int dt;
                i64 mask;
                switch (et.kind != LK.INT)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (e.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) {
                            -> this.parse_int_text(this.global_ident_init(e.text), out);
                        }
                            default
                            {
                                switch (e.kind != NodeKind.LITERAL)
                                {
                                    case (true) { -> false; }
                                    default
                                    {
                                        dt = e.op;
                                        v = e.ival;
                                        switch (dt == DataType.SINT)
                                        {
                                            case (true) { sw = 32; }
                                            default {
                                                switch (dt == DataType.UINT)
                                                {
                                                    case (true) {
                                            sw = 32;
                                            switch (v > (i64)2147483647)
                                            {
                                                case (true) { v = v - ((i64)1 << (i64)32); }
                                                default {};
                                            };
                                        }
                                                    default {
                                                        switch (dt == DataType.SLONG | dt == DataType.ULONG)
                                                        {
                                                            case (true) { sw = 64; }
                                                            default {
                                                                switch (dt == DataType.BOOL)
                                                                {
                                                                    case (true) {
                                            sw = 1;
                                            switch (v != (i64)0)
                                            {
                                                case (true) { v = (i64)1; }
                                                default {};
                                            };
                                        }
                                                                    default {
                                                                        switch (dt == DataType.CHAR)
                                                                        {
                                                                            case (true) { sw = 8; }
                                                                            default { -> false; };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                        switch (sw > et.width)
                                        {
                                            case (true) {
                                            switch (et.width < 64)
                                            {
                                                case (true) {
                                                mask = ((i64)1 << (i64)et.width) - (i64)1;
                                                v = v `& mask;
                                            }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                        *out = v;
                                        -> true;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // "[T v, T v, ...]" text for a global array whose elements are v[0..n)
            global_array_text(IRType* lt, i64* v, int n) -> byte*
            {
                Buf ab;
                int i;
                byte* r;
                ab.__init();
                defer ab.__exit();
                ab.put(91);
                while (i < lt.count)
                {
                    switch (i > 0)
                    {
                        case (true) { ab.put_str(g", \0"); }
                        default {};
                    };
                    lt_text(@ab, lt.elem);
                    ab.put(32);
                    switch (i < n)
                    {
                        case (true) { put_i64(@ab, v[i]); }
                        default { ab.put(48); };
                    };
                    i++;
                };
                ab.put(93);
                r = this.mod.own(ab.mem);
                -> r;
            };

            // create_global_array_initializer for string elements of a pointer array
            global_ptr_array_init(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i;
                Buf ab;
                byte* r;
                switch (lt.elem.elem.kind != LK.INT | n > lt.count)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (lt.elem.elem.width != 8)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                while (i < n)
                                {
                                    switch (node_child(ini, 0, i).kind != NodeKind.STRING_LITERAL)
                                    {
                                        case (true) { -> (byte*)0; }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                                ab.__init();
                                defer ab.__exit();
                                ab.put(91);
                                i = 0;
                                while (i < lt.count)
                                {
                                    switch (i > 0)
                                    {
                                        case (true) { ab.put_str(g", \0"); }
                                        default {};
                                    };
                                    switch (i < n)
                                    {
                                        case (true) { this.str_global_text(node_child(ini, 0, i), @ab); }
                                        default { ab.put_str(g"i8* null\0"); };
                                    };
                                    i++;
                                };
                                ab.put(93);
                                r = this.mod.own(ab.mem);
                                -> r;
                            };
                        };
                    };
                };
            };

            // create_global_array_initializer for float literal elements of a float or double array.
            // A literal of the other floating type is a type mismatch there, so it is not handled
            global_fp_array_init(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i;
                int want;
                Node* e;
                Buf ab;
                byte* r;
                switch (n > lt.count)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (lt.elem.kind == LK.FLOAT)
                        {
                            case (true) { want = DataType.FLOAT; }
                            default { want = DataType.DOUBLE; };
                        };
                        while (i < n)
                        {
                            e = node_child(ini, 0, i);
                            switch (e.kind != NodeKind.LITERAL)
                            {
                                case (true) { -> (byte*)0; }
                                default
                                {
                                    switch (e.op != want)
                                    {
                                        case (true) { -> (byte*)0; }
                                        default
                                        {
                                            i++;
                                        };
                                    };
                                };
                            };
                        };
                        ab.__init();
                        defer ab.__exit();
                        ab.put(91);
                        i = 0;
                        while (i < lt.count)
                        {
                            switch (i > 0)
                            {
                                case (true) { ab.put_str(g", \0"); }
                                default {};
                            };
                            lt_text(@ab, lt.elem);
                            ab.put(32);
                            switch (i < n)
                            {
                                case (true) { ab.put_str(this.mod.c_fp(lt.elem, node_child(ini, 0, i).fval).text); }
                                default { ab.put_str(this.mod.c_fp(lt.elem, 0.0).text); };
                            };
                            i++;
                        };
                        ab.put(93);
                        r = this.mod.own(ab.mem);
                        -> r;
                    };
                };
            };

            // "[ty v, ...]" for a global array of structs given as global identifiers (identifier_to_constant)
            global_struct_array_init(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i;
                int k;
                int f;
                int nf;
                int np;
                int nn;
                Node* e;
                Node* fe;
                byte* it;
                byte* fv;
                SInfo* si = this.sinfo_of(lt.elem);
                Buf ab;
                byte* r;
                Node** ex;
                switch (n > lt.count | si == (SInfo*)0)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        ab.__init();
                        defer ab.__exit();
                        ab.put(91);
                        while (i < lt.count)
                        {
                            switch (i > 0)
                            {
                                case (true) { ab.put_str(g", \0"); }
                                default {};
                            };
                            lt_text(@ab, lt.elem);
                            ab.put(32);
                            switch (i >= n)
                            {
                                case (true) { ab.put_str(this.mod.c_null(lt.elem).text); }
                                default {
                                    e = node_child(ini, 0, i);
                                    switch (e.kind == NodeKind.IDENTIFIER)
                                    {
                                        case (true) {
                                        it = this.global_ident_init(e.text);
                                        switch (it == (byte*)0)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                ab.put_str(it);
                                            };
                                        };
                                    }
                                        default {
                                            switch (e.kind != NodeKind.STRUCT_LITERAL)
                                            {
                                                case (true) { -> (byte*)0; }
                                                default
                                                {
                                                    nf = si.n;
                                                    np = node_count(e, 2);
                                                    nn = node_count(e, 0);
                                                    switch (np > nf)
                                                    {
                                                        case (true) { -> (byte*)0; }
                                                        default
                                                        {
                                                            ex = (Node**)this.zbuf(nf + 1);
                                                            k = 0;
                                                            while (k < nn)
                                                            {
                                                                f = this.sidx(si, node_child(e, 0, k).text);
                                                                switch (f < 0)
                                                                {
                                                                    case (true) { -> (byte*)0; }
                                                                    default
                                                                    {
                                                                        ex[f] = node_child(e, 1, k);
                                                                        k++;
                                                                    };
                                                                };
                                                            };
                                                            k = 0;
                                                            while (k < np)
                                                            {
                                                                ex[k] = node_child(e, 2, k);
                                                                k++;
                                                            };
                                                            ab.put(123);
                                                            k = 0;
                                                            while (k < nf)
                                                            {
                                                                switch (k > 0)
                                                                {
                                                                    case (true) { ab.put_str(g", \0"); }
                                                                    default {};
                                                                };
                                                                lt_text(@ab, si.ftys[k]);
                                                                ab.put(32);
                                                                switch (ex[k] != (Node*)0)
                                                                {
                                                                    case (true) {
                                                                    fv = this.global_member_value(ex[k], si.ftys[k]);
                                                                    switch (fv == (byte*)0)
                                                                    {
                                                                        case (true) { -> (byte*)0; }
                                                                        default
                                                                        {
                                                                            ab.put_str(fv);
                                                                        };
                                                                    };
                                                                }
                                                                    default { ab.put_str(this.mod.c_null(si.ftys[k]).text); };
                                                                };
                                                                k++;
                                                            };
                                                            ab.put(125);
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                            i++;
                        };
                        ab.put(93);
                        r = this.mod.own(ab.mem);
                        -> r;
                    };
                };
            };

            // Splits the aggregate constant text t (from its opening bracket) into top level
            // items. Returns the item count, starts and ends index into t.
            split_agg(byte* t, int open, int* st, int* en, int max) -> int
            {
                int i = open + 1;
                int depth;
                int cnt;
                int b = i;
                bool q;
                byte c;
                while (t[i] != 0)
                {
                    c = t[i];
                    switch (q)
                    {
                        case (true) {
                        switch (c == '"') { case (true) { q = false; } default {}; };
                    }
                        default {
                            switch (c == '"')
                            {
                                case (true) { q = true; }
                                default {
                                    switch (c == '{' | c == '[' | c == '(')
                                    {
                                        case (true) { depth++; }
                                        default {
                                            switch (c == '}' | c == ']' | c == ')')
                                            {
                                                case (true) {
                                                switch (depth == 0)
                                                {
                                                    case (true) {
                                                    switch (i > b & cnt < max)
                                                    {
                                                        case (true) { st[cnt] = b; en[cnt] = i; cnt++; }
                                                        default {};
                                                    };
                                                    -> cnt;
                                                }
                                                    default
                                                    {
                                                        depth--;
                                                    };
                                                };
                                            }
                                                default {
                                                    switch (c == ',' & depth == 0)
                                                    {
                                                        case (true) {
                                                        switch (cnt < max)
                                                        {
                                                            case (true) { st[cnt] = b; en[cnt] = i; cnt++; }
                                                            default {};
                                                        };
                                                        b = i + 1;
                                                        switch (t[b] == ' ') { case (true) { b++; } default {}; };
                                                    }
                                                        default {};
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    i++;
                };
                -> cnt;
            };

            // Struct body text ("{...}" or "zeroinitializer") with field idx replaced by "ty v"
            patch_struct_text(byte* body, SInfo* si, int idx, byte* fv) -> byte*
            {
                int* sts = (int*)this.zbuf(64);
                int* ens = (int*)this.zbuf(64);
                int cnt;
                int i;
                int o;
                Buf ab;
                byte* r;
                byte* zt;
                switch (si.n > 64)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        ab.__init();
                        defer ab.__exit();
                        ab.put(123);
                        switch (body[0] == '{')
                        {
                            case (true) { cnt = this.split_agg(body, 0, sts, ens, 64); }
                            default {};
                        };
                        while (i < si.n)
                        {
                            switch (i > 0)
                            {
                                case (true) { ab.put_str(g", \0"); }
                                default {};
                            };
                            switch (i == idx)
                            {
                                case (true) {
                                switch (!this.gmv_full)
                                {
                                    case (true) {
                                        lt_text(@ab, si.ftys[i]);
                                        ab.put(32);
                                    }
                                    default {};
                                };
                                ab.put_str(fv);
                            }
                                default {
                                    switch (body[0] == '{' & i < cnt)
                                    {
                                        case (true) {
                                        o = sts[i];
                                        while (o < ens[i])
                                        {
                                            ab.put(body[o]);
                                            o++;
                                        };
                                    }
                                        default {
                                            lt_text(@ab, si.ftys[i]);
                                            ab.put(32);
                                            ab.put_str(this.mod.c_null(si.ftys[i]).text);
                                        };
                                    };
                                };
                            };
                            i++;
                        };
                        ab.put(125);
                        r = this.mod.own(ab.mem);
                        -> r;
                    };
                };
            };

            // Constant text of an integer member value, or null when it is not a plain integer
            global_member_value(Node* v, IRType* ft) -> byte*
            {
                Buf ab;
                i64 x;
                byte* r;
                this.gmv_full = false;
                switch (v.kind == NodeKind.STRING_LITERAL & ft.kind == LK.PTR)
                {
                    case (true) {
                    // Python leaves the string global undecayed in a struct member slot
                    ab.__init();
                    defer ab.__exit();
                    this.str_global_ref(v, @ab, false);
                    this.gmv_full = true;
                    r = this.mod.own(ab.mem);
                    -> r;
                }
                    default
                    {
                        switch (ft.kind != LK.INT)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                switch (v.kind == NodeKind.LITERAL)
                                {
                                    case (true) {
                                    switch (v.op != DataType.SINT & v.op != DataType.UINT & v.op != DataType.SLONG & v.op != DataType.ULONG &
                                            v.op != DataType.BOOL & v.op != DataType.CHAR)
                                    {
                                        case (true) { -> (byte*)0; }
                                        default
                                        {
                                            x = v.ival;
                                        };
                                    };
                                }
                                    default {
                                        switch (v.kind != NodeKind.IDENTIFIER)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                switch (!this.parse_int_text(this.global_ident_init(v.text), @x))
                                                {
                                                    case (true) { -> (byte*)0; }
                                                    default {};
                                                };
                                            };
                                        };
                                    };
                                };
                                ab.__init();
                                defer ab.__exit();
                                put_i64(@ab, x);
                                r = this.mod.own(ab.mem);
                                -> r;
                            };
                        };
                    };
                };
            };

            // visit_Assignment at global scope: the constant initializer of the global is patched
            global_assign(Node* es) -> void
            {
                Node* asn = es.a;
                Node* t;
                Node* v;
                Node* o;
                IRGlobal* gl;
                SInfo* si;
                int idx;
                int ai;
                int* sts = (int*)this.zbuf(512);
                int* ens = (int*)this.zbuf(512);
                int cnt;
                int i;
                int j;
                byte* fv;
                byte* body;
                byte* nb;
                IRType* et;
                Buf ab;
                Buf pb;
                switch (asn == (Node*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (asn.kind != NodeKind.ASSIGNMENT)
                        {
                            case (true) { ->; }
                            default
                            {
                                t = asn.a;
                                v = asn.b;
                                switch (t.kind == NodeKind.MEMBER_ACCESS)
                                {
                                    case (true) {
                                    o = t.a;
                                    switch (o.kind == NodeKind.IDENTIFIER)
                                    {
                                        case (true) {
                                        gl = this.global_ident_find(o.text);
                                        switch (gl == (IRGlobal*)0 | gl.init == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        si = this.sinfo_of(gl.ty);
                                        switch (si == (SInfo*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        idx = this.sidx(si, t.text);
                                        switch (idx < 0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        fv = this.global_member_value(v, si.ftys[idx]);
                                        switch (fv == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        nb = this.patch_struct_text(gl.init, si, idx, fv);
                                        switch (nb == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        gl.init = nb;
                                        ->;
                                    }
                                        default {};
                                    };
                                    switch (o.kind == NodeKind.ARRAY_ACCESS)
                                    {
                                        case (true) {
                                        switch (o.a.kind != NodeKind.IDENTIFIER | o.b.kind != NodeKind.LITERAL)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        gl = this.global_ident_find(o.a.text);
                                        switch (gl == (IRGlobal*)0 | gl.init == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        switch (gl.ty.kind != LK.ARRAY)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        et = gl.ty.elem;
                                        si = this.sinfo_of(et);
                                        ai = (int)o.b.ival;
                                        switch (si == (SInfo*)0 | ai < 0 | ai >= gl.ty.count | gl.ty.count > 512)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        idx = this.sidx(si, t.text);
                                        switch (idx < 0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        fv = this.global_member_value(v, si.ftys[idx]);
                                        switch (fv == (byte*)0)
                                        {
                                            case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                            default {};
                                        };
                                        switch (gl.init[0] == '[')
                                        {
                                            case (true) { cnt = this.split_agg(gl.init, 0, sts, ens, 512); }
                                            default {};
                                        };
                                        ab.__init();
                                        defer ab.__exit();
                                        ab.put(91);
                                        i = 0;
                                        while (i < gl.ty.count)
                                        {
                                            switch (i > 0)
                                            {
                                                case (true) { ab.put_str(g", \0"); }
                                                default {};
                                            };
                                            lt_text(@ab, et);
                                            ab.put(32);
                                            body = this.mod.c_null(et).text;
                                            switch (gl.init[0] == '[' & i < cnt)
                                            {
                                                case (true) {
                                                // Element text is "ty body": keep the body part
                                                j = sts[i];
                                                while (j < ens[i] & gl.init[j] != '{' & !(gl.init[j] == 'z' & gl.init[j + 1] == 'e'))
                                                {
                                                    j++;
                                                };
                                                pb.__init();
                                                while (j < ens[i])
                                                {
                                                    pb.put(gl.init[j]);
                                                    j++;
                                                };
                                                body = this.mod.own(pb.mem);
                                                pb.__exit();
                                            }
                                                default {};
                                            };
                                            switch (i == ai)
                                            {
                                                case (true) {
                                                nb = this.patch_struct_text(body, si, idx, fv);
                                                switch (nb == (byte*)0)
                                                {
                                                    case (true) { -> this.note_unsup(g"global member assignment\0"); }
                                                    default {};
                                                };
                                                ab.put_str(nb);
                                            }
                                                default { ab.put_str(body); };
                                            };
                                            i++;
                                        };
                                        ab.put(93);
                                        gl.init = this.mod.own(ab.mem);
                                        ->;
                                    }
                                        default {};
                                    };
                                    -> this.note_unsup(g"global member assignment\0");
                                }
                                    default
                                    {
                                        switch (t.kind == NodeKind.ARRAY_ACCESS)
                                        {
                                            case (true) {
                                            // Only a named global array with a constant index is patched
                                            switch (t.a.kind != NodeKind.IDENTIFIER | t.b.kind != NodeKind.LITERAL)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            gl = this.global_ident_find(t.a.text);
                                            switch (gl == (IRGlobal*)0)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            switch (gl.init == (byte*)0 | gl.ty.kind != LK.ARRAY)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            switch (gl.init[0] != '[' | gl.ty.count > 512)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            et = gl.ty.elem;
                                            ai = (int)t.b.ival;
                                            cnt = this.split_agg(gl.init, 0, sts, ens, 512);
                                            switch (ai < 0 | ai >= cnt)
                                            {
                                                case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                default {};
                                            };
                                            ab.__init();
                                            defer ab.__exit();
                                            switch (v.kind == NodeKind.STRING_LITERAL & et.kind == LK.PTR)
                                            {
                                                case (true) {
                                                switch (et.elem.kind != LK.INT)
                                                {
                                                    case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                    default {};
                                                };
                                                this.str_global_text(v, @ab);
                                            }
                                                default {
                                                    fv = this.global_member_value(v, et);
                                                    switch (fv == (byte*)0)
                                                    {
                                                        case (true) { -> this.note_unsup(g"global element assignment\0"); }
                                                        default {};
                                                    };
                                                    lt_text(@ab, et);
                                                    ab.put(32);
                                                    ab.put_str(fv);
                                                };
                                            };
                                            fv = this.mod.own(ab.mem);
                                            pb.__init();
                                            defer pb.__exit();
                                            j = 0;
                                            while (j < sts[ai])
                                            {
                                                pb.put(gl.init[j]);
                                                j++;
                                            };
                                            pb.put_str(fv);
                                            j = ens[ai];
                                            while (gl.init[j] != 0)
                                            {
                                                pb.put(gl.init[j]);
                                                j++;
                                            };
                                            gl.init = this.mod.own(pb.mem);
                                            ->;
                                        }
                                            default
                                            {
                                                ->;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // Internal constant .str.N global for a string element of a global pointer array
            str_global_text(Node* e, Buf* ob) -> bool
            {
                -> this.str_global_ref(e, ob, true);
            };

            str_global_ref(Node* e, Buf* ob, bool decay) -> bool
            {
                byte* src = this.str_bytes(e);
                int len = this.q_len;
                byte* buf;
                IRType* aty;
                IRValue* cv;
                IRGlobal* gl;
                void* hit;
                IRValue* gv;
                buf = (byte*)fmalloc((u64)(len + 2));
                this.keep((void*)buf);
                memcpy((void*)buf, (void*)src, (u64)len);
                switch (this.null_term)
                {
                    case (true) {
                    switch (len == 0)
                    {
                        case (true) { buf[0] = (byte)0; len = 1; }
                        default {
                            switch (buf[len - 1] != (byte)0)
                            {
                                case (true) { buf[len] = (byte)0; len++; }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                aty = this.mod.t_array(this.t_i8, len);
                cv = this.mod.c_bytes(aty, buf, len);
                hit = nm_get(this.gcache, cv.text);
                switch (hit != (void*)0)
                {
                    case (true) { gv = (IRValue*)hit; }
                    default {
                        this.sc.clear();
                        this.sc.put_str(f".str.{this.nstr}\0");
                        this.nstr++;
                        gl = this.mod.add_global(aty, this.sc.mem, cv.text);
                        gl.linkage = this.mod.own(g"internal\0");
                        gl.constant = true;
                        this.mark_arr_ptr(gl.self.ty);
                        nm_put(this.gcache, this.mod.own(cv.text), (void*)gl.self);
                        gv = gl.self;
                    };
                };
                switch (!decay)
                {
                    case (true) {
                    lt_text(ob, aty);
                    ob.put_str(f"* {gv.text}\0");
                    -> true;
                }
                    default
                    {
                        ob.put_str(g"i8* getelementptr (\0");
                        lt_text(ob, aty);
                        ob.put_str(g", \0");
                        lt_text(ob, aty);
                        ob.put_str(f"* {gv.text}, i32 0, i32 0)\0");
                        -> true;
                    };
                };
            };

            global_array_init(Node* ini, IRType* lt) -> byte*
            {
                int n = node_count(ini, 0);
                int i;
                i64* vals;
                i64 one;
                byte* r;
                switch (lt.kind != LK.ARRAY)
                {
                    case (true) { -> (byte*)0; }
                    default
                    {
                        switch (lt.elem.kind == LK.ISTRUCT)
                        {
                            case (true) { -> this.global_struct_array_init(ini, lt); }
                            default
                            {
                                switch (lt.elem.kind == LK.PTR)
                                {
                                    case (true) { -> this.global_ptr_array_init(ini, lt); }
                                    default
                                    {
                                        switch (lt.elem.kind == LK.FLOAT | lt.elem.kind == LK.DOUBLE)
                                        {
                                            case (true) { -> this.global_fp_array_init(ini, lt); }
                                            default
                                            {
                                                switch (lt.elem.kind != LK.INT)
                                                {
                                                    case (true) { -> (byte*)0; }
                                                    default
                                                    {
                                                        switch (n > lt.count)
                                                        {
                                                            case (true) { -> (byte*)0; }
                                                            default
                                                            {
                                                                vals = (i64*)fmalloc((u64)(8 * (n + 1)));
                                                                while (i < n)
                                                                {
                                                                    switch (!this.global_elem_value(node_child(ini, 0, i), lt.elem, @one))
                                                                    {
                                                                        case (true) { ffree((void*)vals); -> (byte*)0; }
                                                                        default
                                                                        {
                                                                            vals[i] = one;
                                                                            i++;
                                                                        };
                                                                    };
                                                                };
                                                                r = this.global_array_text(lt, vals, n);
                                                                ffree((void*)vals);
                                                                -> r;
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            global_string_init(Node* ini, IRType* lt) -> byte*
            {
                int len;
                int i;
                i64* vals;
                byte* r;
                byte* src;
                Buf pb;
                switch (lt.kind == LK.PTR & lt.elem.kind == LK.INT & lt.elem.width == 8)
                {
                    case (true) {
                    // byte* target: a gep to a .str.gsi.<md5> constant
                    pb.__init();
                    this.gsi_ref(ini.text, this.str_len_of(ini), @pb, false);
                    r = this.mod.own(pb.mem);
                    pb.__exit();
                    -> r;
                }
                    default
                    {
                        src = this.str_bytes(ini);
                        len = this.q_len;
                        switch (lt.kind != LK.ARRAY)
                        {
                            case (true) { -> (byte*)0; }
                            default
                            {
                                switch (lt.elem.kind != LK.INT)
                                {
                                    case (true) { -> (byte*)0; }
                                    default
                                    {
                                        switch (lt.elem.width != 8)
                                        {
                                            case (true) { -> (byte*)0; }
                                            default
                                            {
                                                switch (len > lt.count)
                                                {
                                                    case (true) { len = lt.count; }
                                                    default {};
                                                };
                                                vals = (i64*)fmalloc((u64)(8 * (len + 1)));
                                                while (i < len)
                                                {
                                                    vals[i] = (i64)src[i];
                                                    i++;
                                                };
                                                r = this.global_array_text(lt, vals, len);
                                                ffree((void*)vals);
                                                -> r;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // TypeSystem.infer_array_size for an ArrayLiteral initializer: a bare [] keeps every
            // element, without brackets a trailing zero literal is the terminator and is not counted
            sized_to(TypeSpec* ts, int cnt, Node* n) -> TypeSpec*
            {
                TypeSpec* r = typespec_clone(ts);
                Node* zn;
                r.array_dims = (NodeVec*)0;
                zn = node_new(NodeKind.LITERAL, n.line, n.col);
                zn.op = DataType.SINT;
                zn.ival = (i64)cnt;
                r.array_size = zn;
                -> r;
            };

            sized_by_literal(TypeSpec* ts, Node* ini, Node* n) -> TypeSpec*
            {
                int asz = node_count(ini, 0);
                Node* zn;
                TypeSpec* r;
                switch (ts.array_dims == (NodeVec*)0 & asz > 0)
                {
                    case (true) {
                    zn = node_child(ini, 0, asz - 1);
                    switch (zn.kind == NodeKind.LITERAL & zn.ival == (i64)0)
                    {
                        case (true) { asz--; }
                        default {};
                    };
                }
                    default {};
                };
                r = typespec_clone(ts);
                r.array_dims = (NodeVec*)0;
                zn = node_new(NodeKind.LITERAL, n.line, n.col);
                zn.op = DataType.SINT;
                zn.ival = (i64)asz;
                r.array_size = zn;
                -> r;
            };

            // visit_VariableDeclaration at global scope (_vardecl_global)
            dims_empty(TypeSpec* ts) -> bool
            {
                switch (ts.array_dims == (NodeVec*)0)
                {
                    case (true) { -> true; }
                    default
                    {
                        switch (ts.array_dims.len == 0)
                        {
                            case (true) { -> true; }
                            default
                            {
                                // A single dimension written without a size
                                -> ts.array_dims.len == 1 & ts.array_dims.items[0] == (Node*)0;
                            };
                        };
                    };
                };
            };

            declare_global(Node* n, byte* ns) -> void
            {
                TypeSpec* ts = n.ts;
                IRType* lt;
                IRGlobal* gl;
                byte* m;
                byte* it;
                switch (n.text == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (ts == (TypeSpec*)0)
                        {
                            case (true) { ->; }
                            default
                            {
                                switch (ts.base_type == DataType.DICT)
                                {
                                    case (true) { -> this.declare_global_dict(n, ns); }
                                    default
                                    {
                                        switch (ts.storage_class == StorageClass.AUTO)
                                        {
                                            case (true) { -> this.note_unsup(g"global auto variable\0"); }
                                            default
                                            {
                                                lt = (IRType*)0;
                                                switch ((ts.flags `& TS_ARRAY) != 0 & ts.array_size == (Node*)0 & (ts.array_dims == (NodeVec*)0 | this.dims_empty(ts)))
                                                {
                                                    case (true) {
                                                    // Unsized array: the size comes from a string initializer
                                                    switch (n.a == (Node*)0)
                                                    {
                                                        case (true) {
                                                        -> this.note_unsup(g"global array without size\0");
                                                    }
                                                        default
                                                        {
                                                            switch (n.a.kind == NodeKind.ARRAY_LITERAL & (n.a.flags `& NF_IS_STRING) == 0)
                                                            {
                                                                case (true) { ts = this.sized_by_literal(ts, n.a, n); }
                                                                default {
                                                                    switch (n.a.kind != NodeKind.STRING_LITERAL)
                                                                    {
                                                                        case (true) {
                                                                        -> this.note_unsup(g"global array without size\0");
                                                                    }
                                                                        default
                                                                        {
                                                                            lt = this.lower(ts, true, n.line);
                                                                            switch (lt == (IRType*)0)
                                                                            {
                                                                                case (true) { ->; }
                                                                                default
                                                                                {
                                                                                    this.str_bytes(n.a);
                                                                                    lt = this.mod.t_array(lt.elem, this.q_len);
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (lt == (IRType*)0)
                                                {
                                                    case (true) { lt = this.lower(ts, true, n.line); }
                                                    default {};
                                                };
                                                switch (lt == (IRType*)0)
                                                {
                                                    case (true) { ->; }
                                                    default
                                                    {
                                                        m = mangle_namespace_name(ns, n.text);
                                                        switch (this.global_dup(m))
                                                        {
                                                            case (true) {
                                                            -> ffree(m);
                                                        }
                                                            default
                                                            {
                                                                it = this.global_init(n, lt);
                                                                switch (it == (byte*)0)
                                                                {
                                                                    case (true) {
                                                                    this.note_unsup(g"global initializer\0");
                                                                    -> ffree(m);
                                                                }
                                                                    default
                                                                    {
                                                                        gl = this.mod.add_global(lt, m, it);
                                                                        gl.linkage = this.mod.own(g"internal\0");
                                                                        gl.self.spec = ts;
                                                                        switch (nm_get(this.gvars, m) == (void*)0)
                                                                        {
                                                                            case (true) {
                                                                            LVar* gv = (LVar*)fmalloc((u64)((sizeof(LVar) + 7) / 8));
                                                                            gv.ptr = gl.self;
                                                                            gv.ts = ts;
                                                                            gv.vol = false;
                                                                            gv.is_heap = false;
                                                                            this.keep((void*)gv);
                                                                            nm_put(this.gvars, m, (void*)gv);
                                                                        }
                                                                            default {};
                                                                        };
                                                                        -> ffree(m);
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // TypeSpec that stands for a bare DataType attached to a value
            lit_spec(int dt) -> TypeSpec*
            {
                TypeSpec* t;
                switch (this.lspecs[dt] == (TypeSpec*)0)
                {
                    case (true) {
                    t = typespec_new();
                    t.base_type = dt;
                    this.keep((void*)t);
                    this.lspecs[dt] = t;
                }
                    default {};
                };
                -> this.lspecs[dt];
            };

            // CoercionContext.is_unsigned
            is_uns(IRValue* v) -> bool
            {
                TypeSpec* s = v.spec;
                switch (s == (TypeSpec*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (s.base_type == DataType.UINT)
                        {
                            case (true) { -> true; }
                            default
                            {
                                switch (s.base_type == DataType.BYTE)
                                {
                                    case (true) { -> true; }
                                    default
                                    {
                                        switch (s.base_type == DataType.DATA)
                                        {
                                            case (true) { -> (s.flags `& TS_SIGNED) == 0; }
                                            default
                                            {
                                                -> false;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // EndianSwapHandler.get_endianness
            endian_of(TypeSpec* t) -> int
            {
                switch (t == (TypeSpec*)0)
                {
                    case (true) { -> 1; }
                    default
                    {
                        -> t.endianness;
                    };
                };
            };

            with_spec(IRValue* v, TypeSpec* s) -> IRValue*
            {
                switch (v != (IRValue*)0)
                {
                    case (true) { v.spec = s; }
                    default {};
                };
                -> v;
            };

            int_ty(int w) -> IRType* -> this.mod.t_int(w);

            ci32(int v) -> IRValue* -> this.mod.c_int(this.t_i32, (i64)v);

            // Zero fill of a whole object through llvm.memset sized by the GEP from null trick
            // Array widening assignment (assign_field_value): zero the destination array, then
            // memcpy the source bytes in
            array_widen(IRValue* mp, IRValue* val, IRType* mt) -> void
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                IRType* i8p = this.mod.t_ptr(this.t_i8);
                IRFunc* f;
                IRValue* dp;
                IRValue* sp;
                i64 eb = (i64)8;
                i64 dst_bytes;
                i64 src_bytes;
                this.keep((void*)ps);
                switch (mt.elem.kind == LK.INT)
                {
                    case (true) {
                    eb = (i64)(mt.elem.width / 8);
                    switch (eb < (i64)1)
                    {
                        case (true) { eb = (i64)1; }
                        default {};
                    };
                }
                    default {};
                };
                dst_bytes = (i64)mt.count * eb;
                src_bytes = (i64)val.ty.elem.count * eb;
                ps[0] = i8p;
                ps[1] = this.t_i8;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memset.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                dp = this.mod.cast(g"bitcast\0", mp, i8p, (byte*)0);
                this.mod.ia[0] = dp;
                this.mod.ia[1] = this.mod.c_int(this.t_i8, (i64)0);
                this.mod.ia[2] = this.mod.c_int(this.t_i64, dst_bytes);
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                ps[0] = i8p;
                ps[1] = i8p;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memcpy.p0i8.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                dp = this.mod.cast(g"bitcast\0", mp, i8p, (byte*)0);
                sp = this.mod.cast(g"bitcast\0", val, i8p, (byte*)0);
                this.mod.ia[0] = dp;
                this.mod.ia[1] = sp;
                this.mod.ia[2] = this.mod.c_int(this.t_i64, src_bytes);
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ->;
            };

            memset_object(IRValue* alloca, IRType* lt) -> void
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                IRType* i8p = this.mod.t_ptr(this.t_i8);
                IRFunc* f;
                IRValue* szp;
                IRValue* sz;
                IRValue* cp;
                this.keep((void*)ps);
                ps[0] = i8p;
                ps[1] = this.t_i8;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memset.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                this.mod.ia[0] = this.ci32(1);
                szp = this.mod.gep(this.mod.c_null(this.mod.t_ptr(lt)), this.mod.ia, 1, false, g"obj_sizeof_gep\0");
                sz = this.mod.cast(g"ptrtoint\0", szp, this.t_i64, g"obj_sizeof\0");
                cp = this.mod.cast(g"bitcast\0", alloca, i8p, g"obj_memset_ptr\0");
                this.mod.ia[0] = cp;
                this.mod.ia[1] = this.mod.c_int(this.t_i8, (i64)0);
                this.mod.ia[2] = sz;
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ->;
            };

            // Object declaration with a constructor call (_vardecl_call_constructor)
            init_ctor(IRValue* alloca, IRType* lt, Node* ini, Node* site) -> void
            {
                int argc = node_count(ini, 0);
                int i;
                IRValue* probe;
                IRValue* v;
                IRValue** args;
                IRFunc* f;
                IRType* ft;
                int j;
                bool large;
                bool isstr;
                switch (argc == 1 & lt.kind == LK.ISTRUCT)
                {
                    case (true) {
                    probe = this.visit(node_child(ini, 0, 0));
                    switch (this.bad)
                    {
                        case (true) { ->; }
                        default
                        {
                            switch (probe != (IRValue*)0)
                            {
                                case (true) {
                                switch (probe.ty.kind == LK.PTR)
                                {
                                    case (true) {
                                    switch (lt_eq(probe.ty.elem, lt))
                                    {
                                        case (true) { probe = this.mod.load(probe, g"obj_copy_load\0"); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (lt_eq(probe.ty, lt))
                                {
                                    case (true) {
                                    -> this.mod.store(probe, alloca);
                                }
                                    default {};
                                };
                            }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                switch (lt.kind == LK.ISTRUCT)
                {
                    case (true) {
                    large = false;
                    j = 0;
                    while (j < lt.nitems)
                    {
                        switch (lt.items[j].kind == LK.ARRAY)
                        {
                            case (true) {
                            switch (lt.items[j].count > 64)
                            {
                                case (true) { large = true; }
                                default {};
                            };
                        }
                            default {};
                        };
                        j++;
                    };
                    switch (large)
                    {
                        case (true) { this.memset_object(alloca, lt); }
                        default { this.mod.store(this.zero_of(lt), alloca); };
                    };
                }
                    default {};
                };
                f = this.mod.find_function(ini.text3);
                switch (f == (IRFunc*)0)
                {
                    case (true) {
                    -> this.unsup(site, g"constructor not declared\0");
                }
                    default
                    {
                        ft = f.ftype;
                        args = (IRValue**)fmalloc((u64)(8 * (argc + 1)));
                        this.keep((void*)args);
                        args[0] = alloca;
                        i = 0;
                        while (i < argc)
                        {
                            switch (node_child(ini, 0, i).kind == NodeKind.STRING_LITERAL & i + 1 < ft.nitems)
                            {
                                case (true) { isstr = this.is_i8_ptr(ft.items[i + 1]); }
                                default { isstr = false; };
                            };
                            switch (isstr)
                            {
                                case (true) {
                                this.sc.clear();
                                this.sc.put_str(f"ctor_arg{i}\0");
                                v = this.local_string_value(node_child(ini, 0, i), this.sc.mem);
                            }
                                default { v = this.visit(node_child(ini, 0, i)); };
                            };
                            switch (this.bad)
                            {
                                case (true) { ->; }
                                default
                                {
                                    switch (v == (IRValue*)0)
                                    {
                                        case (true) {
                                        -> this.unsup(site, g"void constructor argument\0");
                                    }
                                        default
                                        {
                                            switch (i + 1 < ft.nitems)
                                            {
                                                case (true) { v = this.convert_arg(v, ft.items[i + 1], i, site); }
                                                default {};
                                            };
                                            switch (this.bad)
                                            {
                                                case (true) { ->; }
                                                default
                                                {
                                                    args[i + 1] = v;
                                                    i++;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        this.mod.call(f.self, args, argc + 1, (byte*)0);
                        ->;
                    };
                };
            };

            is_i8_ptr(IRType* t) -> bool
            {
                switch (t.kind != LK.PTR)
                {
                    case (true) { -> false; }
                    default
                    {
                        -> t.elem.kind == LK.INT & t.elem.width == 8;
                    };
                };
            };

            // Bytes of a string literal (with the configured terminator); length in q_len
            str_bytes(Node* n) -> byte*
            {
                int len = (int)n.ival;
                int i;
                byte* src = n.text;
                byte* buf;
                switch (src == (byte*)0)
                {
                    case (true) { src = g"\0"; }
                    default {};
                };
                switch (len <= 0)
                {
                    case (true) {
                    while (src[len] != 0) { len++; };
                }
                    default {};
                };
                buf = (byte*)fmalloc((u64)(len + 2));
                this.keep((void*)buf);
                while (i < len)
                {
                    buf[i] = src[i];
                    i++;
                };
                switch (this.null_term)
                {
                    case (true) {
                    switch (len == 0)
                    {
                        case (true) {
                        buf[0] = (byte)0;
                        len = 1;
                    }
                        default {
                            switch (buf[len - 1] != (byte)0)
                            {
                                case (true) {
                        buf[len] = (byte)0;
                        len++;
                    }
                                default {};
                            };
                        };
                    };
                }
                    default {};
                };
                this.q_len = len;
                -> buf;
            };

            // Stores bytes into a [N x i8]* with unnamed gep and store pairs
            store_bytes(IRValue* arr, byte* buf, int len) -> void
            {
                int i;
                IRValue* ep;
                while (i < len)
                {
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(i);
                    ep = this.mod.gep(arr, this.mod.ia, 2, false, (byte*)0);
                    this.mod.store(this.mod.c_int(this.t_i8, (i64)(int)buf[i]), ep);
                    i++;
                };
                ->;
            };

            str_init_ok(IRType* lt, Node* ini) -> bool
            {
                switch (ini.op == StorageClass.HEAP)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (this.is_i8_ptr(lt))
                        {
                            case (true) { -> true; }
                            default
                            {
                                -> lt.kind == LK.ARRAY & lt.elem.kind == LK.INT & lt.elem.width == 8;
                            };
                        };
                    };
                };
            };

            // ArrayTypeHandler.initialize_local_string
            init_local_string(IRValue* alloca, IRType* lt, Node* ini) -> void
            {
                byte* buf = this.str_bytes(ini);
                int len = this.q_len;
                int i;
                IRValue* sa;
                IRValue* sp;
                IRValue* ep;
                switch (this.is_i8_ptr(lt))
                {
                    case (true) {
                    sa = this.mod.alloca_here(this.mod.t_array(this.t_i8, len), g"str_data\0");
                    this.store_bytes(sa, buf, len);
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(0);
                    sp = this.mod.gep(sa, this.mod.ia, 2, false, g"str_ptr\0");
                    -> this.mod.store(sp, alloca);
                }
                    default
                    {
                        switch (len > lt.count)
                        {
                            case (true) { len = lt.count; }
                            default {};
                        };
                        this.store_bytes(alloca, buf, len);
                        i = len;
                        while (i < lt.count)
                        {
                            this.mod.ia[0] = this.ci32(0);
                            this.mod.ia[1] = this.ci32(i);
                            ep = this.mod.gep(alloca, this.mod.ia, 2, false, (byte*)0);
                            this.mod.store(this.mod.c_int(this.t_i8, (i64)0), ep);
                            i++;
                        };
                        ->;
                    };
                };
            };

            // create_local_string_for_arg
            local_string_value(Node* s, byte* hint) -> IRValue*
            {
                byte* buf = this.str_bytes(s);
                int len = this.q_len;
                IRValue* sa;
                byte* h = ts_dup(hint);
                this.keep((void*)h);
                this.sc.clear();
                this.sc.put_str(f"{h}_str_data\0");
                sa = this.mod.alloca_here(this.mod.t_array(this.t_i8, len), this.sc.mem);
                this.store_bytes(sa, buf, len);
                this.sc.clear();
                this.sc.put_str(f"{h}_str_ptr\0");
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(0);
                -> this.mod.gep(sa, this.mod.ia, 2, false, this.sc.mem);
            };

            // True when a local array literal is a list of plain scalar expressions
            simple_array_init(IRType* lt, Node* ini) -> bool
            {
                int i;
                int c = node_count(ini, 0);
                int k;
                switch (lt.kind != LK.ARRAY)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (lt.elem.kind == LK.ARRAY)
                        {
                            case (true) {
                            // Rows given as strings, each a stack array that is loaded and stored whole
                            while (i < c)
                            {
                                switch (node_child(ini, 0, i).kind != NodeKind.STRING_LITERAL)
                                {
                                    case (true) { -> false; }
                                    default {};
                                };
                                i++;
                            };
                            -> c > 0;
                        }
                            default
                            {
                                switch (lt.elem.kind == LK.ISTRUCT)
                                {
                                    case (true) {
                                    // Struct literals, each stored whole into its element
                                    while (i < c)
                                    {
                                        switch (node_child(ini, 0, i).kind != NodeKind.STRUCT_LITERAL)
                                        {
                                            case (true) { -> false; }
                                            default {};
                                        };
                                        i++;
                                    };
                                    -> c > 0;
                                }
                                    default
                                    {
                                        switch (lt.elem.kind != LK.INT & lt.elem.kind != LK.PTR & lt.elem.kind != LK.FLOAT & lt.elem.kind != LK.DOUBLE)
                                        {
                                            case (true) { -> false; }
                                            default
                                            {
                                                while (i < c)
                                                {
                                                    k = node_child(ini, 0, i).kind;
                                                    switch (k == NodeKind.STRING_LITERAL | k == NodeKind.ARRAY_LITERAL | k == NodeKind.STRUCT_LITERAL)
                                                    {
                                                        case (true) { -> false; }
                                                        default
                                                        {
                                                            i++;
                                                        };
                                                    };
                                                };
                                                -> true;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // StructTypeHandler._array_bits
            array_bits(IRType* at) -> int
            {
                IRType* e = at.elem;
                int w = 64;
                switch (e.kind)
                {
                    case (LK.INT) { w = e.width; }
                    case (LK.FLOAT) { w = 32; }
                    case (LK.DOUBLE) { w = 64; }
                    case (LK.STRUCT) { w = this.struct_bits(e); }
                    case (LK.ISTRUCT) { w = this.struct_bits(e); }
                    default {};
                };
                -> w * at.count;
            };

            // StructTypeHandler._struct_bits: total bit width of the members of a struct type
            struct_bits(IRType* st) -> int
            {
                int i;
                int total;
                IRType* e;
                while (i < st.nitems)
                {
                    e = st.items[i];
                    switch (e.kind)
                    {
                        case (LK.INT) { total += e.width; }
                        case (LK.FLOAT) { total += 32; }
                        case (LK.DOUBLE) { total += 64; }
                        case (LK.STRUCT) { total += this.struct_bits(e); }
                        case (LK.ISTRUCT) { total += this.struct_bits(e); }
                        case (LK.ARRAY) { total += this.array_bits(e); }
                        default { total += 64; };
                    };
                    i++;
                };
                -> total;
            };

            // ArrayTypeHandler.initialize_local_array for integer element arrays
            init_local_array(IRValue* alloca, IRType* lt, Node* ini) -> void
            {
                int i;
                int c = node_count(ini, 0);
                IRValue* ev;
                IRValue* ep;
                while (i < c & i < lt.count)
                {
                    switch (lt.elem.kind == LK.ARRAY & node_child(ini, 0, i).kind == NodeKind.ARRAY_LITERAL)
                    {
                        case (true) {
                        this.mod.ia[0] = this.ci32(0);
                        this.mod.ia[1] = this.ci32(i);
                        this.sc.clear();
                        this.sc.put_str(f"elem_{i}\0");
                        ep = this.mod.gep(alloca, this.mod.ia, 2, false, this.sc.mem);
                        this.init_local_array(ep, lt.elem, node_child(ini, 0, i));
                        switch (this.bad) { case (true) { ->; } default {}; };
                        i++;
                        continue;
                    }
                        default
                        {
                            switch (lt.elem.kind == LK.ISTRUCT & node_child(ini, 0, i).kind == NodeKind.STRUCT_LITERAL)
                            {
                                case (true) { ev = this.x_struct_lit(node_child(ini, 0, i), lt.elem); }
                                default { ev = this.visit(node_child(ini, 0, i)); };
                            };
                            switch (this.bad)
                            {
                                case (true) { ->; }
                                default
                                {
                                    switch (ev == (IRValue*)0)
                                    {
                                        case (true) {
                                        -> this.unsup(ini, g"void array element\0");
                                    }
                                        default
                                        {
                                            switch (lt.elem.kind)
                                            {
                                                case (LK.ISTRUCT)
                                                {
                                                    switch (!lt_eq(ev.ty, lt.elem))
                                                    {
                                                        case (true) {
                                                        -> this.unsup(ini, g"array element type\0");
                                                    }
                                                        default {};
                                                    };
                                                }
                                                case (LK.PTR)
                                                {
                                                    // Pointer elements keep the pointer, an array pointer decays to its first element
                                                    switch (ev.ty.kind == LK.PTR)
                                                    {
                                                        case (true) {
                                                        switch (ev.ty.elem.kind == LK.ARRAY)
                                                        {
                                                            case (true) {
                                                            this.mod.ia[0] = this.ci32(0);
                                                            this.mod.ia[1] = this.ci32(0);
                                                            ev = this.mod.gep(ev, this.mod.ia, 2, false, g"str_to_ptr\0");
                                                        }
                                                            default {};
                                                        };
                                                    }
                                                        default {};
                                                    };
                                                    switch (!lt_eq(ev.ty, lt.elem))
                                                    {
                                                        case (true) {
                                                        -> this.unsup(ini, g"array element type\0");
                                                    }
                                                        default {};
                                                    };
                                                }
                                                default
                                                {
                                                    switch (ev.ty.kind == LK.PTR)
                                                    {
                                                        case (true) { ev = this.mod.load(ev, (byte*)0); }
                                                        default {};
                                                    };
                                                    switch (lt.elem.kind == LK.INT)
                                                    {
                                                        case (true) {
                                                        // A struct whose total bit width equals the element is reinterpreted through memory
                                                        switch ((ev.ty.kind == LK.STRUCT | ev.ty.kind == LK.ISTRUCT) & this.struct_bits(ev.ty) == lt.elem.width)
                                                        {
                                                            case (true) {
                                                            IRValue* stmp = this.mod.alloca(ev.ty, g"struct_tmp\0");
                                                            this.mod.store(ev, stmp);
                                                            IRValue* sip = this.mod.cast(g"bitcast\0", stmp, this.mod.t_ptr(lt.elem), g"struct_as_int_ptr\0");
                                                            ev = this.mod.load(sip, g"struct_to_int\0");
                                                        }
                                                            default {};
                                                        };
                                                        switch (ev.ty.kind != LK.INT)
                                                        {
                                                            case (true) {
                                                            -> this.unsup(ini, g"array element type\0");
                                                        }
                                                            default
                                                            {
                                                                switch (ev.ty.width < lt.elem.width)
                                                                {
                                                                    case (true) { ev = this.mod.cast(g"zext\0", ev, lt.elem, (byte*)0); }
                                                                    default {
                                                                        switch (ev.ty.width > lt.elem.width)
                                                                        {
                                                                            case (true) { ev = this.mod.cast(g"trunc\0", ev, lt.elem, (byte*)0); }
                                                                            default {};
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    }
                                                        default {
                                                            switch (!lt_eq(ev.ty, lt.elem))
                                                            {
                                                                case (true) {
                                                        -> this.unsup(ini, g"array element type\0");
                                                    }
                                                                default {};
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                            this.mod.ia[0] = this.ci32(0);
                                            this.mod.ia[1] = this.ci32(i);
                                            this.sc.clear();
                                            this.sc.put_str(f"elem_{i}\0");
                                            ep = this.mod.gep(alloca, this.mod.ia, 2, false, this.sc.mem);
                                            this.mod.store(ev, ep);
                                            i++;
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                ->;
            };

            // Zero fill of a large local array through llvm.memset
            memset_zero(IRValue* alloca, IRType* lt) -> void
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                IRType* i8p = this.mod.t_ptr(this.t_i8);
                IRFunc* f;
                IRValue* cp;
                int eb = 1;
                this.keep((void*)ps);
                ps[0] = i8p;
                ps[1] = this.t_i8;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memset.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                switch (lt.elem.kind == LK.INT)
                {
                    case (true) { eb = lt.elem.width / 8; }
                    default {};
                };
                cp = this.mod.cast(g"bitcast\0", alloca, i8p, g"memset_ptr\0");
                this.mod.ia[0] = cp;
                this.mod.ia[1] = this.mod.c_int(this.t_i8, (i64)0);
                this.mod.ia[2] = this.mod.c_int(this.t_i64, (i64)lt.count * (i64)eb);
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ->;
            };

            // Declares (or finds) an intrinsic or external function by type
            // llvm.va_start / va_end (n == 1) and llvm.va_copy (n == 2): void (i8*[, i8*])
            va_intrinsic(byte* name, int n) -> IRFunc*
            {
                IRType** ps = (IRType**)this.zbuf(2);
                ps[0] = this.t_i8p;
                ps[1] = this.t_i8p;
                -> this.intrinsic(name, this.mod.t_func(this.t_void, ps, n, false));
            };

            // Removes the source variable of a recast from its scope
            recast_invalidate(Node* src) -> void
            {
                int k;
                byte* nm = (byte*)0;
                switch (src.kind == NodeKind.ARRAY_SLICE)
                {
                    case (true) {
                    switch (src.a.kind == NodeKind.IDENTIFIER) { case (true) { nm = src.a.text; } default {}; };
                }
                    default {
                    switch (src.kind == NodeKind.IDENTIFIER) { case (true) { nm = src.text; } default {}; };
                };
                };
                switch (nm == (byte*)0)
                {
                    case (true) { ->; }
                    default
                    {
                        k = this.scopes.len - 1;
                        while (k >= 0)
                        {
                            switch (nm_get((NameMap*)this.scopes.items[k], nm) != (void*)0)
                            {
                                case (true) {
                                nm_del((NameMap*)this.scopes.items[k], nm);
                                break;
                            }
                                default
                                {
                                    k--;
                                };
                            };
                        };
                        ->;
                    };
                };
            };

            // visit_StructRecast: a pointer source is reinterpreted in place
            x_recast(Node* n) -> IRValue*
            {
                IRType* st = this.resolve_custom(n.text);
                IRValue* src;
                IRValue* sv;
                IRValue* start;
                Node* sl;
                switch (st == (IRType*)0)
                {
                    case (true) {
                    this.unsup(n, g"struct recast target\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (n.a.kind == NodeKind.ARRAY_SLICE)
                        {
                            case (true) {
                            sl = n.a;
                            sv = this.visit(sl.a);
                            switch (this.bad | sv == (IRValue*)0)
                            {
                                case (true) { -> (IRValue*)0; }
                                default
                                {
                                    // An alloca of a pointer to a non array is loaded first
                                    switch (sv.ty.kind == LK.PTR)
                                    {
                                        case (true) {
                                        switch (sv.ty.elem.kind == LK.PTR)
                                        {
                                            case (true) {
                                            switch (sv.ty.elem.elem.kind != LK.ARRAY)
                                            {
                                                case (true) { sv = this.mod.load(sv, g"recast_arr_load\0"); }
                                                default {};
                                            };
                                        }
                                            default {};
                                        };
                                    }
                                        default {};
                                    };
                                    start = this.visit(sl.b);
                                    switch (this.bad | start == (IRValue*)0)
                                    {
                                        case (true) { -> (IRValue*)0; }
                                        default
                                        {
                                            switch (start.ty.kind == LK.INT & start.ty.width != 32)
                                            {
                                                case (true) {
                                                switch (start.ty.width > 32)
                                                {
                                                    case (true) { start = this.mod.cast(g"trunc\0", start, this.t_i32, g"recast_start_trunc\0"); }
                                                    default { start = this.mod.cast(g"sext\0", start, this.t_i32, g"recast_start_ext\0"); };
                                                };
                                            }
                                                default {};
                                            };
                                            switch (sv.ty.kind == LK.PTR)
                                            {
                                                case (true) {
                                                switch (sv.ty.elem.kind == LK.ARRAY)
                                                {
                                                    case (true) {
                                                    this.mod.ia[0] = this.ci32(0);
                                                    this.mod.ia[1] = start;
                                                    src = this.mod.gep(sv, this.mod.ia, 2, true, g"recast_src_ptr\0");
                                                }
                                                    default {
                                                    this.mod.ia[0] = start;
                                                    src = this.mod.gep(sv, this.mod.ia, 1, true, g"recast_src_ptr\0");
                                                };
                                                };
                                            }
                                                default {
                                                this.unsup(n, g"struct recast slice source\0");
                                                -> (IRValue*)0;
                                            };
                                            };
                                        };
                                    };
                                };
                            };
                        }
                            default {
                            src = this.visit(n.a);
                            switch (this.bad | src == (IRValue*)0)
                            {
                                case (true) { -> (IRValue*)0; }
                                default {};
                            };
                        };
                        };
                        switch (src.ty.kind != LK.PTR)
                        {
                            case (true) {
                            this.unsup(n, g"struct recast by value\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (lt_eq(src.ty.elem, st))
                                {
                                    case (true) { -> src; }
                                    default
                                    {
                                        -> this.mod.cast(g"bitcast\0", src, this.mod.t_ptr(st), g"recast_ptr\0");
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // _stringify_emit: internal constant holding text, named with the node identity
            stringify_emit(byte* text, Node* n) -> IRValue*
            {
                int len = pp_cstrlen(text);
                IRType* aty = this.mod.t_array(this.t_i8, len + 1);
                IRValue* cv;
                IRGlobal* gl;
                byte[24] dig;
                int nd;
                u64 id = (u64)n;
                Buf gn;
                byte* buf = (byte*)this.zbuf((len + 8) / 8 + 1);
                int i;
                while (i < len)
                {
                    buf[i] = text[i];
                    i++;
                };
                buf[len] = (byte)0;
                cv = this.mod.c_bytes(aty, buf, len + 1);
                gn.__init();
                defer gn.__exit();
                gn.put_str(f".stringify.{text}\0");
                gn.put(46);
                if (id == (u64)0) { dig[0] = '0'; nd = 1; };
                while (id > (u64)0)
                {
                    dig[nd] = (byte)('0' + (int)(id % (u64)10));
                    nd++;
                    id = id / (u64)10;
                };
                while (nd > 0)
                {
                    nd--;
                    gn.put(dig[nd]);
                };
                gl = this.mod.add_global(aty, gn.mem, cv.text);
                gl.linkage = this.mod.own(g"internal\0");
                gl.constant = true;
                this.mark_arr_ptr(gl.self.ty);
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(0);
                this.sc.clear();
                this.sc.put_str(f"str_{text}\0");
                -> this.mod.gep(gl.self, this.mod.ia, 2, true, this.sc.mem);
            };

            // visit_Stringify: $name and $name.member
            x_stringify(Node* n) -> IRValue*
            {
                byte* text;
                switch (n.text2 != (byte*)0)
                {
                    case (true) {
                    switch (n.text2[0] == '#')
                    {
                        case (true) {
                        this.unsup(n, g"stringify of a union tag\0");
                        -> (IRValue*)0;
                    }
                        default {};
                    };
                    text = join3(n.text, g".\0", n.text2);
                    this.keep((void*)text);
                    -> this.stringify_emit(text, n);
                }
                    default
                    {
                        switch (this.find_var(n.text) == (LVar*)0 & st_lookup_any(this.st, n.text, this.cur_ns) == (FXC_SYMENTRY*)0)
                        {
                            case (true) {
                            this.unsup(n, g"stringify of an undefined identifier\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                -> this.stringify_emit(n.text, n);
                            };
                        };
                    };
                };
            };

            // visit_TieExpression: loads the variable, marks it moved and zeroes it
            x_tie(Node* n) -> IRValue*
            {
                LVar* lv;
                IRValue* tied;
                IRType* pt;
                switch (n.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true) {
                    this.unsup(n, g"tie of a non variable\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (nm_get(this.untied, n.a.text) != (void*)0)
                        {
                            case (true) {
                            this.unsup(n, g"use after untie\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                lv = this.find_var(n.a.text);
                                switch (lv == (LVar*)0)
                                {
                                    case (true) {
                                    this.unsup(n, g"tie of an unknown variable\0");
                                    -> (IRValue*)0;
                                }
                                    default
                                    {
                                        this.sc.clear();
                                        this.sc.put_str(f"{n.a.text}_tied\0");
                                        tied = this.mod.load(lv.ptr, this.sc.mem);
                                        nm_put(this.untied, n.a.text, (void*)1);
                                        pt = lv.ptr.ty.elem;
                                        switch (pt.kind == LK.PTR | pt.kind == LK.INT | pt.kind == LK.FLOAT | pt.kind == LK.DOUBLE |
                                                pt.kind == LK.STRUCT | pt.kind == LK.ISTRUCT | pt.kind == LK.ARRAY)
                                        {
                                            case (true) { this.mod.store(this.zero_of(pt), lv.ptr); }
                                            default {};
                                        };
                                        -> tied;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // visit_VariadicAccess: ...[N]
            x_vaaccess(Node* n) -> IRValue*
            {
                IRValue* idx;
                IRValue* cl;
                IRValue* cp;
                IRValue* res;
                IRValue* ctr;
                IRValue* cv;
                IRValue* c;
                IRValue* t;
                IRFunc* f;
                IRBlock* binit;
                IRBlock* bcond;
                IRBlock* bbody;
                IRBlock* bend;
                IRBlock* bmerge;
                switch (this.va_list_v == (IRValue*)0)
                {
                    case (true) {
                    this.unsup(n, g"...[N] used outside of a variadic function\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        idx = this.visit(n.a);
                        switch (this.bad | idx == (IRValue*)0)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                switch (idx.ty.kind == LK.INT & idx.ty.width != 32)
                                {
                                    case (true) {
                                    switch (idx.ty.width > 32)
                                    {
                                        case (true) { idx = this.mod.cast(g"trunc\0", idx, this.t_i32, g"va_idx_trunc\0"); }
                                        default { idx = this.mod.cast(g"sext\0", idx, this.t_i32, g"va_idx_ext\0"); };
                                    };
                                }
                                    default {};
                                };
                                cl = this.mod.alloca_here(this.mod.t_array(this.t_i8p, 1), g"va_copy\0");
                                cp = this.mod.cast(g"bitcast\0", cl, this.t_i8p, g"va_copy_ptr\0");
                                this.mod.ia[0] = cp;
                                this.mod.ia[1] = this.va_list_p;
                                this.mod.call(this.va_intrinsic(g"llvm.va_copy\0", 2).self, this.mod.ia, 2, (byte*)0);
                                f = this.va_intrinsic(g"llvm.va_end\0", 1);
                                res = this.mod.alloca_here(this.t_i64, g"va_result\0");
                                binit = this.mod.append_block(this.fn, g"va_loop_init\0");
                                bcond = this.mod.append_block(this.fn, g"va_loop_cond\0");
                                bbody = this.mod.append_block(this.fn, g"va_loop_body\0");
                                bend = this.mod.append_block(this.fn, g"va_loop_end\0");
                                bmerge = this.mod.append_block(this.fn, g"va_merge\0");
                                this.mod.br(binit);
                                this.mod.position(this.fn, binit);
                                ctr = this.mod.alloca_here(this.t_i32, g"va_counter\0");
                                this.mod.store(this.mod.c_int(this.t_i32, (i64)0), ctr);
                                this.mod.br(bcond);
                                this.mod.position(this.fn, bcond);
                                cv = this.mod.load(ctr, g"va_cnt_load\0");
                                c = this.mod.icmp(g"slt\0", cv, idx, g"va_cond\0");
                                this.mod.cbr(c, bbody, bend);
                                this.mod.position(this.fn, bbody);
                                this.mod.va_arg(cp, this.t_i64, g"va_discard\0");
                                cv = this.mod.load(ctr, g"va_cnt_inc_load\0");
                                t = this.mod.binop(g"add\0", cv, this.mod.c_int(this.t_i32, (i64)1), g"va_cnt_inc\0");
                                this.mod.store(t, ctr);
                                this.mod.br(bcond);
                                this.mod.position(this.fn, bend);
                                t = this.mod.va_arg(cp, this.t_i64, g"va_result_val\0");
                                this.mod.store(t, res);
                                this.mod.ia[0] = cp;
                                this.mod.call(f.self, this.mod.ia, 1, (byte*)0);
                                this.mod.br(bmerge);
                                this.mod.position(this.fn, bmerge);
                                -> this.mod.load(res, g"va_arg_result\0");
                            };
                        };
                    };
                };
            };

            intrinsic(byte* name, IRType* ft) -> IRFunc*
            {
                IRFunc* f = this.mod.find_function(name);
                switch (f == (IRFunc*)0)
                {
                    case (true) { f = this.mod.add_function(ft, name); }
                    default {};
                };
                -> f;
            };

            // EndianSwapHandler.emit_bswap
            bswap(IRValue* v) -> IRValue*
            {
                IRFunc* f;
                IRType** ps;
                int w = v.ty.width;
                switch (v.ty.kind != LK.INT)
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (w < 16)
                        {
                            case (true) { -> v; }
                            default
                            {
                                switch (w % 16 != 0)
                                {
                                    case (true) { -> v; }
                                    default
                                    {
                                        this.sc.clear();
                                        this.sc.put_str(f"llvm.bswap.i{w}\0");
                                        ps = (IRType**)fmalloc((u64)2 * (u64)((sizeof(IRType*) + 7) / 8));
                                        this.keep((void*)ps);
                                        ps[0] = v.ty;
                                        f = this.intrinsic(this.sc.mem, this.mod.t_func(v.ty, ps, 1, false));
                                        this.mod.ia[0] = v;
                                        -> this.mod.call(f.self, this.mod.ia, 1, g"bswapped\0");
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // EndianSwapHandler.maybe_swap(val, target_ptr)
            maybe_swap(IRValue* v, IRValue* target) -> IRValue*
            {
                IRValue* sw;
                TypeSpec* ns;
                int se, te;
                switch (v.ty.kind != LK.INT)
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (v.ty.width < 16)
                        {
                            case (true) { -> v; }
                            default
                            {
                                se = this.endian_of(v.spec);
                                te = this.endian_of(target.spec);
                                switch (se == te)
                                {
                                    case (true) { -> v; }
                                    default
                                    {
                                        sw = this.bswap(v);
                                        switch (v.spec != (TypeSpec*)0)
                                        {
                                            case (true) {
                                            ns = typespec_clone(v.spec);
                                            ns.endianness = te;
                                            this.keep((void*)ns);
                                            sw.spec = ns;
                                        }
                                            default {};
                                        };
                                        -> sw;
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // Widens or narrows an integer to width ty (names are left to the builder)
            int_resize(IRValue* v, IRType* ty, bool uns) -> IRValue*
            {
                IRValue* r;
                switch (v.ty.width == ty.width)
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (v.ty.width < ty.width)
                        {
                            case (true) {
                            switch (uns)
                            {
                                case (true) { r = this.mod.cast(g"zext\0", v, ty, (byte*)0); }
                                default { r = this.mod.cast(g"sext\0", v, ty, (byte*)0); };
                            };
                        }
                            default { r = this.mod.cast(g"trunc\0", v, ty, (byte*)0); };
                        };
                        r.spec = v.spec;
                        -> r;
                    };
                };
            };

            // CoercionContext.normalize_ints: result in nra and nrb
            normalize_ints(IRValue* a, IRValue* b, bool uns, bool promote) -> void
            {
                int w;
                IRType* ty;
                this.nra = a;
                this.nrb = b;
                switch (a.ty.width == b.ty.width)
                {
                    case (true) { ->; }
                    default
                    {
                        switch (promote)
                        {
                            case (true) {
                            w = a.ty.width;
                            switch (b.ty.width > w)
                            {
                                case (true) { w = b.ty.width; }
                                default {};
                            };
                        }
                            default {
                            w = a.ty.width;
                            switch (b.ty.width < w)
                            {
                                case (true) { w = b.ty.width; }
                                default {};
                            };
                        };
                        };
                        ty = this.int_ty(w);
                        this.nra = this.int_resize(a, ty, uns);
                        this.nrb = this.int_resize(b, ty, uns);
                        ->;
                    };
                };
            };

            // _coerce_to_bool
            to_bool(IRValue* v) -> IRValue*
            {
                IRType* t = v.ty;
                switch (t.kind == LK.INT)
                {
                    case (true) {
                    switch (t.width == 1)
                    {
                        case (true) { -> v; }
                        default {};
                    };
                    -> this.mod.icmp(g"ne\0", v, this.mod.c_int(t, (i64)0), g"tobool\0");
                }
                    default
                    {
                        switch (t.kind == LK.PTR)
                        {
                            case (true) { -> this.mod.icmp(g"ne\0", v, this.mod.c_null(t), g"ptrbool\0"); }
                            default
                            {
                                switch (t.kind == LK.FLOAT | t.kind == LK.DOUBLE)
                                {
                                    case (true) {
                                    -> this.mod.fcmp(g"one\0", v, this.mod.c_fp(t, 0.0), g"fpbool\0");
                                }
                                    default
                                    {
                                        -> this.mod.icmp(g"ne\0", v, this.mod.c_null(t), g"tobool\0");
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // ----------------------------------------------------------
            // Conversions
            // ----------------------------------------------------------

            is_aggregate_ty(IRType* t) -> bool -> t.kind == LK.STRUCT | t.kind == LK.ISTRUCT;

            // CoercionContext.coerce_return_value
            coerce_ret(IRValue* v, IRType* expected, Node* site) -> IRValue*
            {
                IRType* src = v.ty;
                IRValue* r;
                switch (lt_eq(src, expected))
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (src.kind == LK.INT & expected.kind == LK.INT)
                        {
                            case (true) {
                            switch (src.width < expected.width)
                            {
                                case (true) {
                                switch (this.is_uns(v))
                                {
                                    case (true) { r = this.mod.cast(g"zext\0", v, expected, (byte*)0); }
                                    default { r = this.mod.cast(g"sext\0", v, expected, (byte*)0); };
                                };
                            }
                                default { r = this.mod.cast(g"trunc\0", v, expected, (byte*)0); };
                            };
                            r.spec = v.spec;
                            -> r;
                        }
                            default
                            {
                                switch ((src.kind == LK.FLOAT | src.kind == LK.DOUBLE) & expected.kind == LK.INT)
                                {
                                    case (true) {
                                    switch (v.spec != (TypeSpec*)0 & this.is_uns(v))
                                    {
                                        case (true) { r = this.mod.cast(g"fptoui\0", v, expected, (byte*)0); }
                                        default { r = this.mod.cast(g"fptosi\0", v, expected, (byte*)0); };
                                    };
                                    r.spec = v.spec;
                                    -> r;
                                }
                                    default
                                    {
                                        switch (src.kind == LK.INT & (expected.kind == LK.FLOAT | expected.kind == LK.DOUBLE))
                                        {
                                            case (true) {
                                            switch (this.is_uns(v))
                                            {
                                                case (true) { r = this.mod.cast(g"uitofp\0", v, expected, (byte*)0); }
                                                default { r = this.mod.cast(g"sitofp\0", v, expected, (byte*)0); };
                                            };
                                            r.spec = v.spec;
                                            -> r;
                                        }
                                            default
                                            {
                                                switch ((src.kind == LK.FLOAT | src.kind == LK.DOUBLE) & (expected.kind == LK.FLOAT | expected.kind == LK.DOUBLE))
                                                {
                                                    case (true) {
                                                    switch (src.kind)
                                                    {
                                                        case (LK.FLOAT) { r = this.mod.cast(g"fpext\0", v, expected, (byte*)0); }
                                                        default { r = this.mod.cast(g"fptrunc\0", v, expected, (byte*)0); };
                                                    };
                                                    r.spec = v.spec;
                                                    -> r;
                                                }
                                                    default
                                                    {
                                                        switch (src.kind == LK.PTR & expected.kind == LK.PTR)
                                                        {
                                                            case (true) {
                                                            -> this.mod.cast(g"bitcast\0", v, expected, (byte*)0);
                                                        }
                                                            default
                                                            {
                                                                // An integer literal takes the declared pointer return type: `-> 0;` is null
                                                                if (src.kind == LK.INT & expected.kind == LK.PTR & v.is_const)
                                                                {
                                                                    if (cstr_eq(v.text, g"0\0")) { -> this.mod.c_null(expected); };
                                                                    -> this.mod.cast(g"inttoptr\0", v, expected, (byte*)0);
                                                                };
                                                                switch (src.kind == LK.STRUCT & expected.kind == LK.STRUCT)
                                                                {
                                                                    case (true) {
                                                                    this.unsup(site, g"return struct mismatch\0");
                                                                    -> v;
                                                                }
                                                                    default
                                                                    {
                                                                        switch (src.kind == LK.ARRAY & expected.kind == LK.ARRAY)
                                                                        {
                                                                            case (true) {
                                                                            this.unsup(site, g"return array conversion\0");
                                                                            -> v;
                                                                        }
                                                                            default
                                                                            {
                                                                                switch (src.kind == LK.PTR)
                                                                                {
                                                                                    case (true) {
                                                                                    switch (lt_eq(src.elem, expected))
                                                                                    {
                                                                                        case (true) { -> this.mod.load(v, g"array_decay\0"); }
                                                                                        default {};
                                                                                    };
                                                                                }
                                                                                    default {};
                                                                                };
                                                                                this.unsup(site, g"return type mismatch\0");
                                                                                -> v;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // VariableTypeHandler.store_with_type_conversion
            store_conv(IRValue* alloca, IRType* llvm_type, IRValue* iv, Node* ini, Node* site) -> void
            {
                IRValue* v = iv;
                IRType* vt = v.ty;
                int ik = ini.kind;
                switch (ik == NodeKind.CAST_EXPRESSION & vt.kind == LK.PTR & llvm_type.kind == LK.ARRAY)
                {
                    case (true) {
                    v = this.mod.cast(g"bitcast\0", v, this.ptr_of(llvm_type), g"cast_to_array_ptr\0");
                    v = this.mod.load(v, g"loaded_array\0");
                    -> this.mod.store(v, alloca);
                }
                    default
                    {
                        switch (!lt_eq(vt, llvm_type))
                        {
                            case (true) {
                            switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY & llvm_type.kind == LK.ARRAY)
                            {
                                case (true) {
                                switch (vt.elem.elem.kind == llvm_type.elem.kind & vt.elem.elem.width == llvm_type.elem.width & vt.elem.count <= llvm_type.count)
                                {
                                    case (true) {
                                    -> this.array_widen(alloca, v, llvm_type);
                                }
                                    default {};
                                };
                                switch (ik == NodeKind.BINARY_OP & (ini.op == Operator.ADD | ini.op == Operator.SUB))
                                {
                                    case (true) {
                                    -> this.mod.store(this.mod.load(v, g"concat_array_value\0"), alloca);
                                }
                                    default {};
                                };
                                -> this.unsup(site, g"array widening initializer\0");
                            }
                                default
                                {
                                    switch (ik == NodeKind.BINARY_OP & (ini.op == Operator.ADD | ini.op == Operator.SUB) & vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY &
                                        llvm_type.kind == LK.PTR & llvm_type.elem.kind == LK.INT)
                                    {
                                        case (true) {
                                        this.mod.ia[0] = this.ci32(0);
                                        this.mod.ia[1] = this.ci32(0);
                                        -> this.mod.store(this.mod.gep(v, this.mod.ia, 2, false, g"concat_array_to_ptr\0"), alloca);
                                    }
                                        default
                                        {
                                            switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY & llvm_type.kind == LK.INT)
                                            {
                                                case (true) {
                                                -> this.unsup(site, g"array pack initializer\0");
                                            }
                                                default
                                                {
                                                    switch (vt.kind == LK.PTR & this.is_aggregate_ty(llvm_type) & lt_eq(vt.elem, llvm_type))
                                                    {
                                                        case (true) {
                                                        v = this.mod.load(v, g"struct_deref\0");
                                                    }
                                                        default {
                                                            switch (vt.kind == LK.PTR & llvm_type.kind == LK.INT)
                                                            {
                                                                case (true) {
                                                        v = this.mod.cast(g"ptrtoint\0", v, llvm_type, g"ptr_to_int\0");
                                                    }
                                                                default {
                                                                    switch (vt.kind == LK.INT & llvm_type.kind == LK.PTR)
                                                                    {
                                                                        case (true) {
                                                        v = this.mod.cast(g"inttoptr\0", v, llvm_type, g"int_to_ptr\0");
                                                    }
                                                                        default {
                                                                            switch (vt.kind == LK.PTR & llvm_type.kind == LK.PTR)
                                                                            {
                                                                                case (true) {
                                                        switch (!lt_eq(llvm_type.elem, vt.elem))
                                                        {
                                                            case (true) { v = this.mod.cast(g"bitcast\0", v, llvm_type, (byte*)0); }
                                                            default {
                                                                switch (vt.elem.kind == LK.ARRAY)
                                                                {
                                                                    case (true) {
                                                            -> this.unsup(site, g"array pointer pack initializer\0");
                                                        }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    }
                                                                                default {
                                                                                    switch (vt.kind == LK.INT & llvm_type.kind == LK.INT)
                                                                                    {
                                                                                        case (true) {
                                                        switch (vt.width > llvm_type.width)
                                                        {
                                                            case (true) { v = this.mod.cast(g"trunc\0", v, llvm_type, (byte*)0); }
                                                            default {
                                                                switch (vt.width < llvm_type.width)
                                                                {
                                                                    case (true) {
                                                            switch (this.is_uns(v))
                                                            {
                                                                case (true) { v = this.mod.cast(g"zext\0", v, llvm_type, (byte*)0); }
                                                                default { v = this.mod.cast(g"sext\0", v, llvm_type, (byte*)0); };
                                                            };
                                                        }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    }
                                                                                        default {
                                                                                            switch (vt.kind == LK.INT & (llvm_type.kind == LK.FLOAT | llvm_type.kind == LK.DOUBLE))
                                                                                            {
                                                                                                case (true) {
                                                        v = this.mod.cast(g"sitofp\0", v, llvm_type, (byte*)0);
                                                    }
                                                                                                default {
                                                                                                    switch ((vt.kind == LK.FLOAT | vt.kind == LK.DOUBLE) & llvm_type.kind == LK.INT)
                                                                                                    {
                                                                                                        case (true) {
                                                        v = this.mod.cast(g"fptosi\0", v, llvm_type, (byte*)0);
                                                    }
                                                                                                        default {
                                                                                                            switch (vt.kind == LK.FLOAT & llvm_type.kind == LK.DOUBLE)
                                                                                                            {
                                                                                                                case (true) {
                                                        v = this.mod.cast(g"fpext\0", v, llvm_type, g"float_to_double\0");
                                                    }
                                                                                                                default {
                                                                                                                    switch (vt.kind == LK.DOUBLE & llvm_type.kind == LK.FLOAT)
                                                                                                                    {
                                                                                                                        case (true) {
                                                        v = this.mod.cast(g"fptrunc\0", v, llvm_type, g"double_to_float\0");
                                                    }
                                                                                                                        default {};
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                                        };
                                                                                                    };
                                                                                                };
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (v.spec != (TypeSpec*)0)
                        {
                            case (true) {
                            switch (alloca.spec == (TypeSpec*)0)
                            {
                                case (true) { alloca.spec = v.spec; }
                                default {};
                            };
                        }
                            default {};
                        };
                        v = this.maybe_swap(v, alloca);
                        -> this.mod.store(v, alloca);
                    };
                };
            };

            // AssignmentTypeHandler.convert_value_for_assignment
            convert_assign(IRValue* v, IRType* target) -> IRValue*
            {
                IRType* vt = v.ty;
                IRValue* r;
                switch (lt_eq(vt, target))
                {
                    case (true) { -> v; }
                    default
                    {
                        switch (vt.kind == LK.PTR & target.kind == LK.PTR)
                        {
                            case (true) {
                            switch (vt.elem.kind == LK.PTR & lt_eq(vt.elem, target))
                            {
                                case (true) {
                                -> this.mod.load(v, g"ptr_val_loaded\0");
                            }
                                default
                                {
                                    switch (lt_eq(vt.elem, target.elem))
                                    {
                                        case (true) { -> this.mod.cast(g"bitcast\0", v, target, g"ptr_compat\0"); }
                                        default
                                        {
                                            switch (vt.elem.kind == LK.INT & vt.elem.width == 8 & target.elem.kind == LK.INT & target.elem.width == 8)
                                            {
                                                case (true) {
                                                -> this.mod.cast(g"bitcast\0", v, target, g"i8ptr_compat\0");
                                            }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY)
                        {
                            case (true) {
                            switch (target.kind == LK.PTR)
                            {
                                case (true) {
                                switch (lt_eq(target.elem, vt.elem))
                                {
                                    case (true) { -> v; }
                                    default {};
                                };
                                switch (lt_eq(target.elem, vt.elem.elem))
                                {
                                    case (true) {
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(0);
                                    -> this.mod.gep(v, this.mod.ia, 2, false, g"array_to_elem_ptr\0");
                                }
                                    default {};
                                };
                                switch (target.elem.kind == LK.ARRAY)
                                {
                                    case (true) {
                                    switch (target.elem.count == vt.elem.count)
                                    {
                                        case (true) {
                                        -> this.mod.cast(g"bitcast\0", v, target, g"array_ptr_bitcast\0");
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                this.mod.ia[0] = this.ci32(0);
                                this.mod.ia[1] = this.ci32(0);
                                -> this.mod.gep(v, this.mod.ia, 2, false, g"array_to_ptr\0");
                            }
                                default
                                {
                                    switch (lt_eq(target, vt.elem))
                                    {
                                        case (true) { -> this.mod.load(v, g"array_load\0"); }
                                        default {};
                                    };
                                };
                            };
                        }
                            default {};
                        };
                        switch (vt.kind == LK.PTR & target.kind != LK.PTR)
                        {
                            case (true) {
                            switch (lt_eq(vt.elem, target))
                            {
                                case (true) { -> this.mod.load(v, g"struct_copy_load\0"); }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (vt.kind == LK.PTR & vt.elem.kind == LK.INT & vt.elem.width == 8 & target.kind == LK.PTR)
                        {
                            case (true) {
                            -> this.mod.cast(g"bitcast\0", v, target, g"void_ptr_to_typed\0");
                        }
                            default
                            {
                                switch (vt.kind == LK.INT & target.kind == LK.INT)
                                {
                                    case (true) {
                                    switch (vt.width != target.width)
                                    {
                                        case (true) {
                                        -> this.int_resize(v, target, this.is_uns(v));
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (vt.kind == LK.FLOAT & target.kind == LK.DOUBLE)
                                {
                                    case (true) {
                                    -> this.mod.cast(g"fpext\0", v, target, g"f32_to_f64\0");
                                }
                                    default
                                    {
                                        switch (vt.kind == LK.DOUBLE & target.kind == LK.FLOAT)
                                        {
                                            case (true) {
                                            -> this.mod.cast(g"fptrunc\0", v, target, g"f64_to_f32\0");
                                        }
                                            default
                                            {
                                                -> v;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // FunctionTypeHandler.convert_argument_to_parameter_type
            convert_arg(IRValue* v, IRType* expected, int idx, Node* site) -> IRValue*
            {
                IRType* vt = v.ty;
                IRValue* d;
                switch (lt_eq(vt, expected))
                {
                    case (true) { -> v; }
                    default
                    {
                        this.sc.clear();
                        switch (expected.kind == LK.PTR & expected.elem.kind == LK.INT & expected.elem.width == 8)
                        {
                            case (true) {
                            switch (vt.kind == LK.PTR)
                            {
                                case (true) {
                                switch (vt.elem.kind == LK.ARRAY)
                                {
                                    case (true) {
                                    this.sc.put_str(f"arg{idx}_decay\0");
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(0);
                                    d = this.mod.gep(v, this.mod.ia, 2, false, this.sc.mem);
                                    this.sc.clear();
                                    this.sc.put_str(f"arg{idx}_to_void_ptr\0");
                                    -> this.mod.cast(g"bitcast\0", d, expected, this.sc.mem);
                                }
                                    default
                                    {
                                        this.sc.put_str(f"arg{idx}_to_void_ptr\0");
                                        -> this.mod.cast(g"bitcast\0", v, expected, this.sc.mem);
                                    };
                                };
                            }
                                default {};
                            };
                        }
                            default {};
                        };
                        switch (vt.kind == LK.PTR & vt.elem.kind == LK.INT & vt.elem.width == 8 & expected.kind == LK.PTR)
                        {
                            case (true) {
                            this.sc.put_str(f"arg{idx}\0");
                            switch (expected.elem.kind)
                            {
                                case (LK.ARRAY) { this.sc.put_str(g"_to_array_ptr\0"); }
                                default { this.sc.put_str(g"_from_void_ptr\0"); };
                            };
                            -> this.mod.cast(g"bitcast\0", v, expected, this.sc.mem);
                        }
                            default
                            {
                                switch (vt.kind == LK.PTR & vt.elem.kind == LK.ARRAY & expected.kind == LK.PTR)
                                {
                                    case (true) {
                                    switch (lt_eq(vt.elem.elem, expected.elem))
                                    {
                                        case (true) {
                                        this.sc.put_str(f"arg{idx}_decay\0");
                                        this.mod.ia[0] = this.ci32(0);
                                        this.mod.ia[1] = this.ci32(0);
                                        -> this.mod.gep(v, this.mod.ia, 2, false, this.sc.mem);
                                    }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (vt.kind == LK.INT & expected.kind == LK.INT)
                                {
                                    case (true) {
                                    switch (vt.width != expected.width)
                                    {
                                        case (true) { -> this.int_resize(v, expected, this.is_uns(v)); }
                                        default {};
                                    };
                                }
                                    default {};
                                };
                                switch (vt.kind == LK.FLOAT & expected.kind == LK.DOUBLE)
                                {
                                    case (true) {
                                    this.sc.put_str(f"arg{idx}_float_to_double\0");
                                    -> this.mod.cast(g"fpext\0", v, expected, this.sc.mem);
                                }
                                    default
                                    {
                                        switch (vt.kind == LK.DOUBLE & expected.kind == LK.FLOAT)
                                        {
                                            case (true) {
                                            this.sc.put_str(f"arg{idx}_double_to_float\0");
                                            -> this.mod.cast(g"fptrunc\0", v, expected, this.sc.mem);
                                        }
                                            default
                                            {
                                                switch (vt.kind == LK.PTR & this.is_aggregate_ty(expected))
                                                {
                                                    case (true) {
                                                    switch (lt_eq(vt.elem, expected))
                                                    {
                                                        case (true) {
                                                        this.sc.put_str(f"arg{idx}_load\0");
                                                        -> this.mod.load(v, this.sc.mem);
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                this.unsup(site, g"argument type mismatch\0");
                                                -> v;
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // ----------------------------------------------------------
            // Expressions
            // ----------------------------------------------------------

            x_literal(Node* n) -> IRValue*
            {
                int dt = n.op;
                i64 v = n.ival;
                int w;
                IRValue* r;
                switch (dt == DataType.SINT | dt == DataType.UINT)
                {
                    case (true) {
                    // Source text without a sign that wrapped negative exceeded INT64_MAX
                    switch (v < (i64)0 & n.text != (byte*)0)
                    {
                        case (true) {
                        switch (n.text[0] != '-')
                        {
                            case (true) {
                            // Unsigned values above INT64_MAX are wrapped to the signed form by normalize_int_value
                            switch (dt == DataType.UINT)
                            {
                                case (true) { r = this.mod.c_int(this.t_i64, v); }
                                default { r = this.mod.c_u64(this.t_i64, (u64)v); };
                            };
                            r.spec = this.lit_spec(dt);
                            -> r;
                        }
                            default {};
                        };
                    }
                        default {};
                    };
                    w = 32;
                    switch (dt)
                    {
                        case (DataType.SINT)
                        {
                            switch (v < (i64)(0 - 2147483647 - 1) | v > (i64)2147483647)
                            {
                                case (true) { w = 64; }
                                default {};
                            };
                        }
                        default
                        {
                            switch (v >= (i64)0)
                            {
                                case (true) {
                                switch (v > (i64)4294967295)
                                {
                                    case (true) { w = 64; }
                                    default {};
                                };
                            }
                                default {
                                switch (v < (i64)0 - (i64)4294967296)
                                {
                                    case (true) { w = 64; }
                                    default {};
                                };
                            };
                            };
                            switch (w == 32 & v > (i64)2147483647)
                            {
                                case (true) { v = v - (i64)4294967296; }
                                default {};
                            };
                        };
                    };
                    r = this.mod.c_int(this.int_ty(w), v);
                    r.spec = this.lit_spec(dt);
                    -> r;
                }
                    default
                    {
                        switch (dt == DataType.SLONG | dt == DataType.ULONG)
                        {
                            case (true) {
                            // normalize_int_value wraps unsigned values above INT64_MAX to the signed form
                            r = this.mod.c_int(this.t_i64, v);
                            r.spec = this.lit_spec(dt);
                            -> r;
                        }
                            default
                            {
                                switch (dt == DataType.FLOAT)
                                {
                                    case (true) { -> this.mod.c_fp(this.t_float, n.fval); }
                                    default
                                    {
                                        switch (dt == DataType.DOUBLE)
                                        {
                                            case (true) { -> this.mod.c_fp(this.t_double, n.fval); }
                                            default
                                            {
                                                switch (dt == DataType.BOOL)
                                                {
                                                    case (true) { -> this.mod.c_int(this.t_i1, v); }
                                                    default
                                                    {
                                                        switch (dt == DataType.CHAR)
                                                        {
                                                            case (true) { -> this.mod.c_int(this.t_i8, v); }
                                                            default
                                                            {
                                                                switch (dt == DataType.BYTE)
                                                                {
                                                                    case (true) { -> this.mod.c_int(this.int_ty(this.byte_width), v); }
                                                                    default
                                                                    {
                                                                        switch (dt == DataType.VOID)
                                                                        {
                                                                            case (true) { -> this.mod.c_null(this.t_i1); }
                                                                            default
                                                                            {
                                                                                this.unsup(n, g"literal type\0");
                                                                                -> (IRValue*)0;
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // visit_Identifier for a local variable. Mirrors _try_expr_method and the
            // load rules.
            try_expr_method(IRValue* ptr) -> IRValue*
            {
                IRType* pe;
                IRType* st_ty;
                IRValue* this_ptr;
                PtrVec* list;
                Overload* o;
                Overload* oc;
                int oi;
                IRFunc* f;
                byte* key;
                IRValue* r;
                switch (this.in_member)
                {
                    case (true) { -> (IRValue*)0; }
                    default
                    {
                        switch (ptr.ty.kind != LK.PTR)
                        {
                            case (true) { -> (IRValue*)0; }
                            default
                            {
                                pe = ptr.ty.elem;
                                switch (pe.kind == LK.PTR & pe.elem.kind == LK.ISTRUCT)
                                {
                                    case (true) {
                                    st_ty = pe.elem;
                                    this_ptr = this.mod.load(ptr, g"obj_this\0");
                                }
                                    default {
                                        switch (pe.kind == LK.ISTRUCT)
                                        {
                                            case (true) {
                                    st_ty = pe;
                                    this_ptr = ptr;
                                }
                                            default { -> (IRValue*)0; };
                                        };
                                    };
                                };
                                switch (st_ty.name == (byte*)0)
                                {
                                    case (true) { -> (IRValue*)0; }
                                    default
                                    {
                                        // The base resolves "<namespace>__<Type>.__expr" through its overload table,
                                        // which never holds namespaced methods under that key, so no promotion happens
                                        switch (this.has_ns_sep(st_ty.name))
                                        {
                                            case (true) { -> (IRValue*)0; }
                                            default
                                            {
                                                key = join3(st_ty.name, g".__expr\0", g"\0");
                                                list = st_overloads_of(this.st, key);
                                                ffree(key);
                                                switch (list == (PtrVec*)0)
                                                {
                                                    case (true) { -> (IRValue*)0; }
                                                    default
                                                    {
                                                        o = (Overload*)0;
                                                        oi = 0;
                                                        while (oi < list.len)
                                                        {
                                                            oc = (Overload*)list.items[oi];
                                                            switch (oc.nparams == 0)
                                                            {
                                                                case (true) {
                                                                o = oc;
                                                                break;
                                                            }
                                                                default
                                                                {
                                                                    oi++;
                                                                };
                                                            };
                                                        };
                                                        switch (o == (Overload*)0)
                                                        {
                                                            case (true) { -> (IRValue*)0; }
                                                            default
                                                            {
                                                                f = this.mod.find_function(o.mangled);
                                                                switch (f == (IRFunc*)0)
                                                                {
                                                                    case (true) { -> (IRValue*)0; }
                                                                    default
                                                                    {
                                                                        this.sc.clear();
                                                                        this.sc.put_str(f"{st_ty.name}_expr\0");
                                                                        this.mod.ia[0] = this_ptr;
                                                                        r = this.mod.call(f.self, this.mod.ia, 1, this.sc.mem);
                                                                        r.flags = r.flags `| VF_FROM_EXPR;
                                                                        -> r;
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // True when name contains a double underscore namespace separator
            has_ns_sep(byte* s) -> bool
            {
                int i;
                while (s[i] != 0)
                {
                    switch (s[i] == '_' & s[i + 1] == '_')
                    {
                        case (true) { -> true; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };

            x_ident(Node* n) -> IRValue*
            {
                LVar* lv = this.find_var(n.text);
                IRValue* ptr;
                IRValue* r;
                IRValue* e;
                TypeSpec* ts;
                switch (lv == (LVar*)0)
                {
                    case (true) {
                    this.unsup(n, g"identifier not local\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        ptr = lv.ptr;
                        ts = lv.ts;
                        // Use after untie, checked for locals only
                        switch (nm_get(this.untied, n.text) != (void*)0 & this.find_local(n.text) != (LVar*)0)
                        {
                            case (true) {
                            this.unsup(n, g"use after untie\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                switch (cstr_eq(n.text, g"this\0"))
                                {
                                    case (true) { -> ptr; }
                                    default
                                    {
                                        e = this.try_expr_method(ptr);
                                        switch (e != (IRValue*)0)
                                        {
                                            case (true) { -> e; }
                                            default
                                            {
                                                switch (ptr.ty.kind == LK.PTR)
                                                {
                                                    case (true) {
                                                    switch (ptr.ty.elem.kind == LK.ARRAY | ptr.ty.elem.kind == LK.STRUCT)
                                                    {
                                                        case (true) { -> ptr; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (ts != (TypeSpec*)0)
                                                {
                                                    case (true) {
                                                    switch (ts.array_size != (Node*)0)
                                                    {
                                                        case (true) { -> ptr; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (ptr.spec != (TypeSpec*)0)
                                                {
                                                    case (true) {
                                                    switch (ptr.spec.array_size != (Node*)0)
                                                    {
                                                        case (true) { -> ptr; }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                                switch (ptr.ty.kind != LK.PTR)
                                                {
                                                    case (true) { -> ptr; }
                                                    default
                                                    {
                                                        r = this.mod.load(ptr, n.text);
                                                        r.spec = ptr.spec;
                                                        switch (r.spec == (TypeSpec*)0)
                                                        {
                                                            case (true) { r.spec = ts; }
                                                            default {};
                                                        };
                                                        r.flags = ptr.flags `& VF_TYPEFUNC_STR;
                                                        -> r;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            int_pred(int op, bool uns) -> byte*
            {
                switch (op == Operator.EQUAL)
                {
                    case (true) { -> g"eq\0"; }
                    default
                    {
                                       switch (op == Operator.NOT_EQUAL)
                                       {
                                           case (true) { -> g"ne\0"; }
                                           default
                                           {
                                                              switch (op == Operator.LESS_THAN)
                                                              {
                                                                  case (true) { switch (uns)
                                               {
                                                   case (true) { -> g"ult\0"; }
                                                   default {};
                                               }; -> g"slt\0"; }
                                                                  default
                                                                  {
                                                                                     switch (op == Operator.LESS_EQUAL)
                                                                                     {
                                                                                         case (true) { switch (uns)
                                                                      {
                                                                          case (true) { -> g"ule\0"; }
                                                                          default {};
                                                                      }; -> g"sle\0"; }
                                                                                         default
                                                                                         {
                                                                                                            switch (op == Operator.GREATER_THAN)
                                                                                                            {
                                                                                                                case (true) { switch (uns)
                                                                                             {
                                                                                                 case (true) { -> g"ugt\0"; }
                                                                                                 default {};
                                                                                             }; -> g"sgt\0"; }
                                                                                                                default
                                                                                                                {
                                                                                                                    switch (uns)
                                                                                                                    {
                                                                                                                        case (true) { -> g"uge\0"; }
                                                                                                                        default
                                                                                                                        {
                                                                                                                            -> g"sge\0";
                                                                                                                        };
                                                                                                                    };
                                                                                                                };
                                                                                                            };
                                                                                         };
                                                                                     };
                                                                  };
                                                              };
                                           };
                                       };
                    };
                };
            };

            fp_pred(int op) -> byte*
            {
                switch (op == Operator.EQUAL)
                {
                    case (true) { -> g"oeq\0"; }
                    default
                    {
                        switch (op == Operator.NOT_EQUAL)
                        {
                            case (true) { -> g"one\0"; }
                            default
                            {
                                switch (op == Operator.LESS_THAN)
                                {
                                    case (true) { -> g"olt\0"; }
                                    default
                                    {
                                        switch (op == Operator.LESS_EQUAL)
                                        {
                                            case (true) { -> g"ole\0"; }
                                            default
                                            {
                                                switch (op == Operator.GREATER_THAN)
                                                {
                                                    case (true) { -> g"ogt\0"; }
                                                    default
                                                    {
                                                        -> g"oge\0";
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // True when a user defined operator__<op> overload is registered
has_op_overload(int op) -> bool -> this.op_overloads(op) != (PtrVec*)0;

            // Overloads registered for operator__<op>, or null
            op_overloads(int op) -> PtrVec*
            {
                byte* sym = operator_text(op);
                this.sc.clear();
                this.sc.put_str(g"operator__\0");
                mangle_builtin_op(@this.sc, sym);
                -> st_overloads_of(this.st, this.sc.mem);
            };

            // visit_BinaryOp pointer-param overload shortcut: when the first two-parameter
            // overload whose parameters are all pointers takes the very allocas of two local
            // identifier operands, call it with those pointers. Never re-dispatched from
            // inside the overload itself.
            binop_ptr_overload(Node* n, int op) -> IRValue*
            {
                PtrVec* list = this.op_overloads(op);
                Overload* o;
                IRFunc* f;
                IRFunc* pf = (IRFunc*)0;
                LVar* ll;
                LVar* rl;
                IRValue** args;
                int i = 0;
                switch (list == (PtrVec*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                while (i < list.len & pf == (IRFunc*)0)
                {
                    o = (Overload*)list.items[i];
                    i++;
                    switch (o.nparams != 2)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    f = this.mod.find_function(o.mangled);
                    switch (f == (IRFunc*)0)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (f.ftype.nitems != 2)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (!this.ov_visible(o))
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (f.ftype.items[0].kind == LK.PTR & f.ftype.items[1].kind == LK.PTR)
                    {
                        case (true) { pf = f; }
                        default {};
                    };
                };
                switch (pf == (IRFunc*)0 | pf == this.fn)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                switch (n.a.kind != NodeKind.IDENTIFIER | n.b.kind != NodeKind.IDENTIFIER)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                ll = this.find_local(n.a.text);
                rl = this.find_local(n.b.text);
                switch (ll == (LVar*)0 | rl == (LVar*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                switch (!lt_eq(ll.ptr.ty, pf.ftype.items[0]) | !lt_eq(rl.ptr.ty, pf.ftype.items[1]))
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                args = (IRValue**)fmalloc((u64)2 * (u64)((sizeof(IRValue*) + 7) / 8));
                this.keep((void*)args);
                args[0] = ll.ptr;
                args[1] = rl.ptr;
                -> this.mod.call_ex(pf.self, args, 2, g"op_overload_result\0", pf.cconv, false);
            };

            // The base compiler registers an operator overload when it reaches the operator,
            // so only code that comes after the operator in the source can dispatch to it
            ov_visible(Overload* o) -> bool
            {
                switch (this.cur_fd == (Node*)0 | o.func == (Node*)0)
                {
                    case (true) { -> true; }
                    default {};
                };
                switch (o.func.line == 0 | this.cur_fd.line == 0)
                {
                    case (true) { -> true; }
                    default {};
                };
                -> o.func.line < this.cur_fd.line;
            };

            // An operand fits an overload parameter: same type, a pointer to the same
            // pointee, or a pointer to an array whose element is the parameter's pointee
            ov_arg_ok(IRValue* v, IRType* pt) -> bool
            {
                IRType* rt = v.ty;
                switch (lt_eq(rt, pt))
                {
                    case (true) { -> true; }
                    default {};
                };
                switch (rt.kind == LK.PTR & pt.kind == LK.PTR)
                {
                    case (true) {
                        switch (lt_eq(rt.elem, pt.elem))
                        {
                            case (true) { -> true; }
                            default {};
                        };
                        switch (rt.elem.kind == LK.ARRAY)
                        {
                            case (true) { -> lt_eq(rt.elem.elem, pt.elem); }
                            default {};
                        };
                    }
                    default {};
                };
                -> false;
            };

            // visit_BinaryOp built-in operator overload check: the first two-parameter
            // overload (not the function being compiled) whose parameter types fit the
            // operands is called. Returns null when none fits.
            binop_overload(Node* n, int op, IRValue* lhs, IRValue* rhs) -> IRValue*
            {
                PtrVec* list = this.op_overloads(op);
                Overload* o;
                IRFunc* f;
                IRValue** args;
                IRValue* av;
                IRType* pt;
                int i = 0;
                int k;
                switch (list == (PtrVec*)0)
                {
                    case (true) { -> (IRValue*)0; }
                    default {};
                };
                while (i < list.len)
                {
                    o = (Overload*)list.items[i];
                    i++;
                    switch (o.nparams != 2)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    f = this.mod.find_function(o.mangled);
                    switch (f == (IRFunc*)0 | f == this.fn)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (f.ftype.nitems != 2)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (!this.ov_visible(o))
                    {
                        case (true) { continue; }
                        default {};
                    };
                    switch (!this.ov_arg_ok(lhs, f.ftype.items[0]) | !this.ov_arg_ok(rhs, f.ftype.items[1]))
                    {
                        case (true) { continue; }
                        default {};
                    };
                    args = (IRValue**)fmalloc((u64)2 * (u64)((sizeof(IRValue*) + 7) / 8));
                    this.keep((void*)args);
                    k = 0;
                    while (k < 2)
                    {
                        av = lhs;
                        switch (k == 1)
                        {
                            case (true) { av = rhs; }
                            default {};
                        };
                        pt = f.ftype.items[k];
                        switch (lt_eq(av.ty, pt))
                        {
                            case (true) {}
                            default
                            {
                                switch (av.ty.kind == LK.PTR & pt.kind == LK.PTR & lt_eq(av.ty.elem, pt.elem))
                                {
                                    case (true) {}
                                    default
                                    {
                                        switch (av.ty.kind == LK.PTR & av.ty.elem.kind != LK.ARRAY & av.ty.elem.kind != LK.STRUCT &
                                            av.ty.elem.kind != LK.ISTRUCT & lt_eq(av.ty.elem, pt))
                                        {
                                            case (true) { av = this.mod.load(av, g"op_deref\0"); }
                                            default
                                            {
                                                av = this.convert_arg(av, pt, k, n);
                                                switch (this.bad)
                                                {
                                                    case (true) { -> (IRValue*)0; }
                                                    default {};
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        args[k] = av;
                        k++;
                    };
                    -> this.mod.call_ex(f.self, args, 2, g"op_overload_result\0", f.cconv, false);
                };
                -> (IRValue*)0;
            };

            // emit_memcpy of ArrayTypeHandler: bitcast to i8* when needed, then llvm.memcpy
            emit_memcpy_bytes(IRValue* dst, IRValue* src, i64 bytes) -> void
            {
                -> this.emit_memcpy_val(dst, src, this.mod.c_int(this.t_i64, bytes));
            };

            // emit_memcpy_dynamic with an i64 byte count
            emit_memcpy_val(IRValue* dst, IRValue* src, IRValue* cnt) -> void
            {
                IRType** ps = (IRType**)fmalloc((u64)4 * (u64)((sizeof(IRType*) + 7) / 8));
                IRType* i8p = this.mod.t_ptr(this.t_i8);
                IRFunc* f;
                this.keep((void*)ps);
                ps[0] = i8p;
                ps[1] = i8p;
                ps[2] = this.t_i64;
                ps[3] = this.t_i1;
                f = this.intrinsic(g"llvm.memcpy.p0i8.p0i8.i64\0", this.mod.t_func(this.t_void, ps, 4, false));
                switch (dst.ty != i8p)
                {
                    case (true) { dst = this.mod.cast(g"bitcast\0", dst, i8p, (byte*)0); }
                    default {};
                };
                switch (src.ty != i8p)
                {
                    case (true) { src = this.mod.cast(g"bitcast\0", src, i8p, (byte*)0); }
                    default {};
                };
                this.mod.ia[0] = dst;
                this.mod.ia[1] = src;
                this.mod.ia[2] = cnt;
                this.mod.ia[3] = this.mod.c_null(this.t_i1);
                this.mod.call(f.self, this.mod.ia, 4, (byte*)0);
                ->;
            };

            arr_start(IRValue* p, byte* hint) -> IRValue*
            {
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(0);
                -> this.mod.gep(p, this.mod.ia, 2, false, hint);
            };

            // ArrayTypeHandler.concatenate (runtime path)
            array_concat(Node* n, IRValue* lhs, IRValue* rhs, int op) -> IRValue*
            {
                IRType* le = lhs.ty.elem.elem;
                IRType* re = rhs.ty.elem.elem;
                int ll = lhs.ty.elem.count;
                int rl = rhs.ty.elem.count;
                int nt = 0;
                int rlen;
                int lcopy;
                int eb;
                IRType* rt;
                IRValue* res;
                IRValue* dst;
                IRValue* src;
                switch (le.kind != re.kind | le.width != re.width)
                {
                    case (true) {
                    this.unsup(n, g"array concatenation element types\0");
                    -> (IRValue*)0;
                }
                    default
                    {
                        switch (op == Operator.ADD & le.kind == LK.INT & le.width == 8 & ll >= 1 & this.null_term)
                        {
                            case (true) { nt = 1; }
                            default {};
                        };
                        switch (nt == 1)
                        {
                            case (true) { rlen = (ll - 1) + rl; }
                            default {
                                switch (op == Operator.ADD)
                                {
                                    case (true) { rlen = ll + rl; }
                                    default {
                                        rlen = ll - rl;
                                        switch (rlen < 0) { case (true) { rlen = 0; } default {}; };
                                    };
                                };
                            };
                        };
                        switch (le.kind != LK.INT)
                        {
                            case (true) {
                            this.unsup(n, g"array concatenation element size\0");
                            -> (IRValue*)0;
                        }
                            default
                            {
                                eb = le.width / 8;
                                lcopy = ll;
                                switch (nt == 1) { case (true) { lcopy = ll - 1; } default {}; };
                                rt = this.mod.t_array(le, rlen);
                                res = this.mod.alloca_here(rt, g"array_concat_result\0");
                                switch (lcopy > 0)
                                {
                                    case (true) {
                                    dst = this.arr_start(res, g"result_start\0");
                                    src = this.arr_start(lhs, g"left_start\0");
                                    this.emit_memcpy_bytes(dst, src, (i64)(lcopy * eb));
                                }
                                    default {};
                                };
                                switch (op == Operator.ADD & rl > 0)
                                {
                                    case (true) {
                                    this.mod.ia[0] = this.ci32(0);
                                    this.mod.ia[1] = this.ci32(lcopy);
                                    dst = this.mod.gep(res, this.mod.ia, 2, false, g"result_right_start\0");
                                    src = this.arr_start(rhs, g"right_start\0");
                                    this.emit_memcpy_bytes(dst, src, (i64)(rl * eb));
                                }
                                    default {};
                                };
                                -> res;
                            };
                        };
                    };
                };
            };

            // Appends a decimal i64 to cb
            put_i64(Buf* cb, i64 v) -> void
            {
                byte* tmp = (byte*)fmalloc((u64)24);
                int n = 0;
                int j;
                u64 u;
                bool neg = v < (i64)0;
                switch (neg)
                {
                    case (true) { u = (u64)0 - (u64)v; }
                    default { u = (u64)v; };
                };
                switch (u == (u64)0)
                {
                    case (true) { tmp[0] = '0'; n = 1; }
                    default {};
                };
                while (u != (u64)0)
                {
                    tmp[n] = (byte)((int)(u % (u64)10) + 48);
                    u = u / (u64)10;
                    n++;
                };
                switch (neg) { case (true) { cb.put('-'); } default {}; };
                j = n - 1;
                while (j >= 0)
                {
                    cb.put((int)tmp[j]);
                    j--;
                };
                -> ffree(tmp);
            };

            // _fstring_eval_ct: 0 evaluated into ct_v/ct_k, 1 raises (runtime path), 2 not mirrored
            ctv(Node* e) -> int
            {
                int k = e.kind;
                int st;
                int op;
                i64 lv;
                i64 rv;
                int lk;
                int rk;
                bool b;
                int cm;
                i64 res;
                IRGlobal* gl;
                FXC_SYMENTRY* se;
                byte* sm;
                byte* sn;
                int sfx;
                switch (k == NodeKind.LITERAL)
                {
                    case (true) {
                    op = e.op;
                    switch (op == DataType.SINT | op == DataType.SLONG)
                    {
                        case (true) { this.ct_v = e.ival; this.ct_k = 0; -> 0; }
                        default {};
                    };
                    switch (op == DataType.ULONG)
                    {
                        case (true) {
                        switch (e.ival < (i64)0) { case (true) { -> 2; } default {}; };
                        this.ct_v = e.ival;
                        this.ct_k = 0;
                        -> 0;
                    }
                        default {};
                    };
                    switch (op == DataType.BOOL)
                    {
                        case (true) { this.ct_v = e.ival; this.ct_k = 1; -> 0; }
                        default {};
                    };
                    switch (op == DataType.CHAR)
                    {
                        case (true) { this.ct_v = e.ival; this.ct_k = 2; -> 0; }
                        default {};
                    };
                    switch (op == DataType.FLOAT | op == DataType.DOUBLE) { case (true) { -> 2; } default {}; };
                    -> 1;
                }
                    default
                    {
                        switch (k == NodeKind.BINARY_OP)
                        {
                            case (true) {
                            st = this.ctv(e.a);
                            switch (st != 0) { case (true) { -> st; } default {}; };
                            lv = this.ct_v;
                            lk = this.ct_k;
                            st = this.ctv(e.b);
                            switch (st != 0) { case (true) { -> st; } default {}; };
                            rv = this.ct_v;
                            rk = this.ct_k;
                            // Python evaluates every operator eagerly, so a zero divisor raises ZeroDivisionError
                            switch (rv == (i64)0 | lk != 0 | rk != 0) { case (true) { -> 2; } default {}; };
                            op = e.op;
                            this.ct_k = 0;
                            switch (op == Operator.ADD) { case (true) { this.ct_v = lv + rv; -> 0; } default {}; };
                            switch (op == Operator.SUB) { case (true) { this.ct_v = lv - rv; -> 0; } default {}; };
                            switch (op == Operator.MUL) { case (true) { this.ct_v = lv * rv; -> 0; } default {}; };
                            switch (op == Operator.DIV | op == Operator.MOD) { case (true) { -> 2; } default {}; };
                            this.ct_k = 1;
                            cm = 0;
                            switch (op == Operator.EQUAL) { case (true) { b = lv == rv; cm = 1; } default {}; };
                            switch (op == Operator.NOT_EQUAL) { case (true) { b = lv != rv; cm = 1; } default {}; };
                            switch (op == Operator.LESS_THAN) { case (true) { b = lv < rv; cm = 1; } default {}; };
                            switch (op == Operator.LESS_EQUAL) { case (true) { b = lv <= rv; cm = 1; } default {}; };
                            switch (op == Operator.GREATER_THAN) { case (true) { b = lv > rv; cm = 1; } default {}; };
                            switch (op == Operator.GREATER_EQUAL) { case (true) { b = lv >= rv; cm = 1; } default {}; };
                            switch (cm == 0) { case (true) { -> 1; } default {}; };
                            res = (i64)0;
                            switch (b) { case (true) { res = (i64)1; } default {}; };
                            this.ct_v = res;
                            -> 0;
                        }
                            default
                            {
                                switch (k == NodeKind.UNARY_OP)
                                {
                                    case (true) {
                                    st = this.ctv(e.a);
                                    switch (st != 0) { case (true) { -> st; } default {}; };
                                    op = e.op;
                                    switch (op == Operator.NOT)
                                    {
                                        case (true) {
                                        res = (i64)0;
                                        switch (this.ct_v == (i64)0) { case (true) { res = (i64)1; } default {}; };
                                        this.ct_v = res;
                                        this.ct_k = 1;
                                        -> 0;
                                    }
                                        default {};
                                    };
                                    switch (op == Operator.SUB & this.ct_k == 0)
                                    {
                                        case (true) { this.ct_v = (i64)0 - this.ct_v; -> 0; }
                                        default {};
                                    };
                                    -> 2;
                                }
                                    default
                                    {
                                        switch (k == NodeKind.IDENTIFIER)
                                        {
                                            case (true) {
                                            switch (this.find_local(e.text) != (LVar*)0) { case (true) { -> 1; } default {}; };
                                            // Bare name, then the be/le typed suffixes, then the symbol table entry
                                            gl = this.mod.find_global(e.text);
                                            sfx = 0;
                                            while (gl == (IRGlobal*)0 & sfx < 6)
                                            {
                                                switch (sfx == 0) { case (true) { sn = g"__be32\0"; } default {}; };
                                                switch (sfx == 1) { case (true) { sn = g"__le32\0"; } default {}; };
                                                switch (sfx == 2) { case (true) { sn = g"__be64\0"; } default {}; };
                                                switch (sfx == 3) { case (true) { sn = g"__le64\0"; } default {}; };
                                                switch (sfx == 4) { case (true) { sn = g"__be16\0"; } default {}; };
                                                switch (sfx == 5) { case (true) { sn = g"__le16\0"; } default {}; };
                                                sm = join3(e.text, sn, g"\0");
                                                gl = this.mod.find_global(sm);
                                                ffree(sm);
                                                sfx++;
                                            };
                                            switch (gl == (IRGlobal*)0)
                                            {
                                                case (true) {
                                                se = st_lookup_any(this.st, e.text, this.cur_ns);
                                                switch (se != (FXC_SYMENTRY*)0)
                                                {
                                                    case (true) {
                                                    switch (se.kind_id == SymbolKind.VARIABLE)
                                                    {
                                                        case (true) {
                                                        sm = sym_mangled(se);
                                                        gl = this.mod.find_global(sm);
                                                        ffree(sm);
                                                    }
                                                        default {};
                                                    };
                                                }
                                                    default {};
                                                };
                                            }
                                                default {};
                                            };
                                            // A global without an initializer, or one that is not marked constant, raises
                                            // into the runtime path. Only the constant initializer fold is not mirrored.
                                            switch (gl != (IRGlobal*)0)
                                            {
                                                case (true) { switch (gl.init != (byte*)0 & gl.constant) { case (true) { -> 2; } default {}; }; }
                                                default {};
                                            };
                                            -> 1;
                                        }
                                            default
                                            {
                                                // A sizeof of an expression is not a TypeSystem target, so the base raises into the runtime path
                                                switch (k == NodeKind.SIZE_OF) { case (true) { switch (e.ts == (TypeSpec*)0) { case (true) { -> 1; } default {}; }; -> 2; } default
                                                    {
                                                        switch (k == NodeKind.CAST_EXPRESSION) { case (true) { -> 2; } default
                                                            {
                                                                -> 1;
                                                            }; };
                                                    }; };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };

            // _array_literal_string on a local: str_stack bytes and an inbounds str_ptr
            fstr_lit(byte* text, int len) -> IRValue*
            {
                int total = len;
                int i;
                IRType* aty;
                IRValue* arr;
                IRValue* gp;
                switch (this.null_term & (len == 0 | text[len - 1] != (byte)0)) { case (true) { total = len + 1; } default {}; };
                aty = this.mod.t_array(this.t_i8, total);
                arr = this.mod.alloca_here(aty, g"str_stack\0");
                while (i < total)
                {
                    this.mod.ia[0] = this.ci32(0);
                    this.mod.ia[1] = this.ci32(i);
                    this.sc.clear();
                    this.sc.put_str(f"str_char_{i}\0");
                    gp = this.mod.gep(arr, this.mod.ia, 2, false, this.sc.mem);
                    switch (i < len)
                    {
                        case (true) { this.mod.store(this.mod.c_int(this.t_i8, (i64)((int)text[i])), gp); }
                        default { this.mod.store(this.mod.c_int(this.t_i8, (i64)0), gp); };
                    };
                    i++;
                };
                this.mod.ia[0] = this.ci32(0);
                this.mod.ia[1] = this.ci32(0);
                -> this.mod.gep(arr, this.mod.ia, 2, true, g"str_ptr\0");
            };

            fa_decl(byte* name, IRType* vt) -> IRFunc*
            {
                IRType** ps = (IRType**)fmalloc((u64)3 * (u64)((sizeof(IRType*) + 7) / 8));
                this.keep((void*)ps);
                ps[0] = vt;
                ps[1] = this.t_i8p;
                ps[2] = this.mod.t_ptr(this.t_i32);
                -> this.intrinsic(name, this.mod.t_func(this.t_i32, ps, 3, false));
            };

            // Length of an f-string text part (embedded NUL bytes count)
            fs_len(Node* p) -> int
            {
                int l = (int)p.ival;
                switch (l <= 0)
                {
                    case (true) {
                    l = 0;
                    while (p.text[l] != (byte)0) { l++; };
                }
                    default {};
                };
