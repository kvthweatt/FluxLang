            // visit_FStringLiteral
            x_fstring(Node* n) -> IRValue*
            {
                int c = node_count(n, 0);
                int i;
                int st;
                int rt = 0;
                int size = 256;
                Node* p;
                Buf* cb;
                byte* txt;
                int tl;
                IRValue* val;
                IRValue* pos;
                IRValue* dest;
                IRValue* sp;
                IRValue* buffer;
                IRValue* pos_ptr;
