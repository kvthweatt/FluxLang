<NotepadPlus>
    <UserLang name="Flux" ext="fx" udlVersion="2.1">
        <Settings>
            <Global caseIgnored="no" allowFoldOfComments="yes" foldCompact="no" forcePureLC="0" decimalSeparator="0" />
            <Prefix Keywords1="no" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" Keywords7="no" Keywords8="no" />
        </Settings>
        <KeywordLists>
            <Keywords name="Comments">00// 01 02 03/// 04///</Keywords>
            <Keywords name="Numbers, prefix1">0d 0x 0o 0b</Keywords>
            <Keywords name="Numbers, prefix2"></Keywords>
            <Keywords name="Numbers, extras1"></Keywords>
            <Keywords name="Numbers, extras2"></Keywords>
            <Keywords name="Numbers, suffix1">l u ul b c f d</Keywords>
            <Keywords name="Numbers, suffix2"></Keywords>
            <Keywords name="Numbers, range">ABCDEFGHIJKLMNOPQRSTUV</Keywords>
            <Keywords name="Operators1">+ - * / % ^ &amp; | ~ ! &lt; &gt; = ? : @ . , ; ( ) [ ] { } $ ` \</Keywords>
            <Keywords name="Operators2">++ -- &lt;&lt; &gt;&gt; ^^ ^^= == != &lt;= &gt;= += -= *= /= %= ^= &amp;= |= &lt;&lt;= &gt;&gt;= !! ?? !? -&gt; &lt;- &lt;~ &lt;-&gt; :: .. ... ** (@) {}* ?= @= ~$ !&amp; !| `! `&amp; `| `!&amp; `!| `^^ `^^! `^^`&amp; `^^!| `&amp;= `|= `!&amp;= `!|= `^^= `^^!= `^^!&amp;= `^^!|=</Keywords>
            <Keywords name="Folders in code1, open">{</Keywords>
            <Keywords name="Folders in code1, middle"></Keywords>
            <Keywords name="Folders in code1, close">}</Keywords>
            <Keywords name="Folders in code2, open"></Keywords>
            <Keywords name="Folders in code2, middle"></Keywords>
            <Keywords name="Folders in code2, close"></Keywords>
            <Keywords name="Folders in comment, open"></Keywords>
            <Keywords name="Folders in comment, middle"></Keywords>
            <Keywords name="Folders in comment, close"></Keywords>
            <Keywords name="Keywords1">and as assert auto break case catch continue default defer do elif else for from goto if in is jump label not or return switch throw try while xor has</Keywords>
            <Keywords name="Keywords2">#import #def #psub #dir #package #ifdef #ifndef #ifpsub #ifnpsub #elif #else #endif #warn #stop</Keywords>
            <Keywords name="Keywords3">def extern namespace module enum struct object union dict trait contract constraint interface operator export inline macro using cdecl stdcall fastcall thiscall vectorcall</Keywords>
            <Keywords name="Keywords4">async escape noinit singinit const volatile signed unsigned heap stack register local global private public effect attenuate binding comptime compt fluxvm emitflux</Keywords>
            <Keywords name="Keywords5">typeof sizeof alignof endianof deprecate asm</Keywords>
            <Keywords name="Keywords6">bool byte char int uint long ulong float double void data vector</Keywords>
            <Keywords name="Keywords7">true false this super</Keywords>
            <Keywords name="Keywords8">__init __exit __expr noreturn fastnode</Keywords>
            <Keywords name="Delimiters">00&quot; 01\ 02&quot; 03f&quot; 04\ 05&quot; 06i&quot; 07\ 08&quot; 09g&quot; 10\ 11&quot; 12' 13\ 14' 15using 16 17; 18 19 20 21 22 23</Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="FFFFFF" bgColor="323232" fontName="Lucida Console" fontStyle="0" fontSize="11" nesting="0" />
            <WordsStyle name="COMMENTS" fgColor="00C462" bgColor="323232" fontStyle="1" nesting="0" />
            <WordsStyle name="LINE COMMENTS" fgColor="008000" bgColor="323232" fontStyle="1" nesting="0" />
            <WordsStyle name="NUMBERS" fgColor="FFC640" bgColor="323232" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS1" fgColor="E16B00" bgColor="323232" fontName="Lucida Console" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS2" fgColor="9F009F" bgColor="323232" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS3" fgColor="F9A800" bgColor="323232" fontName="Lucida Console" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS4" fgColor="D7006B" bgColor="323232" fontName="Lucida Console" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS5" fgColor="00ACBF" bgColor="323232" fontName="Lucida Console" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS6" fgColor="2D8BFF" bgColor="323232" fontName="Lucida Console" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS7" fgColor="FFFF00" bgColor="323232" fontName="Lucida Console" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS8" fgColor="FF0000" bgColor="323232" fontName="Lucida Console" fontStyle="1" fontSize="10" nesting="0" />
            <WordsStyle name="OPERATORS" fgColor="FF0000" bgColor="323232" fontStyle="1" nesting="0" />
            <WordsStyle name="FOLDER IN CODE1" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="FOLDER IN CODE2" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="FOLDER IN COMMENT" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS1" fgColor="0080FF" bgColor="323232" fontName="Lucida Console" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS2" fgColor="00BFFF" bgColor="323232" fontName="Lucida Console" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS3" fgColor="00BFFF" bgColor="323232" fontName="Lucida Console" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS4" fgColor="0080FF" bgColor="323232" fontName="Lucida Console" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS5" fgColor="8080FF" bgColor="323232" fontStyle="1" nesting="0" />
            <WordsStyle name="DELIMITERS6" fgColor="00A6A6" bgColor="323232" fontName="Lucida Console" fontStyle="1" nesting="0" />
            <WordsStyle name="DELIMITERS7" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS8" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
        </Styles>
    </UserLang>
</NotepadPlus>